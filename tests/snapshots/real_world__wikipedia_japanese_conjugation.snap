<th rowspan="2" id="mwAow"><span title="Hepburn transliteration" about="#mwt261" typeof="mw:Transclusion" id="mwAo0" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;[[:ja:音便形|音便形]]&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Onbinkei&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Onbinkei</i></span><span style="font-weight: normal" about="#mwt261" id="mwAo4"> (<span title="Japanese-language text"><span lang="ja"><a rel="mw:WikiLink/Interwiki" href="https://ja.wikipedia.org/wiki/音便形" title="ja:音便形" class="extiw">音便形</a></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></th>
<td rowspan="2" id="mwAo8"></td>
<th colspan="2" style="text-align:left;font-weight:normal" id="mwApA"><small id="mwApE">Remove the <span title="Japanese-language text" about="#mwt262" typeof="mw:Transclusion" id="mwApI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;〜〇&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">〜〇</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt262" id="mwApM"> kana, add <span style="color:#0a0" id="mwApQ"><span title="Japanese-language text" about="#mwt263" typeof="mw:Transclusion" id="mwApU" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;っ&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">っ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt263" id="mwApY"></span>, <span style="color:#0a0" id="mwApc"><span title="Japanese-language text" about="#mwt264" typeof="mw:Transclusion" id="mwApg" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;し&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">し</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt264" id="mwApk"></span>, <span style="color:#0a0" id="mwApo"><span title="Japanese-language text" about="#mwt265" typeof="mw:Transclusion" id="mwAps" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;い&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">い</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt265" id="mwApw"></span> or <span style="color:#0a0" id="mwAp0"><span title="Japanese-language text" about="#mwt266" typeof="mw:Transclusion" id="mwAp4" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;ん&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">ん</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt266" id="mwAp8"></span></small></th>
<th rowspan="2" id="mwAqA"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_conjugation_(ren'yōkei_base)#Gerund" title="Japanese conjugation (ren'yōkei base)" id="mwAqE">Gerund</a><br id="mwAqI"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_conjugation_(ren'yōkei_base)#Perfective" title="Japanese conjugation (ren'yōkei base)" id="mwAqM">Perfective form</a></th></tr>
<tr id="mwAqQ">
<td id="mwAqU"><span style="font-weight: normal" about="#mwt267" typeof="mw:Transclusion" id="mwAqY" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo_krt&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;言っ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;it/yut&quot;}},&quot;i&quot;:0}}]}"><span title="Japanese-language text"><span lang="ja">言っ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text"> (<span title="Hepburn transliteration"><i lang="ja-Latn">it/yut</i></span><span style="margin-left:.09em">)</span></span></td>
<td id="mwAqc"><span style="font-weight: normal" about="#mwt268" typeof="mw:Transclusion" id="mwAqg" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo_krt&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;狩っ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;kat&quot;}},&quot;i&quot;:0}}]}"><span title="Japanese-language text"><span lang="ja">狩っ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text"> (<span title="Hepburn transliteration"><i lang="ja-Latn">kat</i></span><span style="margin-left:.09em">)</span></span></td></tr>
</tbody></table>

<p id="mwAqk">Of the nine verb bases, the <a rel="mw:WikiLink" href="#Imperfective" class="mw-selflink-fragment" id="mwAqo">shūshikei/rentaikei</a>, <a rel="mw:WikiLink" href="#Imperative" class="mw-selflink-fragment" id="mwAqs">meireikei</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_conjugation_(ren'yōkei_base)#Infinitive" title="Japanese conjugation (ren'yōkei base)" id="mwAqw">ren'yōkei</a> bases can be considered fully conjugated forms without needing to append inflectional suffixes. In particular, the shūshikei/rentaikei and meireikei bases do not conjugate with any inflectional suffixes. By contrast, a verb cannot be considered fully conjugated in its kateikei, mizenkei, ishikei, kanōkei, or onbinkei base alone; a compatible inflectional suffix is required for that verb construction to be grammatical.<sup about="#mwt269" class="mw-ref reference" id="cite_ref-FOOTNOTEMcClain198139–86&quot;Verb-Following_Expressions&quot;_27-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMcClain198139–86\&quot;Verb-Following Expressions\&quot;&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMcClain198139–86\&quot;Verb-Following_Expressions\&quot;-27&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;McClain&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;1981&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;39–86&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;Verb-Following Expressions\&quot;&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMcClain198139–86&quot;Verb-Following_Expressions&quot;-27" id="mwAq0"><span class="mw-reflink-text" id="mwAq4"><span class="cite-bracket" id="mwAq8">[</span>26<span class="cite-bracket" id="mwArA">]</span></span></a></sup></p>

<p id="mwArE">Certain inflectional suffixes, in themselves, take on the form of verbs or <i id="mwArI">i</i>‑adjectives. These suffixes can then be further conjugated by adopting one of the verb bases, followed by the attachment of the appropriate suffix. The agglutinative nature of Japanese verb conjugation can thus make the final form of a given verb conjugation quite long. For example, the word <span title="Hepburn transliteration" about="#mwt272" typeof="mw:Transclusion" id="mwArM" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;食べさせられたくなかった&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;tabesaseraretakunakatta&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">tabesaseraretakunakatta</i></span><span style="font-weight: normal" about="#mwt272" id="mwArQ"> (<span title="Japanese-language text"><span lang="ja">食べさせられたくなかった</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span> is broken down into its component <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Morpheme" title="Morpheme" id="mwArU">morphemes</a> below:</p>

<table class="wikitable" style="text-align:center" id="mwArY">
<tbody id="mwArc"><tr id="mwArg"><th colspan="8" id="mwArk"><big id="mwAro"><span style="font-weight: normal" about="#mwt273" typeof="mw:Transclusion" id="mwArs" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo_krt&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;'''\&quot;did not want to be made to eat\&quot;'''&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''食べさせられたくなかった'''&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;'''tabesaseraretakunakatta'''&quot;}},&quot;i&quot;:0}}]}"><span title="Japanese-language text"><span lang="ja"><b>食べさせられたくなかった</b></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text"> (<span title="Hepburn transliteration"><i lang="ja-Latn"><b>tabesaseraretakunakatta</b></i></span>, <b>"did not want to be made to eat"</b>)</span></big></th></tr>
<tr id="mwArw">
<td style="width:12.5%" id="mwAr0"><span title="Hepburn transliteration" about="#mwt274" typeof="mw:Transclusion" id="mwAr4" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''食べ'''&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;'''tabe'''&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn"><b>tabe</b></i></span><span style="font-weight: normal" about="#mwt274" id="mwAr8"> (<span title="Japanese-language text"><span lang="ja"><b>食べ</b></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td>
<td style="width:12.5%" id="mwAsA"><span title="Hepburn transliteration" about="#mwt275" typeof="mw:Transclusion" id="mwAsE" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''させ'''&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;'''sase'''&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn"><b>sase</b></i></span><span style="font-weight: normal" about="#mwt275" id="mwAsI"> (<span title="Japanese-language text"><span lang="ja"><b>させ</b></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td>
<td style="width:12.5%" id="mwAsM"><span title="Hepburn transliteration" about="#mwt276" typeof="mw:Transclusion" id="mwAsQ" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''られ'''&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;'''rare'''&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn"><b>rare</b></i></span><span style="font-weight: normal" about="#mwt276" id="mwAsU"> (<span title="Japanese-language text"><span lang="ja"><b>られ</b></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td>
<td style="width:12.5%" id="mwAsY"><span title="Hepburn transliteration" about="#mwt277" typeof="mw:Transclusion" id="mwAsc" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''たく'''&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;'''taku'''&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn"><b>taku</b></i></span><span style="font-weight: normal" about="#mwt277" id="mwAsg"> (<span title="Japanese-language text"><span lang="ja"><b>たく</b></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td>
<td style="width:12.5%" id="mwAsk"><span title="Hepburn transliteration" about="#mwt278" typeof="mw:Transclusion" id="mwAso" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''なかっ'''&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;'''naka'-'''&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn"><b>naka'-</b></i></span><span style="font-weight: normal" about="#mwt278" id="mwAss"> (<span title="Japanese-language text"><span lang="ja"><b>なかっ</b></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td>
<td style="width:12.5%" id="mwAsw"><span title="Hepburn transliteration" about="#mwt279" typeof="mw:Transclusion" id="mwAs0" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''た'''&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;'''ta'''&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn"><b>ta</b></i></span><span style="font-weight: normal" about="#mwt279" id="mwAs4"> (<span title="Japanese-language text"><span lang="ja"><b>た</b></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwAs8">
<td id="mwAtA">Mizenkei base of<br id="mwAtE"><span title="Hepburn transliteration" about="#mwt280" typeof="mw:Transclusion" id="mwAtI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;食べる&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;taberu&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">taberu</i></span><span style="font-weight: normal" about="#mwt280" id="mwAtM"> (<span title="Japanese-language text"><span lang="ja">食べる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td>
<td id="mwAtQ">Mizenkei base of the<br id="mwAtU"><span title="Hepburn transliteration" about="#mwt281" typeof="mw:Transclusion" id="mwAtY" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;させる&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;saseru&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">saseru</i></span><span style="font-weight: normal" about="#mwt281" id="mwAtc"> (<span title="Japanese-language text"><span lang="ja">させる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span> causative suffix</td>
<td id="mwAtg">Ren'yōkei base of the<br id="mwAtk"><span title="Hepburn transliteration" about="#mwt282" typeof="mw:Transclusion" id="mwAto" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;られる&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;rareru&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">rareru</i></span><span style="font-weight: normal" about="#mwt282" id="mwAts"> (<span title="Japanese-language text"><span lang="ja">られる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span> passive suffix</td>
<td id="mwAtw">Ren'yōkei base of the<br id="mwAt0"><span title="Hepburn transliteration" about="#mwt283" typeof="mw:Transclusion" id="mwAt4" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;たい&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;tai&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">tai</i></span><span style="font-weight: normal" about="#mwt283" id="mwAt8"> (<span title="Japanese-language text"><span lang="ja">たい</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span> desiderative suffix</td>
<td id="mwAuA">Past‑tense ren'yōkei base of the<br id="mwAuE"><span title="Hepburn transliteration" about="#mwt284" typeof="mw:Transclusion" id="mwAuI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;ない&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;nai&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">nai</i></span><span style="font-weight: normal" about="#mwt284" id="mwAuM"> (<span title="Japanese-language text"><span lang="ja">ない</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span> negation suffix</td>
<td id="mwAuQ">Inflectional suffix<br id="mwAuU"><span title="Hepburn transliteration" about="#mwt285" typeof="mw:Transclusion" id="mwAuY" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;た&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;ta&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">ta</i></span><span style="font-weight: normal" about="#mwt285" id="mwAuc"> (<span title="Japanese-language text"><span lang="ja">た</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span>, marking past tense</td></tr>
<tr id="mwAug">
<td id="mwAuk">"to eat" (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Word_stem" title="Word stem" id="mwAuo">Verb stem</a>)</td>
<td id="mwAus"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Causative" title="Causative" id="mwAuw">Causative</a> voice: "to make someone do"</td>
<td id="mwAu0"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Passive_voice" title="Passive voice" id="mwAu4">Passive voice</a>: "to be done"</td>
<td id="mwAu8"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Desiderative_mood#Japanese" title="Desiderative mood" id="mwAvA">Desiderative mood</a>: "wanting to do something"</td>
<td id="mwAvE"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Affirmation_and_negation" title="Affirmation and negation" id="mwAvI">Negation</a>: "not", negates whatever came before</td>
<td id="mwAvM"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Perfective_aspect" title="Perfective aspect" id="mwAvQ">Perfective aspect</a>: indicates completion or past tense</td></tr>
</tbody></table>

<section data-mw-section-id="3" id="mwAvU" aria-labelledby="Derivative_verb_bases"><div class="mw-heading mw-heading3"><h3 id="Derivative_verb_bases">Derivative verb bases</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Japanese_conjugation&amp;action=edit&amp;section=3" title="Edit section: Derivative verb bases"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwAvY">There are three modern verb base forms that are considered to be derived from older forms.  These are the <b id="mwAvc">potential</b>, <b id="mwAvg">hortative</b>, and <b id="mwAvk">euphonic</b> sub‑bases, as shown in the <a rel="mw:WikiLink" href="#Verb_bases" class="mw-selflink-fragment" id="mwAvo">Verb base formation table</a> above.</p>

<p id="mwAvs">As with all languages, the Japanese language has evolved to fulfil the contemporary needs of communication. The potential form of verbs is one such example. In <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Old_Japanese" title="Old Japanese" id="mwAvw">Old Japanese</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Early_Middle_Japanese" title="Early Middle Japanese" id="mwAv0">Early Middle Japanese</a>, potential was expressed with the verb ending <span title="Hepburn transliteration" about="#mwt286" typeof="mw:Transclusion" id="mwAv4" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;[[:wikt:ゆ#Old Japanese|ゆ]]&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yu&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">yu</i></span><span style="font-weight: normal" about="#mwt286" id="mwAv8"> (<span title="Japanese-language text"><span lang="ja"><a rel="mw:WikiLink/Interwiki" href="https://en.wiktionary.org/wiki/ゆ#Old_Japanese" title="wikt:ゆ" class="extiw">ゆ</a></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span>, which was also used to express the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Passive_voice" title="Passive voice" id="mwAwA">passive voice</a> ("to be done") and the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Early_Middle_Japanese#Verb-like_endings" title="Early Middle Japanese" id="mwAwE">spontaneous voice</a> ("something happens on its own").  This evolved into the modern passive ending <span title="Hepburn transliteration" about="#mwt287" typeof="mw:Transclusion" id="mwAwI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;（ら）れる&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;-(ra)reru&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">-(ra)reru</i></span><span style="font-weight: normal" about="#mwt287" id="mwAwM"> (<span title="Japanese-language text"><span lang="ja">（ら）れる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span>, which can similarly express potential and spontaneous senses.  As usage patterns changed over time, different kinds of potential constructions emerged, such as the grammatical pattern of the rentaikei base + <span title="Hepburn transliteration" about="#mwt288" typeof="mw:Transclusion" id="mwAwQ" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo3&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;〜ことができる&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;-koto ga dekiru&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">-koto ga dekiru</i></span><span style="font-weight: normal" about="#mwt288" id="mwAwU"> (<span title="Japanese-language text"><span lang="ja">〜ことができる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span>, and also via the kanōkei base.<sup about="#mwt289" class="mw-ref reference" id="cite_ref-FOOTNOTENakano2008103–105&quot;2.可能表現の形態とその内容の変遷ー動作主体性の発達&quot;_(Potential)_4-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTENakano2008103–105\&quot;2.可能表現の形態とその内容の変遷ー動作主体性の発達\&quot; (Potential)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTENakano2008103–105\&quot;2.可能表現の形態とその内容の変遷ー動作主体性の発達\&quot;_(Potential)-4&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Nakano&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2008&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;103–105&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;2.可能表現の形態とその内容の変遷ー動作主体性の発達\&quot; (Potential)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTENakano2008103–105&quot;2.可能表現の形態とその内容の変遷ー動作主体性の発達&quot;_(Potential)-4" id="mwAwY"><span class="mw-reflink-text" id="mwAwc"><span class="cite-bracket" id="mwAwg">[</span>4<span class="cite-bracket" id="mwAwk">]</span></span></a></sup> The historical development of the kanōkei base is disputed, however the consensus is that it stemmed from a shift wherein transitive verbs developed an intransitive sense similar to the spontaneous, passive, and potential, and these intransitive forms conjugated in the <span style="font-weight: normal" about="#mwt292" typeof="mw:Transclusion" id="mwAwo" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo_krt&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;[[Early Middle Japanese#Conjugation|lower bigrade conjugation pattern]]&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;下二段活用&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;shimo nidan katsuyō&quot;}},&quot;i&quot;:0}}]}"><span title="Japanese-language text"><span lang="ja">下二段活用</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text"> (<span title="Hepburn transliteration"><i lang="ja-Latn">shimo nidan katsuyō</i></span>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Early_Middle_Japanese#Conjugation" title="Early Middle Japanese">lower bigrade conjugation pattern</a>)</span> of the Classical Japanese of the time.<sup about="#mwt293" class="mw-ref reference" id="cite_ref-FOOTNOTEMiyake2016&quot;可能形&quot;_(Potential)_5-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMiyake2016\&quot;可能形\&quot; (Potential)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMiyake2016\&quot;可能形\&quot;_(Potential)-5&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Miyake&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2016&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;可能形\&quot; (Potential)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMiyake2016&quot;可能形&quot;_(Potential)-5" id="mwAws"><span class="mw-reflink-text" id="mwAww"><span class="cite-bracket" id="mwAw0">[</span>5<span class="cite-bracket" id="mwAw4">]</span></span></a></sup>  The lower bigrade conjugation pattern evolved into the modern ichidan pattern in modern Japanese, and these stems for godan verbs have the same form as the <b id="mwAw8">hypothetical</b> stems in the table above.</p>

<p id="mwAxA">The mizenkei base that ends with <span title="Japanese-language romanization" about="#mwt296" typeof="mw:Transclusion" id="mwAxE" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Transliteration&quot;,&quot;href&quot;:&quot;./Template:Transliteration&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;-a&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">-a</i></span> was also used to express the hortative mood for <span about="#mwt297" typeof="mw:Transclusion" id="mwAxI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;yodan verbs&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;四段動詞&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yodan-dōshi&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;\&quot;Class‑4 verbs\&quot;&quot;}},&quot;i&quot;:0}}]}">yodan verbs</span><span style="font-weight: normal" about="#mwt297" id="mwAxM"> (<span title="Japanese-language text"><span lang="ja">四段動詞</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">, <span title="Hepburn transliteration"><i lang="ja-Latn">yodan-dōshi</i></span>; "Class‑4 verbs")</span> in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Old_Japanese" title="Old Japanese" id="mwAxQ">Old Japanese</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Middle_Japanese_(disambiguation)" title="Middle Japanese (disambiguation)" class="mw-redirect mw-disambig" id="mwAxU">Middle Japanese</a>,<link rel="mw:PageProp/Category" href="./Category:All_articles_with_links_needing_disambiguation" about="#mwt298" typeof="mw:Transclusion" id="mwAxY" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;dn&quot;,&quot;href&quot;:&quot;./Template:Dn&quot;},&quot;params&quot;:{&quot;date&quot;:{&quot;wt&quot;:&quot;October 2025&quot;}},&quot;i&quot;:0}}]}"><link rel="mw:PageProp/Category" href="./Category:Articles_with_links_needing_disambiguation_from_October_2025" about="#mwt298"><sup class="noprint Inline-Template " style="white-space:nowrap;" about="#mwt298" id="mwAxc"><span typeof="mw:Entity">[</span><i><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wikipedia:WikiProject_Disambiguation/Fixing_links" title="Wikipedia:WikiProject Disambiguation/Fixing links"><span title="Link needs disambiguation (October 2025)">disambiguation needed</span></a></i><span typeof="mw:Entity">]</span></sup> in combination with hortative suffix <span title="Hepburn transliteration" about="#mwt299" typeof="mw:Transclusion" id="mwAxg" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;む&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;-mu&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">-mu</i></span><span style="font-weight: normal" about="#mwt299" id="mwAxk"> (<span title="Japanese-language text"><span lang="ja">む</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span>.  Sound changes caused the resulting <i id="mwAxo">‑amu</i> ending to change: <span class="IPA nowrap" lang="und-Latn-fonipa" title="Representation in the International Phonetic Alphabet (IPA)" about="#mwt300" typeof="mw:Transclusion" id="mwAxs" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;IPA&quot;,&quot;href&quot;:&quot;./Template:IPA&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;/‑amu/&quot;}},&quot;i&quot;:0}}]}">/‑amu/</span><link rel="mw:PageProp/Category" href="./Category:Pages_with_plain_IPA" about="#mwt300" id="mwAxw"> → <span class="IPA nowrap" lang="und-Latn-fonipa" title="Representation in the International Phonetic Alphabet (IPA)" about="#mwt301" typeof="mw:Transclusion" id="mwAx0" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;IPA&quot;,&quot;href&quot;:&quot;./Template:IPA&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;/‑ãu/&quot;}},&quot;i&quot;:0}}]}">/‑ãu/</span><link rel="mw:PageProp/Category" href="./Category:Pages_with_plain_IPA" about="#mwt301" id="mwAx4"> → <span class="IPA nowrap" lang="und-Latn-fonipa" title="Representation in the International Phonetic Alphabet (IPA)" about="#mwt302" typeof="mw:Transclusion" id="mwAx8" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;IPA&quot;,&quot;href&quot;:&quot;./Template:IPA&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;/‑au/&quot;}},&quot;i&quot;:0}}]}">/‑au/</span><link rel="mw:PageProp/Category" href="./Category:Pages_with_plain_IPA" about="#mwt302" id="mwAyA"> (like English <i id="mwAyE">"ow"</i>) → <span class="IPA nowrap" lang="und-Latn-fonipa" title="Representation in the International Phonetic Alphabet (IPA)" about="#mwt303" typeof="mw:Transclusion" id="mwAyI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;IPA&quot;,&quot;href&quot;:&quot;./Template:IPA&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;/‑ɔː/&quot;}},&quot;i&quot;:0}}]}">/‑ɔː/</span><link rel="mw:PageProp/Category" href="./Category:Pages_with_plain_IPA" about="#mwt303" id="mwAyM"> (like English <i id="mwAyQ">"aw"</i>) → <span class="IPA nowrap" lang="und-Latn-fonipa" title="Representation in the International Phonetic Alphabet (IPA)" about="#mwt304" typeof="mw:Transclusion" id="mwAyU" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;IPA&quot;,&quot;href&quot;:&quot;./Template:IPA&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;/‑oː/&quot;}},&quot;i&quot;:0}}]}">/‑oː/</span><link rel="mw:PageProp/Category" href="./Category:Pages_with_plain_IPA" about="#mwt304" id="mwAyY">. The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_script_reform#Reforms" title="Japanese script reform" id="mwAyc">post‑WWII spelling reforms</a> updated spellings to reflect this and other sound changes, resulting in the addition of the ishikei or <b id="mwAyg">hortative</b> base, ending with <span title="Japanese-language romanization" about="#mwt305" typeof="mw:Transclusion" id="mwAyk" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Transliteration&quot;,&quot;href&quot;:&quot;./Template:Transliteration&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;-o&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">-o</i></span>, for the hortative mood of yodan verbs. This also resulted in a reclassification of "yodan verbs" to <span about="#mwt306" typeof="mw:Transclusion" id="mwAyo" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;\&quot;godan verbs\&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;五段動詞&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;godan-dōshi&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;\&quot;Class‑5 verbs\&quot;&quot;}},&quot;i&quot;:0}}]}">"godan verbs"</span><span style="font-weight: normal" about="#mwt306" id="mwAys"> (<span title="Japanese-language text"><span lang="ja">五段動詞</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">, <span title="Hepburn transliteration"><i lang="ja-Latn">godan-dōshi</i></span>; "Class‑5 verbs")</span>.<sup about="#mwt307" class="mw-ref reference" id="cite_ref-FOOTNOTEKoyanagi2014&quot;意志形&quot;_(Volitional)_8-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEKoyanagi2014\&quot;意志形\&quot; (Volitional)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEKoyanagi2014\&quot;意志形\&quot;_(Volitional)-8&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Koyanagi&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2014&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;意志形\&quot; (Volitional)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEKoyanagi2014&quot;意志形&quot;_(Volitional)-8" id="mwAyw"><span class="mw-reflink-text" id="mwAy0"><span class="cite-bracket" id="mwAy4">[</span>8<span class="cite-bracket" id="mwAy8">]</span></span></a></sup><sup about="#mwt310" class="mw-ref reference" id="cite_ref-FOOTNOTEMcClain19816&quot;Verbs:_6._Sixth_Base&quot;_(推量形_Tentative_Base)_28-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMcClain19816\&quot;Verbs: 6. Sixth Base\&quot; (推量形 Tentative Base)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMcClain19816\&quot;Verbs:_6._Sixth_Base\&quot;_(推量形_Tentative_Base)-28&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;McClain&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;1981&quot;},&quot;p&quot;:{&quot;wt&quot;:&quot;6&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;Verbs: 6. Sixth Base\&quot; (推量形 Tentative Base)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMcClain19816&quot;Verbs:_6._Sixth_Base&quot;_(推量形_Tentative_Base)-28" id="mwAzA"><span class="mw-reflink-text" id="mwAzE"><span class="cite-bracket" id="mwAzI">[</span>27<span class="cite-bracket" id="mwAzM">]</span></span></a></sup></p>

<p id="mwAzQ">The ren'yōkei base also underwent various <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_grammar#Euphonic_changes_(音便,_onbin)" title="Japanese grammar" id="mwAzU">euphonic changes</a> specific to the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_conjugation_(ren'yōkei_base)#Perfective" title="Japanese conjugation (ren'yōkei base)" id="mwAzY">perfective</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_conjugation_(ren'yōkei_base)#Gerund" title="Japanese conjugation (ren'yōkei base)" id="mwAzc">infinitive (<i id="mwAzg">te</i>)</a> forms for certain verb stems,<sup about="#mwt313" class="mw-ref reference" id="cite_ref-FOOTNOTEMcClain198117-18&quot;Verbs:_How_to_form_''Ta''-_and_''Te''-form_of_Verbs:_II._Consonant_stem_verbs&quot;_29-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMcClain198117-18\&quot;Verbs: How to form ''Ta''- and ''Te''-form of Verbs: II. Consonant stem verbs\&quot;&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMcClain198117-18\&quot;Verbs:_How_to_form_''Ta''-_and_''Te''-form_of_Verbs:_II._Consonant_stem_verbs\&quot;-29&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;McClain&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;1981&quot;},&quot;p&quot;:{&quot;wt&quot;:&quot;17-18&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;Verbs: How to form ''Ta''- and ''Te''-form of Verbs: II. Consonant stem verbs\&quot;&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMcClain198117-18&quot;Verbs:_How_to_form_''Ta''-_and_''Te''-form_of_Verbs:_II._Consonant_stem_verbs&quot;-29" id="mwAzk"><span class="mw-reflink-text" id="mwAzo"><span class="cite-bracket" id="mwAzs">[</span>28<span class="cite-bracket" id="mwAzw">]</span></span></a></sup><sup about="#mwt316" class="mw-ref reference" id="cite_ref-FOOTNOTENakamura2009&quot;音便形&quot;_(Euphonic_Change)_6-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTENakamura2009\&quot;音便形\&quot; (Euphonic Change)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTENakamura2009\&quot;音便形\&quot;_(Euphonic_Change)-6&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Nakamura&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2009&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;音便形\&quot; (Euphonic Change)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTENakamura2009&quot;音便形&quot;_(Euphonic_Change)-6" id="mwAz0"><span class="mw-reflink-text" id="mwAz4"><span class="cite-bracket" id="mwAz8">[</span>6<span class="cite-bracket" id="mwA0A">]</span></span></a></sup><sup about="#mwt319" class="mw-ref reference" id="cite_ref-FOOTNOTESakaki2019&quot;音便形&quot;_(Euphonic_Change)_7-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTESakaki2019\&quot;音便形\&quot; (Euphonic Change)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTESakaki2019\&quot;音便形\&quot;_(Euphonic_Change)-7&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Sakaki&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2019&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;音便形\&quot; (Euphonic Change)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTESakaki2019&quot;音便形&quot;_(Euphonic_Change)-7" id="mwA0E"><span class="mw-reflink-text" id="mwA0I"><span class="cite-bracket" id="mwA0M">[</span>7<span class="cite-bracket" id="mwA0Q">]</span></span></a></sup> giving rise to the onbinkei or <b id="mwA0U">euphonic</b> base.<sup about="#mwt322" class="mw-ref reference" id="cite_ref-FOOTNOTEDigital_Daijisen_Dictionary:_Onbinkei_30-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEDigital Daijisen Dictionary: Onbinkei&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEDigital_Daijisen_Dictionary:_Onbinkei-30&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Digital Daijisen Dictionary: Onbinkei&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEDigital_Daijisen_Dictionary:_Onbinkei-30" id="mwA0Y"><span class="mw-reflink-text" id="mwA0c"><span class="cite-bracket" id="mwA0g">[</span>29<span class="cite-bracket" id="mwA0k">]</span></span></a></sup> In the onbinkei base, the inflectional suffixes for godan verbs vary according to the last kana of the verb's ren'yōkei base.<sup about="#mwt325" class="mw-ref reference" id="cite_ref-FOOTNOTEMakinoTsutsui2018576–579&quot;Appendix_1_Basic_Conjugations&quot;_(Verbs)_2-2" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMakinoTsutsui2018576–579\&quot;Appendix 1 Basic Conjugations\&quot; (Verbs)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMakinoTsutsui2018576–579\&quot;Appendix_1_Basic_Conjugations\&quot;_(Verbs)-2&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Makino&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Tsutsui&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;2018&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;576–579&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;Appendix 1 Basic Conjugations\&quot; (Verbs)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMakinoTsutsui2018576–579&quot;Appendix_1_Basic_Conjugations&quot;_(Verbs)-2" id="mwA0o"><span class="mw-reflink-text" id="mwA0s"><span class="cite-bracket" id="mwA0w">[</span>2<span class="cite-bracket" id="mwA00">]</span></span></a></sup></p>

</section><section data-mw-section-id="4" id="mwA04" aria-labelledby="The_bases_of_suru"><div class="mw-heading mw-heading3"><h3 id="The_bases_of_suru">The bases of <i id="mwA08">suru</i></h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Japanese_conjugation&amp;action=edit&amp;section=4" title="Edit section: The bases of suru"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwA1A">Unlike most verbs, <i id="mwA1E">suru</i> and its derived compounds exhibit strong irregularity in their verb bases. In some cases, some variants are preferred over the others, and such preferences vary among speakers. Roughly speaking, there are three major groups that behave similarly:<sup about="#mwt330" class="mw-ref reference" id="cite_ref-tanomura-2001_31-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;tanomura-2001&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-tanomura-2001-31&quot;}}"><a href="#cite_note-tanomura-2001-31" id="mwA1I"><span class="mw-reflink-text" id="mwA1M"><span class="cite-bracket" id="mwA1Q">[</span>30<span class="cite-bracket" id="mwA1U">]</span></span></a></sup></p>
<ul id="mwA1Y"><li id="mwA1c">Group A: <i id="mwA1g">Suru</i> itself and compounds of it and free nouns (which are usually, but not always, spelt with two more kanji if Sino-Japanese): <span title="Hepburn transliteration" about="#mwt331" typeof="mw:Transclusion" id="mwA1k" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;実行する&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;jikkō suru&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|practise}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">jikkō suru</i></span><span style="font-weight: normal" about="#mwt331" id="mwA1o"> (<span title="Japanese-language text"><span lang="ja">実行する</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">practise</span><span class="gloss-quot">'</span>)</span>, <span title="Hepburn transliteration" about="#mwt332" typeof="mw:Transclusion" id="mwA1s" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;得する&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;toku suru&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|gain}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">toku suru</i></span><span style="font-weight: normal" about="#mwt332" id="mwA1w"> (<span title="Japanese-language text"><span lang="ja">得する</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">gain</span><span class="gloss-quot">'</span>)</span>, <span title="Hepburn transliteration" about="#mwt333" typeof="mw:Transclusion" id="mwA10" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;損する&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;son suru&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|lose}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">son suru</i></span><span style="font-weight: normal" about="#mwt333" id="mwA14"> (<span title="Japanese-language text"><span lang="ja">損する</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">lose</span><span class="gloss-quot">'</span>)</span>, <span title="Hepburn transliteration" about="#mwt334" typeof="mw:Transclusion" id="mwA18" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;吃驚する&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;bikkuri suru&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|be startled}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">bikkuri suru</i></span><span style="font-weight: normal" about="#mwt334" id="mwA2A"> (<span title="Japanese-language text"><span lang="ja">吃驚する</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">be startled</span><span class="gloss-quot">'</span>)</span>, <span title="Hepburn transliteration" about="#mwt335" typeof="mw:Transclusion" id="mwA2E" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;ジャンプする&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;janpu suru&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|jump}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">janpu suru</i></span><span style="font-weight: normal" about="#mwt335" id="mwA2I"> (<span title="Japanese-language text"><span lang="ja">ジャンプする</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">jump</span><span class="gloss-quot">'</span>)</span>, etc.</li>
<li id="mwA2M">Group B: Compounds with bound Sino-Japanese morphemes that behave more like <i id="mwA2Q">godan</i> verbs. These often have full-fledged, interchangeable <i id="mwA2U">godan</i> derivatives: <span title="Hepburn transliteration" about="#mwt336" typeof="mw:Transclusion" id="mwA2Y" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;愛す(る)&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;aisu(ru)&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|love}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">aisu(ru)</i></span><span style="font-weight: normal" about="#mwt336" id="mwA2c"> (<span title="Japanese-language text"><span lang="ja">愛す(る)</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">love</span><span class="gloss-quot">'</span>)</span>, <span title="Hepburn transliteration" about="#mwt337" typeof="mw:Transclusion" id="mwA2g" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;属す(る)&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;zokusu(ru)&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|belong}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">zokusu(ru)</i></span><span style="font-weight: normal" about="#mwt337" id="mwA2k"> (<span title="Japanese-language text"><span lang="ja">属す(る)</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">belong</span><span class="gloss-quot">'</span>)</span>, <span title="Hepburn transliteration" about="#mwt338" typeof="mw:Transclusion" id="mwA2o" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;達す(る)&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;tassu(ru)&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|reach}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">tassu(ru)</i></span><span style="font-weight: normal" about="#mwt338" id="mwA2s"> (<span title="Japanese-language text"><span lang="ja">達す(る)</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">reach</span><span class="gloss-quot">'</span>)</span>, etc.
<dl id="mwA2w"><dd id="mwA20">Such a form as <span title="Hepburn transliteration" about="#mwt339" typeof="mw:Transclusion" id="mwA24" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;愛せぬ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;aisenu&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">aisenu</i></span><span style="font-weight: normal" about="#mwt339" id="mwA28"> (<span title="Japanese-language text"><span lang="ja">愛せぬ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span> is supposed to be the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Classical_Japanese" title="Classical Japanese" id="mwA3A">classical Japanese</a> equivalent to <span title="Hepburn transliteration" about="#mwt340" typeof="mw:Transclusion" id="mwA3E" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;愛さない&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;aisanai&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">aisanai</i></span><span style="font-weight: normal" about="#mwt340" id="mwA3I"> (<span title="Japanese-language text"><span lang="ja">愛さない</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span>. Compare the following translations of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/1_John" title="1 John" class="mw-redirect" id="mwA3M">1 John</a> 3:14 ("[…] Anyone who <b id="mwA3Q">does not love</b> remains in death."<sup about="#mwt343" class="mw-ref reference" id="cite_ref-32" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-32&quot;}}"><a href="#cite_note-32" id="mwA3U"><span class="mw-reflink-text" id="mwA3Y"><span class="cite-bracket" id="mwA3c">[</span>31<span class="cite-bracket" id="mwA3g">]</span></span></a></sup>):
<dl id="mwA3k"><dd id="mwA3o"><dl id="mwA3s"><dd id="mwA3w">1917 classical: <span title="Hepburn transliteration" about="#mwt344" typeof="mw:Transclusion" id="mwA30" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;[…]'''愛せぬ'''者は死のうちに居る。&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;[…] '''aisenu''' mono wa shi no uchi ni oru.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">[…] <b>aisenu</b> mono wa shi no uchi ni oru.</i></span><span style="font-weight: normal" about="#mwt344" id="mwA34"> (<span title="Japanese-language text"><span lang="ja">[…]<b>愛せぬ</b>者は死のうちに居る。</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span><sup about="#mwt347" class="mw-ref reference" id="cite_ref-33" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-33&quot;}}"><a href="#cite_note-33" id="mwA38"><span class="mw-reflink-text" id="mwA4A"><span class="cite-bracket" id="mwA4E">[</span>32<span class="cite-bracket" id="mwA4I">]</span></span></a></sup></dd>
<dd id="mwA4M">1955 modern: <span title="Hepburn transliteration" about="#mwt348" typeof="mw:Transclusion" id="mwA4Q" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;[…]'''愛さない'''者は、死のうちにとどまっている。&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;[…] '''Aisanai''' mono wa, shi no uchi ni todomatte iru.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">[…] <b>Aisanai</b> mono wa, shi no uchi ni todomatte iru.</i></span><span style="font-weight: normal" about="#mwt348" id="mwA4U"> (<span title="Japanese-language text"><span lang="ja">[…]<b>愛さない</b>者は、死のうちにとどまっている。</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span><sup about="#mwt351" class="mw-ref reference" id="cite_ref-34" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-34&quot;}}"><a href="#cite_note-34" id="mwA4Y"><span class="mw-reflink-text" id="mwA4c"><span class="cite-bracket" id="mwA4g">[</span>33<span class="cite-bracket" id="mwA4k">]</span></span></a></sup></dd></dl></dd></dl></dd>
<dd id="mwA4o">However, <i id="mwA4s">aisenu</i> ("not love") as the negative of <i id="mwA4w">aisu(ru)</i> ("love") would likely be confused with <i id="mwA40">aisenu</i> ("cannot love") as the negative of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_conjugation_(mizenkei_base)#Potential" title="Japanese conjugation (mizenkei base)" id="mwA44">potential</a> <i id="mwA48">aiseru</i> ("can love") in modern Japanese. It is clear that <i id="mwA5A">aisenu</i> is not the same as <i id="mwA5E">aisanu</i> where they both occur in close proximity: <span title="Hepburn transliteration" about="#mwt352" typeof="mw:Transclusion" id="mwA5I" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;わが子を'''愛さぬ'''者はありません。わが子さえ'''愛せぬ'''者が、どうしてご主君を'''愛せ'''ましょう。&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Wa ga ko o '''aisanu''' mono wa arimasen. Wa ga ko sae '''aisenu''' mono ga, dō shite goshukun o '''aise'''mashō.&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{xlat|No man '''does not love''' his own son. If he '''is not capable of loving''' even his own son, in what way '''could''' he ever '''love''' his lord?}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Wa ga ko o <b>aisanu</b> mono wa arimasen. Wa ga ko sae <b>aisenu</b> mono ga, dō shite goshukun o <b>aise</b>mashō.</i></span><span style="font-weight: normal" about="#mwt352" id="mwA5M"> (<span title="Japanese-language text"><span lang="ja">わが子を<b>愛さぬ</b>者はありません。わが子さえ<b>愛せぬ</b>者が、どうしてご主君を<b>愛せ</b>ましょう。</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <abbr title="translation" about="#mwt353" typeof="mw:ExpandedAttrs" data-mw="{&quot;attribs&quot;:[[{&quot;txt&quot;:&quot;title&quot;},{&quot;html&quot;:&quot;<span typeof=\&quot;mw:Nowiki\&quot; id=\&quot;mwA5Q\&quot;>translation</span>&quot;}]]}">transl.</abbr><span><span typeof="mw:Entity"> </span>No man <b>does not love</b> his own son. If he <b>is not capable of loving</b> even his own son, in what way <b>could</b> he ever <b>love</b> his lord?</span>)</span>.<sup about="#mwt356" class="mw-ref reference" id="cite_ref-nishino-1994_35-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;nishino-1994&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-nishino-1994-35&quot;}}"><a href="#cite_note-nishino-1994-35" id="mwA5U"><span class="mw-reflink-text" id="mwA5Y"><span class="cite-bracket" id="mwA5c">[</span>34<span class="cite-bracket" id="mwA5g">]</span></span></a></sup></dd>
<dd id="mwA5k">There is great variety among Group-B verbs as to whether to choose between the <i id="mwA5o">godan</i>-negative <i id="mwA5s">‑san(u)/‑zu</i> and the classical-negative <i id="mwA5w">‑sen(u)/‑zu</i>, and there are indeed cases where only contexts can clarify whether <i id="mwA50">‑sen(u)/‑zu</i> are truly classical-negative, or actually <i id="mwA54">godan</i>-negative-potential. In general, it seems that if the Sino-Japanese stem contains a moraic obstruent as in <span title="Hepburn transliteration" about="#mwt357" typeof="mw:Transclusion" id="mwA58" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;屈する&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;ku'''s'''suru&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{#invoke:lang|lang|ja|く'''っ'''する}}, {{ipa|/kɯ'''Q'''sɯɾɯ/}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">ku<b>s</b>suru</i></span><span style="font-weight: normal" about="#mwt357" id="mwA6A"> (<span title="Japanese-language text"><span lang="ja">屈する</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span title="Japanese-language text"><span lang="ja">く<b>っ</b>する</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">, <span class="IPA nowrap" lang="und-Latn-fonipa" title="Representation in the International Phonetic Alphabet (IPA)">/kɯ<b>Q</b>sɯɾɯ/</span><link rel="mw:PageProp/Category" href="./Category:Pages_with_plain_IPA">)</span>, a moraic nasal as in <span title="Hepburn transliteration" about="#mwt358" typeof="mw:Transclusion" id="mwA6E" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;反する&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;ha'''n'''suru&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{#invoke:lang|lang|ja|は'''ん'''する}}, {{ipa|/ha'''N'''suru/}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">ha<b>n</b>suru</i></span><span style="font-weight: normal" about="#mwt358" id="mwA6I"> (<span title="Japanese-language text"><span lang="ja">反する</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span title="Japanese-language text"><span lang="ja">は<b>ん</b>する</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">, <span class="IPA nowrap" lang="und-Latn-fonipa" title="Representation in the International Phonetic Alphabet (IPA)">/ha<b>N</b>suru/</span><link rel="mw:PageProp/Category" href="./Category:Pages_with_plain_IPA">)</span>, or lengthening mora as in <span title="Hepburn transliteration" about="#mwt359" typeof="mw:Transclusion" id="mwA6M" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;供する&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;kyōsuru&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{#invoke:lang|lang|ja|きょ'''う'''する}}, {{ipa|/kjo'''R'''sɯɾɯ/}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">kyōsuru</i></span><span style="font-weight: normal" about="#mwt359" id="mwA6Q"> (<span title="Japanese-language text"><span lang="ja">供する</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span title="Japanese-language text"><span lang="ja">きょ<b>う</b>する</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">, <span class="IPA nowrap" lang="und-Latn-fonipa" title="Representation in the International Phonetic Alphabet (IPA)">/kjo<b>R</b>sɯɾɯ/</span><link rel="mw:PageProp/Category" href="./Category:Pages_with_plain_IPA">)</span>, the <i id="mwA6U">godan</i> options are less preferable with all auxiliaries (including the negative <i id="mwA6Y">‑n(u)</i>/<i id="mwA6c">‑zu</i>), though not impossible. Thus, such forms as <span title="Hepburn transliteration" about="#mwt360" typeof="mw:Transclusion" id="mwA6g" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;屈せぬ・屈せず&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;kussenu/kussezu&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|not bend}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">kussenu/kussezu</i></span><span style="font-weight: normal" about="#mwt360" id="mwA6k"> (<span title="Japanese-language text"><span lang="ja">屈せぬ・屈せず</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">not bend</span><span class="gloss-quot">'</span>)</span> are more likely to be classical-negative, while such forms as <span title="Hepburn transliteration" about="#mwt361" typeof="mw:Transclusion" id="mwA6o" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;愛せぬ・愛せず&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;aisenu/aisezu&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|cannot love}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">aisenu/aisezu</i></span><span style="font-weight: normal" about="#mwt361" id="mwA6s"> (<span title="Japanese-language text"><span lang="ja">愛せぬ・愛せず</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">cannot love</span><span class="gloss-quot">'</span>)</span> are more likely to be <i id="mwA6w">godan</i>-negative-potential; and while both <span title="Hepburn transliteration" about="#mwt362" typeof="mw:Transclusion" id="mwA60" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;屈さぬ・屈さず&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;kussanu/kussazu&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|not bend}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">kussanu/kussazu</i></span><span style="font-weight: normal" about="#mwt362" id="mwA64"> (<span title="Japanese-language text"><span lang="ja">屈さぬ・屈さず</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">not bend</span><span class="gloss-quot">'</span>)</span> and <span title="Hepburn transliteration" about="#mwt363" typeof="mw:Transclusion" id="mwA68" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;愛さぬ・愛さず&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;aisanu/aisazu&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|not love}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">aisanu/aisazu</i></span><span style="font-weight: normal" about="#mwt363" id="mwA7A"> (<span title="Japanese-language text"><span lang="ja">愛さぬ・愛さず</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">not love</span><span class="gloss-quot">'</span>)</span> are unambiguously <i id="mwA7E">godan</i>-negative, the former are not as likely as the latter.<sup about="#mwt364" class="mw-ref reference" id="cite_ref-tanomura-2001_31-1" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;tanomura-2001&quot;}}"><a href="#cite_note-tanomura-2001-31" id="mwA7I"><span class="mw-reflink-text" id="mwA7M"><span class="cite-bracket" id="mwA7Q">[</span>30<span class="cite-bracket" id="mwA7U">]</span></span></a></sup></dd></dl></li>
<li id="mwA7Y">Group C: Compounds with bound Sino-Japanese morphemes that behave more like upper (<i id="mwA7c">i</i>-stemmed) <i id="mwA7g">ichidan</i> verbs. These often have full-fledged, interchangeable upper <i id="mwA7k">ichidan</i> derivatives: <span title="Hepburn transliteration" about="#mwt365" typeof="mw:Transclusion" id="mwA7o" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;論ずる→論じる&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;ronzuru → ronjiru&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|discuss}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">ronzuru → ronjiru</i></span><span style="font-weight: normal" about="#mwt365" id="mwA7s"> (<span title="Japanese-language text"><span lang="ja">論ずる→論じる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">discuss</span><span class="gloss-quot">'</span>)</span>, <span title="Hepburn transliteration" about="#mwt366" typeof="mw:Transclusion" id="mwA7w" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;応ずる→応じる&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;ōzuru → ōjiru&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|respond}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">ōzuru → ōjiru</i></span><span style="font-weight: normal" about="#mwt366" id="mwA70"> (<span title="Japanese-language text"><span lang="ja">応ずる→応じる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">respond</span><span class="gloss-quot">'</span>)</span>, <span title="Hepburn transliteration" about="#mwt367" typeof="mw:Transclusion" id="mwA74" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;重んずる→重んじる&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;omonzuru → omonjiru&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|appreciate}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">omonzuru → omonjiru</i></span><span style="font-weight: normal" about="#mwt367" id="mwA78"> (<span title="Japanese-language text"><span lang="ja">重んずる→重んじる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">appreciate</span><span class="gloss-quot">'</span>)</span>, <span title="Hepburn transliteration" about="#mwt368" typeof="mw:Transclusion" id="mwA8A" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;察する→察しる&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;sassuru → sasshiru&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|surmise}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">sassuru → sasshiru</i></span><span style="font-weight: normal" about="#mwt368" id="mwA8E"> (<span title="Japanese-language text"><span lang="ja">察する→察しる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">surmise</span><span class="gloss-quot">'</span>)</span>, etc.</li>
<li id="mwA8I">Group D: Compounds with bound Sino-Japanese morphemes that behave more like lower (<i id="mwA8M">e</i>-stemmed) <i id="mwA8Q">ichidan</i> verbs. These may have full-fledged, interchangeable lower <i id="mwA8U">ichidan</i> derivatives: <span title="Hepburn transliteration" about="#mwt369" typeof="mw:Transclusion" id="mwA8Y" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;進ずる→進ぜる&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;shinzuru → shinzeru&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|provide}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">shinzuru → shinzeru</i></span><span style="font-weight: normal" about="#mwt369" id="mwA8c"> (<span title="Japanese-language text"><span lang="ja">進ずる→進ぜる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">provide</span><span class="gloss-quot">'</span>)</span> and <span title="Hepburn transliteration" about="#mwt370" typeof="mw:Transclusion" id="mwA8g" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;魅する→魅せる&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;misuru → miseru&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|enchant}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">misuru → miseru</i></span><span style="font-weight: normal" about="#mwt370" id="mwA8k"> (<span title="Japanese-language text"><span lang="ja">魅する→魅せる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">enchant</span><span class="gloss-quot">'</span>)</span>.</li></ul>

<p id="mwA8o">Across the following forms of <i id="mwA8s">suru</i> within standard Japanese, an eastern dialect, while there is a dominance of the eastern vowel <i id="mwA8w">i</i> as in <i id="mwA80">shinai</i>,<sup about="#mwt379" class="mw-ref reference" id="cite_ref-shinai-ninjal_36-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;shinai-ninjal&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-shinai-ninjal-36&quot;}}"><a href="#cite_note-shinai-ninjal-36" id="mwA84"><span class="mw-reflink-text" id="mwA88"><span class="cite-bracket" id="mwA9A">[</span>35<span class="cite-bracket" id="mwA9E">]</span></span></a></sup> <i id="mwA9I">shiyō</i><sup about="#mwt382" class="mw-ref reference" id="cite_ref-37" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-37&quot;}}"><a href="#cite_note-37" id="mwA9M"><span class="mw-reflink-text" id="mwA9Q"><span class="cite-bracket" id="mwA9U">[</span>36<span class="cite-bracket" id="mwA9Y">]</span></span></a></sup> and <i id="mwA9c">shiro</i>,<sup about="#mwt385" class="mw-ref reference" id="cite_ref-ninjal-shiro_38-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;ninjal-shiro&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-ninjal-shiro-38&quot;}}"><a href="#cite_note-ninjal-shiro-38" id="mwA9g"><span class="mw-reflink-text" id="mwA9k"><span class="cite-bracket" id="mwA9o">[</span>37<span class="cite-bracket" id="mwA9s">]</span></span></a></sup> the once prestigious western vowel <i id="mwA9w">e</i>, as in <i id="mwA90">sen(u)</i> and <i id="mwA94">seyo</i>, still has currency especially in formal or literary Japanese. Such variants as <i id="mwA98">senai</i> and <i id="mwA-A">sanai</i> (both of <i id="mwA-E">shinai</i>); <i id="mwA-I">shin(u)</i> (of <i id="mwA-M">sen(u)</i>); <i id="mwA-Q">shō</i> (← <i id="mwA-U">seu</i>), <i id="mwA-Y">seyō</i> and <i id="mwA-c">sō</i> (all of <i id="mwA-g">shiyō</i>); <i id="mwA-k">sero</i> (of <i id="mwA-o">shiro</i>); and <i id="mwA-s">shiyo</i>, <i id="mwA-w">sē</i> and <i id="mwA-0">sei</i> (all of <i id="mwA-4">seyo</i>), remain dialectal or obsolete.<sup about="#mwt371" class="mw-ref reference" id="cite_ref-FOOTNOTEMartin2004371_39-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMartin2004371&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMartin2004371-39&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Martin&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2004&quot;},&quot;p&quot;:{&quot;wt&quot;:&quot;371&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMartin2004371-39" id="mwA-8"><span class="mw-reflink-text" id="mwA_A"><span class="cite-bracket" id="mwA_E">[</span>38<span class="cite-bracket" id="mwA_I">]</span></span></a></sup><sup about="#mwt374" class="mw-ref reference" id="cite_ref-FOOTNOTEMinistry_of_Education,_Science,_Sports_and_Culture1935a248_40-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMinistry of Education, Science, Sports and Culture1935a248&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMinistry_of_Education,_Science,_Sports_and_Culture1935a248-40&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfn