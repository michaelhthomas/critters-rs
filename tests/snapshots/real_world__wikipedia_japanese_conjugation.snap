<td rowspan="2" id="mwAmg"><small id="mwAmk">infinitive, <span about="#mwt248" typeof="mw:Transclusion" id="mwAmo" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;conjunctive&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;中止形&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;chūshikei&quot;}},&quot;i&quot;:0}}]}">conjunctive</span><span style="font-weight: normal" about="#mwt248" id="mwAms"> (<span title="Japanese-language text"><span lang="ja">中止形</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">, <span title="Hepburn transliteration"><i lang="ja-Latn">chūshikei</i></span><span style="margin-left:.09em">)</span></span>, continuative, connective, adverbial<sup about="#mwt251" class="mw-ref reference" id="cite_ref-26" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-26&quot;}}"><a href="#cite_note-26" id="mwAmw"><span class="mw-reflink-text" id="mwAm0"><span class="cite-bracket" id="mwAm4">[</span>25<span class="cite-bracket" id="mwAm8">]</span></span></a></sup></small></td>
<th colspan="2" style="text-align:left;font-weight:normal" id="mwAnA"><small id="mwAnE">Shift the <span title="Japanese-language text" about="#mwt252" typeof="mw:Transclusion" id="mwAnI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;〜〇&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">〜〇</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt252" id="mwAnM"> kana to the <span title="Japanese-language text" about="#mwt253" typeof="mw:Transclusion" id="mwAnQ" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;い&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">い</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt253" id="mwAnU"> row</small></th>
