<td rowspan="2" id="mwFo0"><span style="font-weight: normal" about="#mwt2604" typeof="mw:Transclusion" id="mwFo4" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo_krt&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;be good&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;良い&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;ii/yoi&quot;}},&quot;i&quot;:0}}]}"><span title="Japanese-language text"><span lang="ja">良い</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text"> (<span title="Hepburn transliteration"><i lang="ja-Latn">ii/yoi</i></span>, be good)</span><br id="mwFo8"><span style="font-weight: normal" about="#mwt2605" typeof="mw:Transclusion" id="mwFpA" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo_krt&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;良かる&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yokaru&quot;}},&quot;i&quot;:0}}]}"><span title="Japanese-language text"><span lang="ja">良かる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text"> <span style="margin-right:.09em">(</span><span title="Hepburn transliteration"><i lang="ja-Latn">yokaru</i></span>)</span><br id="mwFpE"><span style="font-weight: normal" about="#mwt2606" typeof="mw:Transclusion" id="mwFpI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo_krt&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;良くある&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yoku aru&quot;}},&quot;i&quot;:0}}]}"><span title="Japanese-language text"><span lang="ja">良くある</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text"> <span style="margin-right:.09em">(</span><span title="Hepburn transliteration"><i lang="ja-Latn">yoku aru</i></span>)</span></td>
<td style="text-align:right" id="mwFpM"><span title="Japanese-language text" about="#mwt2607" typeof="mw:Transclusion" id="mwFpQ" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;良か&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">良か</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt2607" id="mwFpU"><b id="mwFpY"><span style="color:#04b" id="mwFpc"><span title="Japanese-language text" about="#mwt2608" typeof="mw:Transclusion" id="mwFpg" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;る&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">る</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt2608" id="mwFpk"></span></b></td>
