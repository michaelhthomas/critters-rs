<tr id="mwFqQ">
<td style="text-align:right" id="mwFqU"><span title="Japanese-language text" about="#mwt2612" typeof="mw:Transclusion" id="mwFqY" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;良くあ&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">良くあ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt2612" id="mwFqc"><b id="mwFqg"><span style="color:#04b" id="mwFqk"><span title="Japanese-language text" about="#mwt2613" typeof="mw:Transclusion" id="mwFqo" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;る&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">る</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt2613" id="mwFqs"></span></b></td>
<td style="text-align:right;border-right:none" id="mwFqw"><span title="Japanese-language text" about="#mwt2614" typeof="mw:Transclusion" id="mwFq0" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;良くあ&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">良くあ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt2614" id="mwFq4"><b id="mwFq8"><span style="color:#04b" id="mwFrA"><span title="Japanese-language text" about="#mwt2615" typeof="mw:Transclusion" id="mwFrE" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;れ&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">れ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt2615" id="mwFrI"></span></b></td>
<td style="border-left:none" id="mwFrM"></td>
<td id="mwFrQ"><span style="font-weight: normal" about="#mwt2616" typeof="mw:Transclusion" id="mwFrU" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo_krt&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;be good!/may one be good&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;良くあれ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yoku are&quot;}},&quot;i&quot;:0}}]}"><span title="Japanese-language text"><span lang="ja">良くあれ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text"> <span style="margin-right:.09em">(</span><span title="Hepburn transliteration"><i lang="ja-Latn">yoku are</i></span>, be good!/may one be good)</span><sup about="#mwt2619" class="mw-ref reference" id="cite_ref-ikeda-1993_219-1" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;ikeda-1993&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-ikeda-1993-219&quot;}}"><a href="#cite_note-ikeda-1993-219" id="mwFrY"><span class="mw-reflink-text" id="mwFrc"><span class="cite-bracket" id="mwFrg">[</span>206<span class="cite-bracket" id="mwFrk">]</span></span></a></sup><sup about="#mwt2622" class="mw-ref reference" id="cite_ref-435" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-435&quot;}}"><a href="#cite_note-435" id="mwFro"><span class="mw-reflink-text" id="mwFrs"><span class="cite-bracket" id="mwFrw">[</span>411<span class="cite-bracket" id="mwFr0">]</span></span></a></sup><sup about="#mwt2625" class="mw-ref reference" id="cite_ref-436" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-436&quot;}}"><a href="#cite_note-436" id="mwFr4"><span class="mw-reflink-text" id="mwFr8"><span class="cite-bracket" id="mwFsA">[</span>412<span class="cite-bracket" id="mwFsE">]</span></span></a></sup><sup about="#mwt2628" class="mw-ref reference" id="cite_ref-437" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-437&quot;}}"><a href="#cite_note-437" id="mwFsI"><span class="mw-reflink-text" id="mwFsM"><span class="cite-bracket" id="mwFsQ">[</span>413<span class="cite-bracket" id="mwFsU">]</span></span></a></sup></td></tr>
</tbody></table>

</section><section data-mw-section-id="20" id="mwFsY" aria-labelledby="Imperative:_Grammatical_compatibility"><div class="mw-heading mw-heading3"><h3 id="Imperative:_Grammatical_compatibility">Imperative: Grammatical compatibility</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Japanese_conjugation&amp;action=edit&amp;section=20" title="Edit section: Imperative: Grammatical compatibility"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwFsc">When quoted, imperatives are followed by the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Quotative" title="Quotative" id="mwFsg">quotative</a> particles such as <i id="mwFsk">to(te)</i> or <i id="mwFso">tte</i>, and then a word for saying, telling, asking, ordering, begging, wishing, hoping, praying, etc. The resulting clauses can be translated indiscriminately into English as <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Direct_speech" title="Direct speech" class="mw-redirect" id="mwFss">direct speech</a> ("she told me, 'Go!'", "he wished, "May you be well.") or <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Indirect_speech" title="Indirect speech" id="mwFsw">indirect speech</a> ("she told me to go", "he wished me well"). Typographically, the quotation marks <span title="Japanese-language text" about="#mwt2629" typeof="mw:Transclusion" id="mwFs0" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;「」『』〝〟&quot;}},&quot;i&quot;:0}}]}"><i lang="ja">「」『』〝〟</i></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt2629" id="mwFs4"> can be used for "direct speech" in written stories, but the verb forms themselves are not any different whether "direct" or "indirect."</p>

<table class="wikitable" id="mwFs8">
<caption style="text-align:left" id="mwFtA">Quoted imperatives</caption>
<tbody id="mwFtE"><tr id="mwFtI">
<th id="mwFtM">English</th>
<th id="mwFtQ">Japanese</th>
<th id="mwFtU">Function</th></tr>
<tr id="mwFtY">
<td id="mwFtc">‘Fly, you fools!’ he cried, and was gone.</td>
<td id="mwFtg"><span title="Hepburn transliteration" about="#mwt2630" typeof="mw:Transclusion" id="mwFtk" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;「'''逃げろ'''、ばか者ども！」'''と'''、かれは'''叫んで'''、見えなくなりました。<ref>{{#invoke:cite|book|lang=ja|page=32|script-chapter=ja:五 カザド゠ドゥムの橋|chapter=V The Bridge of Khazad-dûm|script-title=ja:旅の仲間　下２|trans-title=[[The Fellowship of the Ring|The Travelling Fellowship]]: Book 2, Part 2|volume=4|series={{#invoke:lang|lang|ja|指輪物語}}|translator-last=Seta|translator-first=Teiji|translator-first2=Akiko|translator-last2=Tanaka|authorlink=J. R. R. Tolkien|first=John Ronald Reuel|last=Tolkien|publisher=Hyōronsha|date=10 May 2002|orig-date=30 July 1992|location=[[Shinjuku]], Tokyo|isbn=4-566-02365-6}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;“'''Nigero''', bakamonodomo!” '''to''', kare wa '''sakende''', mienaku narimashita.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">“<b>Nigero</b>, bakamonodomo!” <b>to</b>, kare wa <b>sakende</b>, mienaku narimashita.</i></span><span style="font-weight: normal" about="#mwt2630" id="mwFto"> (<span title="Japanese-language text"><span lang="ja">「<b>逃げろ</b>、ばか者ども！」<b>と</b>、かれは<b>叫んで</b>、見えなくなりました。<sup about="#mwt2633" class="mw-ref reference" id="cite_ref-438" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-438&quot;}}"><a href="#cite_note-438" id="mwFts"><span class="mw-reflink-text" id="mwFtw"><span class="cite-bracket" id="mwFt0">[</span>414<span class="cite-bracket" id="mwFt4">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td>
<td rowspan="11" id="mwFt8">quoted command</td></tr>
<tr id="mwFuA">
<td id="mwFuE"><i id="mwFuI">No, don’t ask me to come back to Biloxi. Don’t ask me to face the demons that have haunted me for six years. Don’t ask me to become personally involved in your life.</i></td>
<td id="mwFuM"><span title="Hepburn transliteration" about="#mwt2636" typeof="mw:Transclusion" id="mwFuQ" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;頼む、ぼくにビロクシに'''戻れと言わないでくれ'''。この六年間、ぼくを苦しめ続けた悪魔と'''対峙しろと言わないでくれ'''。きみの人生に'''かかわれと言わないでくれ'''。<ref>{{#invoke:cite|book|lang=ja|quote=“Are you calling to ask for my help?” ''No, don’t ask me to come back to Biloxi. Don’t ask me to face the demons that have haunted me for six years. Don’t ask me to become personally involved in your life.''|script-quote=ja:「ぼくに助けてほしいと？」頼む、ぼくにビロクシに戻れと言わないでくれ。この六年間、ぼくを苦しめ続けた悪魔と<ruby>対峙<rp>(</rp><rt>たいじ</rt><rp>)</rp></ruby>しろと言わないでくれ。きみの人生にかかわれと言わないでくれ。|chapter=Chapter 1|script-chapter=ja:１|date=15 May 2018|orig-date=20 April 2004|publisher=HarperCollins Japan|authorlink=Beverly Barton|first=Beverly|last=Barton|translator-last=Tsuji|translator-first=Sanae|title=Guarding Jeannie|script-title=ja:天使と野獣|trans-title=Angels and Beasts|isbn=978-4-596-91756-0}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Tanomu, boku ni Birokushi ni '''modore to iwanai de kure'''. Kono rokunenkan, boku o kurushimetsuzuketa akuma to '''taiji shiro to iwanai de kure'''. Kimi no jinsei ni '''kakaware to iwanai de kure'''.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Tanomu, boku ni Birokushi ni <b>modore to iwanai de kure</b>. Kono rokunenkan, boku o kurushimetsuzuketa akuma to <b>taiji shiro to iwanai de kure</b>. Kimi no jinsei ni <b>kakaware to iwanai de kure</b>.</i></span><span style="font-weight: normal" about="#mwt2636" id="mwFuU"> (<span title="Japanese-language text"><span lang="ja">頼む、ぼくにビロクシに<b>戻れと言わないでくれ</b>。この六年間、ぼくを苦しめ続けた悪魔と<b>対峙しろと言わないでくれ</b>。きみの人生に<b>かかわれと言わないでくれ</b>。<sup about="#mwt2639" class="mw-ref reference" id="cite_ref-439" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-439&quot;}}"><a href="#cite_note-439" id="mwFuY"><span class="mw-reflink-text" id="mwFuc"><span class="cite-bracket" id="mwFug">[</span>415<span class="cite-bracket" id="mwFuk">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwFuo">
<td id="mwFus">it didn’t mean she intended to gushingly enquire <i id="mwFuw">how high</i> when he said <i id="mwFu0">jump</i>.</td>
<td id="mwFu4"><span title="Hepburn transliteration" about="#mwt2642" typeof="mw:Transclusion" id="mwFu8" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;彼が“'''跳べ'''”'''と命じた'''とき、“どの高さまで跳びましょうか？”と揉み手をしながら応じる部下だけではないということを。<ref>{{#invoke:cite|book|lang=ja|script-quote=ja:正面切ってぶつかる以外方法はないのだ。さもないと生きたまま丸のみにされるか、凍傷を負うほどの冷淡さで無視されるかのどちらかだ。通常、ザックに対してノーというのほ勘違いをした愚か者だけだ。だが、たまには彼に思い出させてやるのも悪くない。たとえノーという言葉がザックの辞書に存在しなくても、彼が“跳べ”と命じたとき、“どの高さまで跳びましょうか？”と<ruby>揉<rp>(</rp><rt>も</rt><rp>)</rp></ruby>み手をしながら応じる部下だけではないということを。|quote=Anything other than toe-to-toe combat was just asking to be eaten alive and spat aside with singeing indifference. He responded to challenges, usually attempted by misguided fools who dared to say no to him. But occasionally it didn’t hurt to remind the man that simply because that word didn’t exist in his vocabulary, it didn’t mean she intended to gushingly enquire ''how high'' when he said ''jump''.|script-title=ja:灰かぶりの愛と献身|trans-title=A Cinderella’s Love and Devotion|title=Kidnapped for His Royal Heir|first=Maya|last=Blake|date=20 March 2021|translator-last=Katayama|translator-first=Maki|isbn=978-4-596-13569-8|publisher=HarperCollins Japan|script-chapter=ja:１|chapter=Chapter One}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;kare ga “'''tobe'''” '''to meijita''' toki, “dono takasa made tobimashō ka?” to momide o shinagara ōjiru buka dake de wa nai to yū koto o.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">kare ga “<b>tobe</b>” <b>to meijita</b> toki, “dono takasa made tobimashō ka?” to momide o shinagara ōjiru buka dake de wa nai to yū koto o.</i></span><span style="font-weight: normal" about="#mwt2642" id="mwFvA"> (<span title="Japanese-language text"><span lang="ja">彼が“<b>跳べ</b>”<b>と命じた</b>とき、“どの高さまで跳びましょうか？”と揉み手をしながら応じる部下だけではないということを。<sup about="#mwt2645" class="mw-ref reference" id="cite_ref-440" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-440&quot;}}"><a href="#cite_note-440" id="mwFvE"><span class="mw-reflink-text" id="mwFvI"><span class="cite-bracket" id="mwFvM">[</span>416<span class="cite-bracket" id="mwFvQ">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwFvU">
<td id="mwFvY">Sakurauchi had already ordered that anyone who resisted, except Kumematsu, be put to the sword.</td>
<td id="mwFvc"><span title="Hepburn transliteration" about="#mwt2648" typeof="mw:Transclusion" id="mwFvg" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;桜内は先刻、粂松以外は、刃向かえば'''斬殺せよと命じていた'''。<ref>{{#invoke:cite|book|lang=ja|script-quote=ja:桜内は先刻、粂松以外は、刃向かえば<ruby>斬<rp>(</rp><rt>ざん</rt><rp>)</rp></ruby><ruby>殺<rp>(</rp><rt>さつ</rt><rp>)</rp></ruby>せよと命じていた。|page=273|script-chapter=ja:火盗改対鬼安一家|script-title=ja:<ruby>影<rp>(</rp><rt>かげ</rt><rp>)</rp></ruby><ruby>仕<rp>(</rp><rt>し</rt><rp>)</rp></ruby><ruby>置<rp>(</rp><rt>おき</rt><rp>)</rp></ruby>　<ruby>将<rp>(</rp><rt>しょう</rt><rp>)</rp></ruby><ruby>軍<rp>(</rp><rt>ぐん</rt><rp>)</rp></ruby><ruby>舎<rp>(</rp><rt>しゃ</rt><rp>)</rp></ruby><ruby>弟<rp>(</rp><rt>てい</rt><rp>)</rp></ruby><ruby>隠<rp>(</rp><rt>おん</rt><rp>)</rp></ruby><ruby>密<rp>(</rp><rt>みつ</rt><rp>)</rp></ruby><ruby>帳<rp>(</rp><rt>ちょう</rt><rp>)</rp></ruby>|last=Miyagi|first=Kenshū|date=28 June 2011|publisher=Gakken Publishing|location=[[Shinagawa]], Tokyo}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Sakurauchi wa senkoku, Kumematsu igai wa, hamukaeba '''zansatsu seyo to meijite ita'''.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Sakurauchi wa senkoku, Kumematsu igai wa, hamukaeba <b>zansatsu seyo to meijite ita</b>.</i></span><span style="font-weight: normal" about="#mwt2648" id="mwFvk"> (<span title="Japanese-language text"><span lang="ja">桜内は先刻、粂松以外は、刃向かえば<b>斬殺せよと命じていた</b>。<sup about="#mwt2651" class="mw-ref reference" id="cite_ref-441" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-441&quot;}}"><a href="#cite_note-441" id="mwFvo"><span class="mw-reflink-text" id="mwFvs"><span class="cite-bracket" id="mwFvw">[</span>417<span class="cite-bracket" id="mwFv0">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwFv4">
<td id="mwFv8">Orders to be on guard against night raids were common, but one to sleep early, as would be issued to children, was unusual.<br id="mwFwA">[…]<br id="mwFwE">At all events, since Nobunaga’s order was to sleep early, everyone finished dinner and promptly went to sleep.</td>
<td id="mwFwI"><span title="Hepburn transliteration" about="#mwt2654" typeof="mw:Transclusion" id="mwFwM" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;夜襲を'''警戒せよとの命令'''はよく出るが、早く'''寝よ'''など'''という'''、子どもに注意するような'''命令'''は異例であった。<br/>[…]<br/>とにかく、早く'''寝よとの'''信長の'''命令'''であったから、飯を食い終わると早々に誰しもが寝た。<ref name=ito-2010/>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Yashū o '''keikai seyo to no meirei''' wa yoku deru ga, hayaku '''neyo''' nado '''to yū''', kodomo ni chūi suru yō na '''meirei''' wa irei de atta.<br/>[…]<br/>Tonikaku, hayaku '''neyo to no''' Nobunaga no '''meirei''' de atta kara, meshi o kuiowaru to sōsō ni dare shi mo ga neta.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Yashū o <b>keikai seyo to no meirei</b> wa yoku deru ga, hayaku <b>neyo</b> nado <b>to yū</b>, kodomo ni chūi suru yō na <b>meirei</b> wa irei de atta.<br>[…]<br>Tonikaku, hayaku <b>neyo to no</b> Nobunaga no <b>meirei</b> de atta kara, meshi o kuiowaru to sōsō ni dare shi mo ga neta.</i></span><span style="font-weight: normal" about="#mwt2654" id="mwFwQ"> (<span title="Japanese-language text"><span lang="ja">夜襲を<b>警戒せよとの命令</b>はよく出るが、早く<b>寝よ</b>など<b>という</b>、子どもに注意するような<b>命令</b>は異例であった。<br>[…]<br>とにかく、早く<b>寝よとの</b>信長の<b>命令</b>であったから、飯を食い終わると早々に誰しもが寝た。<sup about="#mwt2655" class="mw-ref reference" id="cite_ref-ito-2010_227-1" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;ito-2010&quot;}}"><a href="#cite_note-ito-2010-227" id="mwFwU"><span class="mw-reflink-text" id="mwFwY"><span class="cite-bracket" id="mwFwc">[</span>214<span class="cite-bracket" id="mwFwg">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwFwk">
<td id="mwFwo">“[…] Tell the Demon King to come out quickly and face me in battle.”</td>
<td id="mwFws"><span title="Hepburn transliteration" about="#mwt2657" typeof="mw:Transclusion" id="mwFww" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;『[…]魔王に早く出て勝負を'''せいと言つて'''吳れ。』<ref>{{#invoke:cite|book|lang=ja|script-quote=ja:『これ〱<ruby>逃<rp>(</rp><rt>に</rt><rp>)</rp></ruby>げることはない！』と<ruby>悟<rp>(</rp><rt>ご</rt><rp>)</rp></ruby><ruby>空<rp>(</rp><rt>くう</rt><rp>)</rp></ruby>は<ruby>後<rp>(</rp><rt>うしろ</rt><rp>)</rp></ruby>から<ruby>聲<rp>(</rp><rt>こゑ</rt><rp>)</rp></ruby>を<ruby>掛<rp>(</rp><rt>か</rt><rp>)</rp></ruby>けた。『<ruby>俺<rp>(</rp><rt>おれ</rt><rp>)</rp></ruby>は<ruby>花<rp>(</rp><rt>くわ</rt><rp>)</rp></ruby><ruby>果<rp>(</rp><rt>くわ</rt><rp>)</rp></ruby><ruby>山<rp>(</rp><rt>ざん</rt><rp>)</rp></ruby><ruby>水<rp>(</rp><rt>すゐ</rt><rp>)</rp></ruby><ruby>簾<rp>(</rp><rt>れん</rt><rp>)</rp></ruby><ruby>洞<rp>(</rp><rt>どう</rt><rp>)</rp></ruby>の<ruby>主<rp>(</rp><rt>あるじ</rt><rp>)</rp></ruby>だが、<ruby>貴<rp>(</rp><rt>き</rt><rp>)</rp></ruby><ruby>樣<rp>(</rp><rt>さま</rt><rp>)</rp></ruby>の<ruby>家<rp>(</rp><rt>うち</rt><rp>)</rp></ruby>の<ruby>混<rp>(</rp><rt>こん</rt><rp>)</rp></ruby><ruby>世<rp>(</rp><rt>せい</rt><rp>)</rp></ruby><ruby>魔<rp>(</rp><rt>ま</rt><rp>)</rp></ruby><ruby>王<rp>(</rp><rt>わう</rt><rp>)</rp></ruby>が、<ruby>每<rp>(</rp><rt>まい</rt><rp>)</rp></ruby><ruby>度<rp>(</rp><rt>ど</rt><rp>)</rp></ruby><ruby>俺<rp>(</rp><rt>おれ</rt><rp>)</rp></ruby>の<ruby>眷<rp>(</rp><rt>けん</rt><rp>)</rp></ruby><ruby>屬<rp>(</rp><rt>ぞく</rt><rp>)</rp></ruby>を<ruby>苦<rp>(</rp><rt>くるし</rt><rp>)</rp></ruby>めると<ruby>聞<rp>(</rp><rt>き</rt><rp>)</rp></ruby>いて、<ruby>今日<rp>(</rp><rt>けふ</rt><rp>)</rp></ruby>は<ruby>態<rp>(</rp><rt>わざ</rt><rp>)</rp></ruby><ruby>々<rp>(</rp><rt>〲</rt><rp>)</rp></ruby><ruby>出<rp>(</rp><rt>で</rt><rp>)</rp></ruby><ruby>掛<rp>(</rp><rt>か</rt><rp>)</rp></ruby>けて<ruby>來<rp>(</rp><rt>き</rt><rp>)</rp></ruby>たのだ、<ruby>魔<rp>(</rp><rt>ま</rt><rp>)</rp></ruby><ruby>王<rp>(</rp><rt>わう</rt><rp>)</rp></ruby>に<ruby>早<rp>(</rp><rt>はや</rt><rp>)</rp></ruby>く<ruby>出<rp>(</rp><rt>で</rt><rp>)</rp></ruby>て<ruby>勝<rp>(</rp><rt>しよう</rt><rp>)</rp></ruby><ruby>負<rp>(</rp><rt>ぶ</rt><rp>)</rp></ruby>をせいと<ruby>言<rp>(</rp><rt>い</rt><rp>)</rp></ruby>つて<ruby>吳<rp>(</rp><rt>く</rt><rp>)</rp></ruby>れ。』|trans-quote=“There is no running!” [[Wukong]] called out from behind. “I am the Lord of the Water-Screened Cave in the [[Mount Huaguo|Mountain of Flowers and Fruits]]. I heard that your Demon King of Chaos kept tormenting my kindred, so I have come all the way here today. Tell the Demon King to come out quickly and face me in battle.”|page=24|url=https://dl.ndl.go.jp/pid/1168380/1/28|script-chapter=ja:（'''四'''） <ruby>混<rp>(</rp><rt>こん</rt><rp>)</rp></ruby><ruby>世<rp>(</rp><rt>せい</rt><rp>)</rp></ruby><ruby>魔<rp>(</rp><rt>ま</rt><rp>)</rp></ruby><ruby>王<rp>(</rp><rt>わう</rt><rp>)</rp></ruby>|trans-chapter=('''4''') [[List of Journey to the West characters#Antagonists|Demon King of Chaos]]|script-title=ja:西遊記|trans-title=[[Journey to the West]]|authorlink=Wu Cheng'en|last1=Wu|first1=Cheng'en|first2=Kotō|last2=Nakajima|publisher=Fuzambo|date=10 November 1949|location=[[Chiyoda, Tokyo]]}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;“[…] Maō ni hayaku dete shōbu o '''sei to itte''' kure.”&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">“[…] Maō ni hayaku dete shōbu o <b>sei to itte</b> kure.”</i></span><span style="font-weight: normal" about="#mwt2657" id="mwFw0"> (<span title="Japanese-language text"><span lang="ja">『[…]魔王に早く出て勝負を<b>せいと言つて</b>吳れ。』<sup about="#mwt2660" class="mw-ref reference" id="cite_ref-442" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-442&quot;}}"><a href="#cite_note-442" id="mwFw4"><span class="mw-reflink-text" id="mwFw8"><span class="cite-bracket" id="mwFxA">[</span>418<span class="cite-bracket" id="mwFxE">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwFxI">
<td id="mwFxM">The allure of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Taiga" title="Taiga" id="mwFxQ">taiga</a> was already welling up all over his body from the depths of his soul; enticing and deceptive, his distant hometown which he had not heard of was beckoning him to quickly escape from his drab routine.</td>
<td id="mwFxU"><span title="Hepburn transliteration" about="#mwt2663" typeof="mw:Transclusion" id="mwFxY" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;そして今や密林の誘惑が心の奧底から彼のからだ中に湧き上り、誘引し、欺き寄せる、消息の不明な、遠く隔つた故鄕が早く灰色の日常から'''脫れて來よと'''彼を'''手招いた'''のであるから、<ref>{{#invoke:cite|book|lang=ja|script-quote=ja:この或る物とは何だらう。最初私にはそれがどうしても分らなかつたが、今漸くはつきり分つて來た。流浪が習慣になつてゐるこの男は、自分の靜な生活と自分の家と牝牛と三歲になる牡牛と自分に拂はれてゐる尊敬とによつて自分はもう滿足なのだと先刻あんなにきつぱりと言つたのは、あれは我れと我が身を欺いたのであつた。實際、この灰色な生活、――厭はしい、愛想よくない異境の生活は自分の爲すべき本當のものではない――かういふやうな考へをば彼は常に抑へつけてゐるが心の奧底では絕えず自覺してゐるのだ。そして今や密林の誘惑が心の奧底から彼のからだ中に湧き上り、誘引し、欺き寄せる、消息の不明な、遠く隔つた故鄕が早く灰色の日常から脫れて來よと彼を手招いたのであるから、私はこの特質を自分に說明して見た。だがそれはその後の事である。その時はたゞ、此男は表面は如何にも落ち着いてゐるやうに見せかけてはゐるが、心の奧底では絕えず何物かが踠き苦しんでゐる、何物かが外部へ迸り出やうとしてゐるといふことだけを私は認めたのであつた……|trans-quote=There was one thing I wondered about. I did not figure out what it was at first, but it had since become clear now. The habitual vagabond, in saying in no uncertain terms a moment ago that he was content with his quiet life, his house, his cow, his three-year-old bull, and the respect shown to him, was deceiving himself. In truth, he was used to suppressing the thought that this drab life,――a loathsome, unwelcoming life in a foreign land――was not worth living for him, but deep down, he was always aware of it. The allure of the [[taiga]] was already welling up all over his body from the depths of his soul; enticing and deceptive, his distant hometown which he had not heard of was beckoning him to quickly escape from his drab routine. That is how I explained this trait to myself after the fact. At the time, I only saw that, despite the apparent calmness, something was constantly writhing deep within the man, something was about to burst through to the outside……|quote=Сначала я не мог отдать себе отчета, что именно это было. Теперь я уже знаю: привычный бродяга обманывал себя, уверяя, что он доволен своим спокойным существованием, своим домком, и коровкой, и бычком по третьему году, и оказываемым ему уважением. В глубине души он сознавал, — хотя и подавлял пока это сознание, — что эта серая жизнь, жизнь на чужбине, постылой и неприветной, не про него. Из глубины души уже подымались в нем призывы тайги, его манила уже от серых будней безвестная, заманчивая и обманчивая даль. Так объяснил я себе эту черту впоследствии, но тогда я видел только, что бродягу, несмотря на кажущееся спокойствие, что-то гложет внутри, что-то прорывается наружу…|page=19|url=https://dl.ndl.go.jp/pid/978164/1/17|script-chapter=ja:サガレン脫走記|trans-chapter=Escape from [[Saghalien]]|chapter=Соколинец|script-title=ja:創作　サガレン脫走記|trans-title=Escape from Saghalien: A Novel|authorlink=Vladimir Korolenko|first=Vladimir Galaktionovich|last=Korolenko|translator-last=Sekiguchi|translator-first=Yasaku|date=3 September 1926|publisher=Ōsaka Yagō Shoten|location=[[Nihonbashi]], Tokyo}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;So shite ima ya mitsurin no yūwaku ga kokoro no okusoko kara kare no karadajū ni wakiagari, yūin shi, azamukiyoseru, shōsoku no fumei na, tōku hedatatta kokyō ga hayaku haiiro no nichijō kara '''nogarete koyo to''' kare o '''temaneita''' no de aru kara,&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">So shite ima ya mitsurin no yūwaku ga kokoro no okusoko kara kare no karadajū ni wakiagari, yūin shi, azamukiyoseru, shōsoku no fumei na, tōku hedatatta kokyō ga hayaku haiiro no nichijō kara <b>nogarete koyo to</b> kare o <b>temaneita</b> no de aru kara,</i></span><span style="font-weight: normal" about="#mwt2663" id="mwFxc"> (<span title="Japanese-language text"><span lang="ja">そして今や密林の誘惑が心の奧底から彼のからだ中に湧き上り、誘引し、欺き寄せる、消息の不明な、遠く隔つた故鄕が早く灰色の日常から<b>脫れて來よと</b>彼を<b>手招いた</b>のであるから、<sup about="#mwt2666" class="mw-ref reference" id="cite_ref-443" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-443&quot;}}"><a href="#cite_note-443" id="mwFxg"><span class="mw-reflink-text" id="mwFxk"><span class="cite-bracket" id="mwFxo">[</span>419<span class="cite-bracket" id="mwFxs">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwFxw">
<td id="mwFx0">He curses me, then he tells Woo to look if there are sacks with seed in the barn.</td>
<td id="mwFx4"><span title="Hepburn transliteration" about="#mwt2669" typeof="mw:Transclusion" id="mwFx8" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;旦那はわしに悪たれて、納屋に種子の袋があるかねえか'''見て来うと'''ウーに'''言いました'''。<ref>{{#invoke:cite|book|lang=ja|script-quote=ja:家にもどると、旦那はここのテーブルに坐ってました。赤い銭箱が前に置いてあるんで、旦那が地代をほしがってんのが分かりました。わしが<ruby>銭<rp>(</rp><rt>ぜに</rt><rp>)</rp></ruby>はねえ、新しい種子を<ruby>買<rp>(</rp><rt>こ</rt><rp>)</rp></ruby>うたちうと、旦那はわしに悪たれて、納屋に種子の袋があるかねえか見て<ruby>来<rp>(</rp><rt>こ</rt><rp>)</rp></ruby>うとウーに言いました。それから、私がウーに畑を全部見せねばならんと旦那は言いやした。|quote=“When I come back to the house, the master is sitting at the table here. The red cashbox is standing in front of him. I know he wants the rent. I say I haven’t got it, I had bought new seed. He curses me, then he tells Woo to look if there are sacks with seed in the barn. Then, he says, I must show Woo all over our fields.|script-chapter=ja:'''第九章'''　【判事は部下をつれて農家を捜索し奇怪な発見が桑藪の中でなされる】|chapter=<span style=font-variant:small-caps>Ninth Chapter</span>: Judge Dee takes his men to inspect a farmhouse; a strange discovery is made in the mulberry bush|script-title=ja:中国黄金殺人事件|title=The Chinese Gold Murders|authorlink=Robert van Gulik|first=Robert Hans|last=van Gulik|translator-first=Mikio|translator-last=Ōmuro|date=20 January 2003|orig-date=1 June 1989|publisher=Gutenberg21|location=[[Setagaya]], Tokyo}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;danna wa washi ni akutarete, naya ni tane no fukuro ga aru ka nē ka '''mite kō to''' Ū ni '''iimashita'''.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">danna wa washi ni akutarete, naya ni tane no fukuro ga aru ka nē ka <b>mite kō to</b> Ū ni <b>iimashita</b>.</i></span><span style="font-weight: normal" about="#mwt2669" id="mwFyA"> (<span title="Japanese-language text"><span lang="ja">旦那はわしに悪たれて、納屋に種子の袋があるかねえか<b>見て来うと</b>ウーに<b>言いました</b>。<sup about="#mwt2672" class="mw-ref reference" id="cite_ref-444" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-444&quot;}}"><a href="#cite_note-444" id="mwFyE"><span class="mw-reflink-text" id="mwFyI"><span class="cite-bracket" id="mwFyM">[</span>420<span class="cite-bracket" id="mwFyQ">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwFyU">
<td id="mwFyY">“[…] If I’d been told on the phone to come back, I would’ve been flying home……!”<br id="mwFyc">[…]<br id="mwFyg">If her mother forgot, her father should’ve at least said, “Takaomi’s here, tell her to get back home.”</td>
<td id="mwFyk"><span title="Hepburn transliteration" about="#mwt2675" typeof="mw:Transclusion" id="mwFyo" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;「[…]電話をかけたときにでも'''帰って来いって言われれば'''、わたし、飛んで帰ってきたのに……！」<br/>[…]<br/>母が言うのを忘れたのなら、「隆臣君が来ているから'''帰って来いって言いなさい'''」とでも父が言ってくれたらよかったのだ。<ref name=tamaki-2018>{{#invoke:cite|book|lang=ja|script-quote=ja:「た……隆臣さん……、もしかしてずっと待っていてくれたんですか？」<br/>「待たせてもらっていました」<br/>「そんな、二時間以上も、じゃないですか……。電話をかけたときにでも帰って来いって言われれば、わたし、飛んで帰ってきたのに……！」<br/>母が言うのを忘れたのなら、「隆臣君が来ているから帰って来いって言いなさい」とでも父が言ってくれたらよかったのだ。|trans-quote=“Ta……Takaomi……, have you been waiting for me by any chance?”<br/>“I took the liberty of waiting for you.”<br/>“And you waited for more than two hours, no less……. If I’d been told on the phone to come back, I would’ve been flying home……!”<br/>If her mother forgot, her father should’ve at least said, “Takaomi’s here, tell her to get back home.”|script-chapter=ja:●第一章|trans-chapter=●Chapter 1|script-title=ja:蜜月ラビリンス|trans-title=Honeymoon Labyrinth|last=Tamaki|first=Nao|date=24 July 2018|publisher=Reposition}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;“[…] Denwa o kaketa toki ni de mo '''kaette koi tte iwarereba''', watashi, tonde kaette kita no ni……!”<br/>[…]<br/>Haha ga yū no o wasureta no nara, “Takaomi-kun ga kite iru kara '''kaette koi tte iinasai'''” to de mo chichi ga itte kuretara yokatta no da.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">“[…] Denwa o kaketa toki ni de mo <b>kaette koi tte iwarereba</b>, watashi, tonde kaette kita no ni……!”<br>[…]<br>Haha ga yū no o wasureta no nara, “Takaomi-kun ga kite iru kara <b>kaette koi tte iinasai</b>” to de mo chichi ga itte kuretara yokatta no da.</i></span><span style="font-weight: normal" about="#mwt2675" id="mwFys"> (<span title="Japanese-language text"><span lang="ja">「[…]電話をかけたときにでも<b>帰って来いって言われれば</b>、わたし、飛んで帰ってきたのに……！」<br>[…]<br>母が言うのを忘れたのなら、「隆臣君が来ているから<b>帰って来いって言いなさい</b>」とでも父が言ってくれたらよかったのだ。<sup about="#mwt2678" class="mw-ref reference" id="cite_ref-tamaki-2018_445-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;tamaki-2018&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-tamaki-2018-445&quot;}}"><a href="#cite_note-tamaki-2018-445" id="mwFyw"><span class="mw-reflink-text" id="mwFy0"><span class="cite-bracket" id="mwFy4">[</span>421<span class="cite-bracket" id="mwFy8">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwFzA">
<td id="mwFzE">So, a while ago, the steward called the huntsman Yermil and said, ‘Yermil, go to the post office.’</td>
<td id="mwFzI"><span title="Hepburn transliteration" about="#mwt2681" typeof="mw:Transclusion" id="mwFzM" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;それでな、先頃、お邸の番頭が、獵犬番のエルミールを呼んで、『エルミール、驛遞へ'''行つて來う'''。』'''つて言つた'''んだ。<ref>{{#invoke:cite|book|lang=ja|script-quote=ja:それでな、<ruby>先<rp>(</rp><rt>せん</rt><rp>)</rp></ruby><ruby>頃<rp>(</rp><rt>ころ</rt><rp>)</rp></ruby>、お<ruby>邸<rp>(</rp><rt>やしき</rt><rp>)</rp></ruby>の番頭が、<ruby>獵犬<rp>(</rp><rt>いぬ</rt><rp>)</rp></ruby><ruby>番<rp>(</rp><rt>ばん</rt><rp>)</rp></ruby>のエルミールを呼んで、『エルミール、驛遞へ行つて來う。』つて言つたんだ。|quote=Вотъ, на дняхъ зоветъ прикащикъ псаря Ермила: говоритъ, ступай, молъ, Ермилъ, на пошту.|p=225|url=https://dl.ndl.go.jp/pid/1704001/1/117|script-chapter=ja:ビェージンの草原|chapter=Бѣжинъ лугъ.|trans-chapter=Byezhin Prairie|translator-first=Shōzaburō|translator-last=Nakayama|series={{#invoke:lang|lang|ja|世界文學叢書}}|volume=26|script-title=ja:流浪の民　ロシア短篇珠玉集|trans-title=[[The Gypsies (poem)|The Gypsies]]: Gems of Russian Short Stories|title=Цыгане|publisher=Sekai Bungaku Sha|authorlink=Ivan Sergeyevich Turgenev|first=Ivan Sergeyevich|last=Turgenev|date=15 June 1948|location=[[Shimogyō-ku, Kyoto|Shimogyō, Kyoto]]}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Sore de na, senkoro, oyashiki no bantō ga, inuban no Erumīru o yonde, ‘Erumīru, ekitei e '''itte kō'''’ '''tte itta''' n da.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Sore de na, senkoro, oyashiki no bantō ga, inuban no Erumīru o yonde, ‘Erumīru, ekitei e <b>itte kō</b>’ <b>tte itta</b> n da.</i></span><span style="font-weight: normal" about="#mwt2681" id="mwFzQ"> (<span title="Japanese-language text"><span lang="ja">それでな、先頃、お邸の番頭が、獵犬番のエルミールを呼んで、『エルミール、驛遞へ<b>行つて來う</b>。』<b>つて言つた</b>んだ。<sup about="#mwt2684" class="mw-ref reference" id="cite_ref-446" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-446&quot;}}"><a href="#cite_note-446" id="mwFzU"><span class="mw-reflink-text" id="mwFzY"><span class="cite-bracket" id="mwFzc">[</span>422<span class="cite-bracket" id="mwFzg">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwFzk">
<td id="mwFzo">“……Go to the Archbishop? You’re telling me to stab the Archbishop to death?”<br id="mwFzs">“You get stabbed to death!”</td>
<td id="mwFzw"><span title="Hepburn transliteration" about="#mwt2687" typeof="mw:Transclusion" id="mwFz0" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;「……大主教のところに行って？　あたしに大主教を'''刺し殺せっていう'''の？」<br/>「おまえが刺し殺されろ」<ref name=yuzuki-2020>{{#invoke:cite|book|lang=ja|script-quote=ja:「ユーフェ、おまえは大主教のところへ行け。おまえひとりなら、ヤツは雷槌は撃ってこない。俺が聖騎士をひきつける」<br/>「……大主教のところに行って？　あたしに大主教を刺し殺せっていうの？」<br/>「おまえが刺し殺されろ」<br/>「────」|trans-quote=“Euphe, you go to the Archbishop. He won’t fire his Thunder Hammer if it’s only you. I’ll draw the Paladin away.”<br/>“……Go to the Archbishop? You’re telling me to stab the Archbishop to death?”<br/>“You get stabbed to death!”<br/>“────”|script-chapter=ja:第５章 魔女の守護者|trans-chapter=Chapter 5: The Witch’s Guardian|script-title=ja:聖なる魔女と悪魔の騎士|trans-title=The Holy Witch and the Demonic Knight|volume=1|last=Yuzuki|first=Ayaka|date=7 August 2020|publisher=Reposition}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;“……Daishukyō no tokoro ni itte? Atashi ni Daishukyō o '''sashikorose tte yū''' no?”<br/>“Omae ga sashikorosarero”&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">“……Daishukyō no tokoro ni itte? Atashi ni Daishukyō o <b>sashikorose tte yū</b> no?”<br>“Omae ga sashikorosarero”</i></span><span style="font-weight: normal" about="#mwt2687" id="mwFz4"> (<span title="Japanese-language text"><span lang="ja">「……大主教のところに行って？　あたしに大主教を<b>刺し殺せっていう</b>の？」<br>「おまえが刺し殺されろ」<sup about="#mwt2690" class="mw-ref reference" id="cite_ref-yuzuki-2020_447-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;yuzuki-2020&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-yuzuki-2020-447&quot;}}"><a href="#cite_note-yuzuki-2020-447" id="mwFz8"><span class="mw-reflink-text" id="mwF0A"><span class="cite-bracket" id="mwF0E">[</span>423<span class="cite-bracket" id="mwF0I">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwF0M">
<td id="mwF0Q">She was told it was ladylike to be beautiful, so she dressed up.</td>
<td id="mwF0U"><span title="Hepburn transliteration" about="#mwt2693" typeof="mw:Transclusion" id="mwF0Y" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;淑女たるもの、'''美しくあれと言われて'''着飾り。<ref>{{#invoke:cite|book|lang=ja|script-quote=ja:彼女は周囲の大人の言葉を信じていただけだった。<br/><br/>淑女たるもの、美しくあれと言われて着飾り。<br/>貴族たるもの、下民と交わるべからずと言われて下々を見下し。<br/>王子の婚約者たるもの、気高くあれと言われて高慢な態度を取り、最悪な令嬢へと成長してしまったのだ。|url=https://ncode.syosetu.com/n9105ho/10/|script-title=ja:クソゲー悪役令嬢　滅亡ルートしかないクソゲーに転生したけど、絶対生き残ってやる！|script-chapter=ja:お勉強は明日から|publisher={{#invoke:lang|lang|ja|インプレス}} NextPublishing|date=28 October 2022|author=Takaba}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Shukujo taru mono, '''utsukushiku are to iwarete''' kikazari.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Shukujo taru mono, <b>utsukushiku are to iwarete</b> kikazari.</i></span><span style="font-weight: normal" about="#mwt2693" id="mwF0c"> (<span title="Japanese-language text"><span lang="ja">淑女たるもの、<b>美しくあれと言われて</b>着飾り。<sup about="#mwt2696" class="mw-ref reference" id="cite_ref-448" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-448&quot;}}"><a href="#cite_note-448" id="mwF0g"><span class="mw-reflink-text" id="mwF0k"><span class="cite-bracket" id="mwF0o">[</span>424<span class="cite-bracket" id="mwF0s">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td>
<td rowspan="5" id="mwF0w">quoted wish</td></tr>
<tr id="mwF00">
<td id="mwF04">It was a longstanding convention that women must be beautiful.</td>
<td id="mwF08"><span title="Hepburn transliteration" about="#mwt2699" typeof="mw:Transclusion" id="mwF1A" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;女よ、'''美しかれとの'''昔の人の'''しきたり'''であつた。<ref>{{#invoke:cite|book|lang=ja|url=https://dl.ndl.go.jp/pid/1125127/1/46|page=96|script-chapter=ja:タマムシ|script-title=ja:博物志|first=Kōshirō|last=Onchi|authorlink=Kōshirō Onchi|publisher=Genkosha|date=10 June 1942|location=[[Ushigome]], Tokyo}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Onna yo, '''utsukushikare to no''' mukashi no hito no '''shikitari''' de atta.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Onna yo, <b>utsukushikare to no</b> mukashi no hito no <b>shikitari</b> de atta.</i></span><span style="font-weight: normal" about="#mwt2699" id="mwF1E"> (<span title="Japanese-language text"><span lang="ja">女よ、<b>美しかれとの</b>昔の人の<b>しきたり</b>であつた。<sup about="#mwt2702" class="mw-ref reference" id="cite_ref-449" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-449&quot;}}"><a href="#cite_note-449" id="mwF1I"><span class="mw-reflink-text" id="mwF1M"><span class="cite-bracket" id="mwF1Q">[</span>425<span class="cite-bracket" id="mwF1U">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwF1Y">
<td id="mwF1c">The Emperor is the Essence who prays that our land and people be at peace.</td>
<td id="mwF1g"><span title="Hepburn transliteration" about="#mwt2705" typeof="mw:Transclusion" id="mwF1k" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;天皇は、国'''安かれ'''、民'''安かれと祈る'''御存在です。<ref>{{#invoke:cite|web|lang=ja|url=https://www.shugiin.go.jp/internet/itdb_kaigiroku.nsf/html/kaigiroku/000121120230126003.htm|work=The House of Representatives, Japan|authorlink=Nobuyuki Baba|first=Nobuyuki|last=Baba|script-title=ja:第211回国会　本会議　第3号（令和5年1月26日（木曜日））|date=26 January 2023}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Tennō wa, kuni '''yasukare''', tami '''yasukare to inoru''' gosonzai desu.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Tennō wa, kuni <b>yasukare</b>, tami <b>yasukare to inoru</b> gosonzai desu.</i></span><span style="font-weight: normal" about="#mwt2705" id="mwF1o"> (<span title="Japanese-language text"><span lang="ja">天皇は、国<b>安かれ</b>、民<b>安かれと祈る</b>御存在です。<sup about="#mwt2708" class="mw-ref reference" id="cite_ref-450" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-450&quot;}}"><a href="#cite_note-450" id="mwF1s"><span class="mw-reflink-text" id="mwF1w"><span class="cite-bracket" id="mwF10">[</span>426<span class="cite-bracket" id="mwF14">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwF18">
<td id="mwF2A">The only thing to do now is to pray, “O Mr Yamada’s soul, rest in peace.”</td>
<td id="mwF2E"><span title="Hepburn transliteration" about="#mwt2711" typeof="mw:Transclusion" id="mwF2I" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;今はただ、〝山田さんの霊よ'''安かれ'''〟'''と祈る'''のみである。<ref>{{#invoke:cite|book|lang=ja|script-chapter=ja:第47局 山田道美八段戦|trans-chapter=Game 47: Vs [[Yamada Michiyoshi]] 8-dan|script-title=ja:大山康晴名局集|title=Ooyama Yasuharu SHOGI Collection|authorlink=Yasuharu Ōyama|first=Yasuharu|last=Ōyama|date=26 July 2012|publisher=Japan Shogi Association}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Ima wa tada, “Yamada-san no rei yo '''yasukare'''” '''to inoru''' nomi de aru.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Ima wa tada, “Yamada-san no rei yo <b>yasukare</b>” <b>to inoru</b> nomi de aru.</i></span><span style="font-weight: normal" about="#mwt2711" id="mwF2M"> (<span title="Japanese-language text"><span lang="ja">今はただ、〝山田さんの霊よ<b>安かれ</b>〟<b>と祈る</b>のみである。<sup about="#mwt2714" class="mw-ref reference" id="cite_ref-451" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-451&quot;}}"><a href="#cite_note-451" id="mwF2Q"><span class="mw-reflink-text" id="mwF2U"><span class="cite-bracket" id="mwF2Y">[</span>427<span class="cite-bracket" id="mwF2c">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwF2g">
<td id="mwF2k">It also means to wish your partner as well as you would wish yourself.</td>
<td id="mwF2o"><span title="Hepburn transliteration" about="#mwt2717" typeof="mw:Transclusion" id="mwF2s" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;また、自分を'''良かれと思う'''のと同じ大きさで相手を'''良かれと願う'''心である。<ref>{{#invoke:cite|web|lang=ja|script-quote=ja:愛するとは、相手の運命を自分の運命と同じように考えることであり、自分の運命を相手に委ねてしまうこと、つまり自分の凡てを捧げても悔いないと決心することである。また、自分を良かれと思うのと同じ大きさで相手を良かれと願う心である。そして、相手に尽くしたい、喜ばせたいといつも考えている人であるともいえる。|url=https://www.tadano.co.jp/company/logbook/vol_12.html|script-title=ja:Vol.12 主体性と愛と恋|date=1 December 1997|publisher=Tadano}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Mata, jibun o '''yokare to omou''' no to onaji ōkisa de aite o '''yokare to negau''' kokoro de aru.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Mata, jibun o <b>yokare to omou</b> no to onaji ōkisa de aite o <b>yokare to negau</b> kokoro de aru.</i></span><span style="font-weight: normal" about="#mwt2717" id="mwF2w"> (<span title="Japanese-language text"><span lang="ja">また、自分を<b>良かれと思う</b>のと同じ大きさで相手を<b>良かれと願う</b>心である。<sup about="#mwt2720" class="mw-ref reference" id="cite_ref-452" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-452&quot;}}"><a href="#cite_note-452" id="mwF20"><span class="mw-reflink-text" id="mwF24"><span class="cite-bracket" id="mwF28">[</span>428<span class="cite-bracket" id="mwF3A">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
</tbody></table>

</section></section><section data-mw-section-id="21" id="mwF3E" aria-labelledby="Conditional"><div class="mw-heading mw-heading2"><h2 id="Conditional">Conditional</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Japanese_conjugation&amp;action=edit&amp;section=21" title="Edit section: Conditional"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwF3I">There are a few ways to make conditional clauses in Japanese, of which the verbally or adjectivally derived ways (rather than merely attaching conditional particles such as <i id="mwF3M">to</i>) are termed the <b id="mwF3Q">provisional</b>, the <b id="mwF3U">conditional</b>, and historically, the <b id="mwF3Y">hypothetical</b>, all of which include the particle <i id="mwF3c">‑ba</i>, with the conditional more commonly omitting <i id="mwF3g">‑ba</i>. These distinctive terms are proposed by <a rel="mw:WikiLink" href="#CITEREFMartin2004" about="#mwt2723" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwF3k" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;harvcoltxt&quot;,&quot;href&quot;:&quot;./Template:Harvcoltxt&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Martin&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2004&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;552–566&quot;}},&quot;i&quot;:0}}]}">Martin (2004</a><span about="#mwt2723">:552–566)</span><span class="error harv-error" style="display: none; font-size:100%" about="#mwt2723"> harvcoltxt error: no target: CITEREFMartin2004 (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Category:Harv_and_Sfn_template_errors" title="Category:Harv and Sfn template errors">help</a>)</span><link rel="mw:PageProp/Category" href="./Category:Harv_and_Sfn_no-target_errors" about="#mwt2723" id="mwF3o">, although other sources may confuse them in one way or another. Japanese terms include <span title="Hepburn transliteration" about="#mwt2724" typeof="mw:Transclusion" id="mwF3s" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;[[:ja:仮定形|仮定形]]&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;kateikei&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{lit|''hypothetical'' form}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">kateikei</i></span><span style="font-weight: normal" about="#mwt2724" id="mwF3w"> (<span title="Japanese-language text"><span lang="ja"><a rel="mw:WikiLink/Interwiki" href="https://ja.wikipedia.org/wiki/仮定形" title="ja:仮定形" class="extiw">仮定形</a></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <abbr style="font-size:85%" title="literal translation" about="#mwt2725" typeof="mw:ExpandedAttrs" data-mw="{&quot;attribs&quot;:[[{&quot;txt&quot;:&quot;title&quot;},{&quot;html&quot;:&quot;<span typeof=\&quot;mw:Nowiki\&quot; id=\&quot;mwF30\&quot;>literal translation</span>&quot;}]]}">lit.</abbr><span style="white-space: nowrap;"><span typeof="mw:Entity"> </span></span><span class="gloss-quot">'</span><span class="gloss-text"><i>hypothetical</i> form</span><span class="gloss-quot">'</span>)</span> for the modern <i id="mwF34">provisional</i>, <span title="Hepburn transliteration" about="#mwt2726" typeof="mw:Transclusion" id="mwF38" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;[[:ja:已然形|已然形]]&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;izenkei&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{lit|realized form}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">izenkei</i></span><span style="font-weight: normal" about="#mwt2726" id="mwF4A"> (<span title="Japanese-language text"><span lang="ja"><a rel="mw:WikiLink/Interwiki" href="https://ja.wikipedia.org/wiki/已然形" title="ja:已然形" class="extiw">已然形</a></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <abbr style="font-size:85%" title="literal translation" about="#mwt2727" typeof="mw:ExpandedAttrs" data-mw="{&quot;attribs&quot;:[[{&quot;txt&quot;:&quot;title&quot;},{&quot;html&quot;:&quot;<span typeof=\&quot;mw:Nowiki\&quot; id=\&quot;mwF4E\&quot;>literal translation</span>&quot;}]]}">lit.</abbr><span style="white-space: nowrap;"><span typeof="mw:Entity"> </span></span><span class="gloss-quot">'</span><span class="gloss-text">realized form</span><span class="gloss-quot">'</span>)</span> for the historical <i id="mwF4I">provisional</i>, and <span title="Hepburn transliteration" about="#mwt2728" typeof="mw:Transclusion" id="mwF4M" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;[[:ja:未然形|未然形]]&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;mizenkei&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{lit|unrealized form}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">mizenkei</i></span><span style="font-weight: normal" about="#mwt2728" id="mwF4Q"> (<span title="Japanese-language text"><span lang="ja"><a rel="mw:WikiLink/Interwiki" href="https://ja.wikipedia.org/wiki/未然形" title="ja:未然形" class="extiw">未然形</a></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <abbr style="font-size:85%" title="literal translation" about="#mwt2729" typeof="mw:ExpandedAttrs" data-mw="{&quot;attribs&quot;:[[{&quot;txt&quot;:&quot;title&quot;},{&quot;html&quot;:&quot;<span typeof=\&quot;mw:Nowiki\&quot; id=\&quot;mwF4U\&quot;>literal translation</span>&quot;}]]}">lit.</abbr><span style="white-space: nowrap;"><span typeof="mw:Entity"> </span></span><span class="gloss-quot">'</span><span class="gloss-text">unrealized form</span><span class="gloss-quot">'</span>)</span> for the historical <i id="mwF4Y">hypothetical</i>, all of which do not include the particle <i id="mwF4c">‑ba</i>. However, some historical hypotheticals (<i id="mwF4g">mizenkei</i>), such as <i id="mwF4k">nara(ba)</i> and <i id="mwF4o">‑tara(ba)</i>, have assumed the roles of modern provisionals (<i id="mwF4s">kateikei</i>).</p>

<p id="mwF4w">The <b id="mwF40">provisional</b> ends in <i id="mwF44">‑eba</i> and expresses a <i id="mwF48">prerequisite condition</i> as in "provided that P happens, A naturally follows"; and a <i id="mwF5A">consequential condition</i> as in "whenever P happens, A naturally follows." The <b id="mwF5E">conditional</b> ends in <i id="mwF5I">‑tara(ba)</i>/<i id="mwF5M">‑dara(ba)</i><sup about="#mwt2730" class="mw-ref reference" id="cite_ref-453" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;lower-alpha&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-453&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;efn&quot;,&quot;href&quot;:&quot;./Template:Efn&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;In form, the ''mizenkei ‑tara''/''‑dara'' of the [[Japanese conjugation (ren'yōkei base)#Perfective|past]] endings ''‑ta''/''‑da''.&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-453" data-mw-group="lower-alpha" id="mwF5Q"><span class="mw-reflink-text" id="mwF5U"><span class="cite-bracket" id="mwF5Y">[</span>y<span class="cite-bracket" id="mwF5c">]</span></span></a></sup> and expresses a <i id="mwF5g">contingent condition</i> as in "if perchance P happens/happened, A has an opportunity to happen"; a <i id="mwF5k">temporal condition</i> as in "when P happens/happened, A happens/happened;" and a consequential condition. Historically, the provisional could also express a <i id="mwF5o">past temporal condition</i> ("when P happened"), and a <i id="mwF5s">causal condition</i> ("because P happens/happened") which is now expressed with the particle <i id="mwF5w">kara</i>.<sup about="#mwt2733" class="mw-ref reference" id="cite_ref-FOOTNOTEMartin2004553–554,_564_454-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMartin2004553–554, 564&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMartin2004553–554,_564-454&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Martin&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2004&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;553–554, 564&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMartin2004553–554,_564-454" id="mwF50"><span class="mw-reflink-text" id="mwF54"><span class="cite-bracket" id="mwF58">[</span>429<span class="cite-bracket" id="mwF6A">]</span></span></a></sup> While the <i id="mwF6E">‑eba</i> provisional used to have a past temporal meaning ("when"), currently only the <i id="mwF6I">‑tara(ba)</i>/<i id="mwF6M">‑dara(ba)</i> conditional can express any temporal meaning, past or future. However, the interpretation of a future <i id="mwF6Q">‑tara(ba)</i>/<i id="mwF6U">‑dara(ba)</i> condition can be either contingent ("if") or temporal ("when"), depending on the speaker's own conviction of the condition's likelihood: <span title="Hepburn transliteration" about="#mwt2736" typeof="mw:Transclusion" id="mwF6Y" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;今夜主人が'''帰ってきたら'''、訊ねましょう。&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Kon'ya shujin ga '''kaette kitara''', tazunemashō.&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|If/when my husband comes home tonight, I'll ask.}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Kon'ya shujin ga <b>kaette kitara</b>, tazunemashō.</i></span><span style="font-weight: normal" about="#mwt2736" id="mwF6c"> (<span title="Japanese-language text"><span lang="ja">今夜主人が<b>帰ってきたら</b>、訊ねましょう。</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">If/when my husband comes home tonight, I'll ask.</span><span class="gloss-quot">'</span>)</span>.<sup about="#mwt2739" class="mw-ref reference" id="cite_ref-akatsuka-1985_455-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;akatsuka-1985&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-akatsuka-1985-455&quot;}}"><a href="#cite_note-akatsuka-1985-455" id="mwF6g"><span class="mw-reflink-text" id="mwF6k"><span class="cite-bracket" id="mwF6o">[</span>430<span class="cite-bracket" id="mwF6s">]</span></span></a></sup></p>

<p id="mwF6w">Both the provisional and conditional can be translated into English as "if", but the meanings are often different (although in some cases they can be very similar). The provisional <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Conditional_sentence" title="Conditional sentence" id="mwF60">apodosis</a> ("<i id="mwF64">then</i> clause") naturally follows its protasis ("<i id="mwF68">if</i> clause"), and is expected or even desired to follow; while the conditional apodosis can be incidental to its protasis, or possibly be desired not to follow. This discrepancy is why the provisional is often used in advice on what to do, while the conditional in warnings on what not to do. Compare:<sup about="#mwt2742" class="mw-ref reference" id="cite_ref-mcgloin-1976_456-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;mcgloin-1976&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-mcgloin-1976-456&quot;}}"><a href="#cite_note-mcgloin-1976-456" id="mwF7A"><span class="mw-reflink-text" id="mwF7E"><span class="cite-bracket" id="mwF7I">[</span>431<span class="cite-bracket" id="mwF7M">]</span></span></a></sup></p>
<ul id="mwF7Q"><li id="mwF7U">"If you study twenty hours a day, you('ll) go crazy."
<ul id="mwF7Y"><li id="mwF7c">Provisional: <span title="Hepburn transliteration" about="#mwt2743" typeof="mw:Transclusion" id="mwF7g" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;一日に二十時間'''勉強すれば'''気が変になりますよ。&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Ichinichi ni nijū jikan '''benkyō sureba''' ki ga hen ni narimasu yo.&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;It's natural that if you study twenty hours a day, you go crazy. → You ought to study twenty hours a day so you can go crazy&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Ichinichi ni nijū jikan <b>benkyō sureba</b> ki ga hen ni narimasu yo.</i></span><span style="font-weight: normal" about="#mwt2743" id="mwF7k"> (<span title="Japanese-language text"><span lang="ja">一日に二十時間<b>勉強すれば</b>気が変になりますよ。</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; It's natural that if you study twenty hours a day, you go crazy. → You ought to study twenty hours a day so you can go crazy)</span></li>
<li id="mwF7o">Conditional: <span title="Hepburn transliteration" about="#mwt2744" typeof="mw:Transclusion" id="mwF7s" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;一日に二十時間'''勉強したら'''気が変になりますよ。&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Ichinichi ni nijū jikan '''benkyō shitara''' ki ga hen ni narimasu yo.&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;You'd better not study twenty hours a day lest you go crazy.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Ichinichi ni nijū jikan <b>benkyō shitara</b> ki ga hen ni narimasu yo.</i></span><span style="font-weight: normal" about="#mwt2744" id="mwF7w"> (<span title="Japanese-language text"><span lang="ja">一日に二十時間<b>勉強したら</b>気が変になりますよ。</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; You'd better not study twenty hours a day lest you go crazy.)</span></li></ul></li>
<li id="mwF70">"If you drop it, it breaks / it'll break."
<ul id="mwF74"><li id="mwF78">Provisional: <span title="Hepburn transliteration" about="#mwt2745" typeof="mw:Transclusion" id="mwF8A" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''落とせば'''壊れますよ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;'''Otoseba''' kowaremasu yo.&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;It's natural that if you drop it, it breaks. → You ought to drop it so you can break it.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn"><b>Otoseba</b> kowaremasu yo.</i></span><span style="font-weight: normal" about="#mwt2745" id="mwF8E"> (<span title="Japanese-language text"><span lang="ja"><b>落とせば</b>壊れますよ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; It's natural that if you drop it, it breaks. → You ought to drop it so you can break it.)</span></li>
<li id="mwF8I">Conditional: <span title="Hepburn transliteration" about="#mwt2746" typeof="mw:Transclusion" id="mwF8M" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''落としたら'''壊れますよ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;'''Otoshitara''' kowaremasu yo.&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;You'd better not drop it lest you break it.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn"><b>Otoshitara</b> kowaremasu yo.</i></span><span style="font-weight: normal" about="#mwt2746" id="mwF8Q"> (<span title="Japanese-language text"><span lang="ja"><b>落としたら</b>壊れますよ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; You'd better not drop it lest you break it.)</span></li></ul></li></ul>

<p id="mwF8U">In the above examples, the outcomes of the apodoses, namely "going crazy" and "breaking it," are ordinarily undesirable, and thus ordinarily incompatible with the provisional; but it is not implausible for them to be desirable in inordinary contexts, such as in response to someone who intends to go crazy or break it. The desire for the provisional apodosis to obtain may still hold even if neither the provisional nor the conditional reads as a warning:</p>
<ul id="mwF8Y"><li id="mwF8c">"If you don't ask your teacher, you won't know the answer."
<ul id="mwF8g"><li id="mwF8k">Provisional: <span title="Hepburn transliteration" about="#mwt2747" typeof="mw:Transclusion" id="mwF8o" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;先生に'''聞かなければ'''分かりませんよ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Sensei ni '''kikanakereba''' wakarimasen yo.&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;It's natural that if you ask your teacher, you'll know the answer. → You ought to ask your teacher so you know the answer.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Sensei ni <b>kikanakereba</b> wakarimasen yo.</i></span><span style="font-weight: normal" about="#mwt2747" id="mwF8s"> (<span title="Japanese-language text"><span lang="ja">先生に<b>聞かなければ</b>分かりませんよ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; It's natural that if you ask your teacher, you'll know the answer. → You ought to ask your teacher so you know the answer.)</span></li>
<li id="mwF8w">Conditional: <span title="Hepburn transliteration" about="#mwt2748" typeof="mw:Transclusion" id="mwF80" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;先生に'''聞かなかったら'''分かりませんよ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Sensei ni '''kikanakattara''' wakarimasen yo.&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;Once you ask your teacher, you'll know the answer.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Sensei ni <b>kikanakattara</b> wakarimasen yo.</i></span><span style="font-weight: normal" about="#mwt2748" id="mwF84"> (<span title="Japanese-language text"><span lang="ja">先生に<b>聞かなかったら</b>分かりませんよ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; Once you ask your teacher, you'll know the answer.)</span></li></ul></li></ul>

<p id="mwF88">The desirability of the provisional apodosis sets its apart from an apodosis made with the particle <i id="mwF9A">to</i>, which similarly expresses matter-of-fact conditions, only without an insinuation of a desired apodosis:<sup about="#mwt2749" class="mw-ref reference" id="cite_ref-FOOTNOTEIoriTakanashiNakanishiYamada2018220–229_457-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEIoriTakanashiNakanishiYamada2018220–229&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEIoriTakanashiNakanishiYamada2018220–229-457&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Iori&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Takanashi&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;Nakanishi&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Yamada&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;2018&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;220–229&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEIoriTakanashiNakanishiYamada2018220–229-457" id="mwF9E"><span class="mw-reflink-text" id="mwF9I"><span class="cite-bracket" id="mwF9M">[</span>432<span class="cite-bracket" id="mwF9Q">]</span></span></a></sup></p>
<ul id="mwF9U"><li id="mwF9Y">"If you press this button, you can buy commutation tickets."
<ul id="mwF9c"><li id="mwF9g">Provisional: <span title="Hepburn transliteration" about="#mwt2752" typeof="mw:Transclusion" id="mwF9k" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;このボタンを'''押せば'''、回数券が買えます。&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Kono botan o '''oseba''', kaisūken ga kaemasu.&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;How can you buy commutation tickets? By pressing this button.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Kono botan o <b>oseba</b>, kaisūken ga kaemasu.</i></span><span style="font-weight: normal" about="#mwt2752" id="mwF9o"> (<span title="Japanese-language text"><span lang="ja">このボタンを<b>押せば</b>、回数券が買えます。</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; How can you buy commutation tickets? By pressing this button.)</span></li>
<li id="mwF9s">With <i id="mwF9w">to</i>: <span title="Hepburn transliteration" about="#mwt2753" typeof="mw:Transclusion" id="mwF90" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;このボタンを'''押すと'''、回数券が買えます。&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Kono botan o '''osu to''', kaisūken ga kaemasu.&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;Here's how this ticket machine works: if you press this button, it's possible to buy commutation tickets.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Kono botan o <b>osu to</b>, kaisūken ga kaemasu.</i></span><span style="font-weight: normal" about="#mwt2753" id="mwF94"> (<span title="Japanese-language text"><span lang="ja">このボタンを<b>押すと</b>、回数券が買えます。</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; Here's how this ticket machine works: if you press this button, it's possible to buy commutation tickets.)</span></li></ul></li></ul>

<p id="mwF98">The conditional also allows room for doubt, or even counterfactuality, as in "if P had happened, A would have happened", and therefore is often followed by tentative statements in the past tense: <span title="Hepburn transliteration" about="#mwt2754" typeof="mw:Transclusion" id="mwF-A" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;その本を'''読んだら'''分かったろう&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Sono hon o '''yondara''' wakatta 'rō&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{xlat|If I had read this book, I would have understood}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Sono hon o <b>yondara</b> wakatta 'rō</i></span><span style="font-weight: normal" about="#mwt2754" id="mwF-E"> (<span title="Japanese-language text"><span lang="ja">その本を<b>読んだら</b>分かったろう</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <abbr title="translation" about="#mwt2755" typeof="mw:ExpandedAttrs" data-mw="{&quot;attribs&quot;:[[{&quot;txt&quot;:&quot;title&quot;},{&quot;html&quot;:&quot;<span typeof=\&quot;mw:Nowiki\&quot; id=\&quot;mwF-I\&quot;>translation</span>&quot;}]]}">transl.</abbr><span><span typeof="mw:Entity"> </span>If I had read this book, I would have understood</span>)</span>. Without tentativity, the conditional would rather mean "when P happened, A happened": <span title="Hepburn transliteration" about="#mwt2756" typeof="mw:Transclusion" id="mwF-M" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;その本を'''読んだら'''分かった&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Sono hon o '''yondara''' wakatta&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{xlat|When I read this book, I understood}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Sono hon o <b>yondara</b> wakatta</i></span><span style="font-weight: normal" about="#mwt2756" id="mwF-Q"> (<span title="Japanese-language text"><span lang="ja">その本を<b>読んだら</b>分かった</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <abbr title="translation" about="#mwt2757" typeof="mw:ExpandedAttrs" data-mw="{&quot;attribs&quot;:[[{&quot;txt&quot;:&quot;title&quot;},{&quot;html&quot;:&quot;<span typeof=\&quot;mw:Nowiki\&quot; id=\&quot;mwF-U\&quot;>translation</span>&quot;}]]}">transl.</abbr><span><span typeof="mw:Entity"> </span>When I read this book, I understood</span>)</span>.<sup about="#mwt2758" class="mw-ref reference" id="cite_ref-FOOTNOTEMartin2004564–565_458-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMartin2004564–565&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMartin2004564–565-458&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Martin&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2004&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;564–565&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMartin2004564–565-458" id="mwF-Y"><span class="mw-reflink-text" id="mwF-c"><span class="cite-bracket" id="mwF-g">[</span>433<span class="cite-bracket" id="mwF-k">]</span></span></a></sup> The provisional can also be used for counterfactuality in the past tense: <span title="Hepburn transliteration" about="#mwt2761" typeof="mw:Transclusion" id="mwF-o" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;シートベルトを'''していれば'''、助かった。&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Shītoberuto o '''shite ireba''', tasukatta.&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{xlat|If he'd been wearing a seatbelt, he would've lived.}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Shītoberuto o <b>shite ireba</b>, tasukatta.</i></span><span style="font-weight: normal" about="#mwt2761" id="mwF-s"> (<span title="Japanese-language text"><span lang="ja">シートベルトを<b>していれば</b>、助かった。</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <abbr title="translation" about="#mwt2762" typeof="mw:ExpandedAttrs" data-mw="{&quot;attribs&quot;:[[{&quot;txt&quot;:&quot;title&quot;},{&quot;html&quot;:&quot;<span typeof=\&quot;mw:Nowiki\&quot; id=\&quot;mwF-w\&quot;>translation</span>&quot;}]]}">transl.</abbr><span><span typeof="mw:Entity"> </span>If he'd been wearing a seatbelt, he would've lived.</span>)</span>.<sup about="#mwt2763" class="mw-ref reference" id="cite_ref-FOOTNOTEKaiserIchikawaKobayashiYamamoto2013571_459-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEKaiserIchikawaKobayashiYamamoto2013571&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEKaiserIchikawaKobayashiYamamoto2013571-459&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Kaiser&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Ichikawa&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;Kobayashi&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Yamamoto&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;2013&quot;},&quot;p&quot;:{&quot;wt&quot;:&quot;571&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEKaiserIchikawaKobayashiYamamoto2013571-459" id="mwF-0"><span class="mw-reflink-text" id="mwF-4"><span class="cite-bracket" id="mwF-8">[</span>434<span class="cite-bracket" id="mwF_A">]</span></span></a></sup></p>

<p id="mwF_E"><i id="mwF_I">Nara(ba)</i> is historically the hypothetical of the copula <i id="mwF_M">nari</i>, but now used as the provisional of <i id="mwF_Q">de aru</i> → <i id="mwF_U">da</i>, which additionally has <i id="mwF_Y">de areba</i>. When split by particles (<i id="mwF_c">wa</i>, <i id="mwF_g">mo</i>, etc), the modern <i id="mwF_k">de wa areba</i> (← <i id="mwF_o">de areba</i>) is normally used instead of the historical <i id="mwF_s">ni wa araba</i> (← <i id="mwF_w">naraba</i>).<sup about="#mwt2766" class="mw-ref reference" id="cite_ref-FOOTNOTEMartin2004554_460-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMartin2004554&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMartin2004554-460&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Martin&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2004&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;554&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMartin2004554-460" id="mwF_0"><span class="mw-reflink-text" id="mwF_4"><span class="cite-bracket" id="mwF_8">[</span>435<span class="cite-bracket" id="mwGAA">]</span></span></a></sup> The copular <i id="mwGAE">nara(ba)</i>, spelt <span title="Japanese-language text" about="#mwt2769" typeof="mw:Transclusion" id="mwGAI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;なら(ば)&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">なら(ば)</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt2769" id="mwGAM">, is not to be confused with <span title="Hepburn transliteration" about="#mwt2770" typeof="mw:Transclusion" id="mwGAQ" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;成らば&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;naraba&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|if possible}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">naraba</i></span><span style="font-weight: normal" about="#mwt2770" id="mwGAU"> (<span title="Japanese-language text"><span lang="ja">成らば</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">if possible</span><span class="gloss-quot">'</span>)</span>, also spelt in kana as <span title="Japanese-language text" about="#mwt2771" typeof="mw:Transclusion" id="mwGAY" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;ならば&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">ならば</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt2771" id="mwGAc">. <i id="mwGAg">Nara(ba)</i> is used when the speaker has found evidence to suppose that the protasis likely obtains:<sup about="#mwt2772" class="mw-ref reference" id="cite_ref-mcgloin-1976_456-1" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;mcgloin-1976&quot;}}"><a href="#cite_note-mcgloin-1976-456" id="mwGAk"><span class="mw-reflink-text" id="mwGAo"><span class="cite-bracket" id="mwGAs">[</span>431<span class="cite-bracket" id="mwGAw">]</span></span></a></sup></p>
<ul id="mwGA0"><li id="mwGA4"><span title="Hepburn transliteration" about="#mwt2773" typeof="mw:Transclusion" id="mwGA8" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;ああ、そう。雨が降っている'''なら'''、タクシーで帰るよ。&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Ā, sō. Ame ga futte iru '''nara''', takushī de kaeru yo.&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;Is that so? If it's raining [as you say], I'll go back by taxi.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Ā, sō. Ame ga futte iru <b>nara</b>, takushī de kaeru yo.</i></span><span style="font-weight: normal" about="#mwt2773" id="mwGBA"> (<span title="Japanese-language text"><span lang="ja">ああ、そう。雨が降っている<b>なら</b>、タクシーで帰るよ。</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; Is that so? If it's raining [as you say], I'll go back by taxi.)</span></li>
<li id="mwGBE"><span title="Hepburn transliteration" about="#mwt2774" typeof="mw:Transclusion" id="mwGBI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;大木さんも来ているようですね。大木さんが来ている'''なら'''、私は帰ります。&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Ōki-san mo kite iru yō desu ne. Ōki-san ga kite iru '''nara''', watashi wa kaerimasu.&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;It looks like Ōki’s here too [given that his shoes are here]. If he's here [as I can see], I'll go home.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Ōki-san mo kite iru yō desu ne. Ōki-san ga kite iru <b>nara</b>, watashi wa kaerimasu.</i></span><span style="font-weight: normal" about="#mwt2774" id="mwGBM"> (<span title="Japanese-language text"><span lang="ja">大木さんも来ているようですね。大木さんが来ている<b>なら</b>、私は帰ります。</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; It looks like Ōki’s here too [given that his shoes are here]. If he's here [as I can see], I'll go home.)</span></li></ul>

<table class="wikitable" id="mwGBQ">
<caption style="text-align:left" id="mwGBU">Conditional form example sentences</caption>
<tbody id="mwGBY"><tr id="mwGBc">
<th id="mwGBg">English</th>
<th id="mwGBk">Japanese</th>
<th id="mwGBo">Function</th></tr>
<tr id="mwGBs">
<td id="mwGBw">If my son succeeds, he shall be a great figure whose like is rarely seen, but even if he fails, he shall not be accountable to the land.</td>
<td id="mwGB0"><span title="Hepburn transliteration" about="#mwt2775" typeof="mw:Transclusion" id="mwGB4" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;わたしの息子が首尾よく'''行けば'''、稀に見る偉大な人物となるであろうし、たとえ不首尾であっても、国土に対して責任はない。<ref>{{#invoke:cite|book|lang=ja|script-quote=ja:わたしの息子が首尾よく行けば（23）、稀に見る偉大な人物となるであろうし、たとえ不首尾であっても、<ruby>国土<rp>(</rp><rt>くに</rt><rp>)</rp></ruby>に対して責任はない。|script-chapter=ja:ペルシア人|trans-chapter=[[The Persians]]|chapter=Πέρσαι|script-title=ja:ギリシア悲劇全集|trans-title=The Complete Collection of Greek Tragedies|author=[[Aeschylus]]|translator-first=Keijirō|translator-last=Uchiyama|date=20 May 2016|publisher=Gutenberg21|location=[[Setagaya]], Tokyo}}</ref>&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Watashi no musuko ga shubi yoku '''ikeba''', mare ni miru idai na jinbutsu to naru de arō shi, tatoe fushubi de atte mo, kuni ni taishite sekinin wa nai.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Watashi no musuko ga shubi yoku <b>ikeba</b>, mare ni miru idai na jinbutsu to naru de arō shi, tatoe fushubi de atte mo, kuni ni taishite sekinin wa nai.</i></span><span style="font-weight: normal" about="#mwt2775" id="mwGB8"> (<span title="Japanese-language text"><span lang="ja">わたしの息子が首尾よく<b>行けば</b>、稀に見る偉大な人物となるであろうし、たとえ不首尾であっても、国土に対して責任はない。<sup about="#mwt2778" class="mw-ref reference" id="cite_ref-461" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-461&quot;}}"><a href="#cite_note-461" id="mwGCA"><span class="mw-reflink-text" id="mwGCE"><span class="cite-bracket" id="mwGCI">[</span>436<span class="cite-bracket" id="mwGCM">]</span></span></a></sup></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td>
<td rowspan="7" id="mwGCQ">prerequisite condition ("provided that it happens / doesn't happen", "unless it happens")</td></tr>
<tr id="mwGCU">
<td id="mwGCY">If you practice, you'll get better.</td>
<td id="mwGCc"><span title="Hepburn transliteration" about="#mwt2781" typeof="mw:Transclusion" id="mwGCg" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''練習すれば'''上達する&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;'''Renshū sureba''' jōtatsu suru&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn"><b>Renshū sureba</b> jōtatsu suru</i></span><span style="font-weight: normal" about="#mwt2781" id="mwGCk"> (<span title="Japanese-language text"><span lang="ja"><b>練習すれば</b>上達する</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGCo">
<td id="mwGCs">If you wanna laugh, go ahead and laugh.</td>
<td id="mwGCw"><span title="Hepburn transliteration" about="#mwt2782" typeof="mw:Transclusion" id="mwGC0" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''笑いたければ'''笑え&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;'''Waraitakereba''' warae&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn"><b>Waraitakereba</b> warae</i></span><span style="font-weight: normal" about="#mwt2782" id="mwGC4"> (<span title="Japanese-language text"><span lang="ja"><b>笑いたければ</b>笑え</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGC8">
<td id="mwGDA">If it rains, the sports festival will be postponed.</td>
<td id="mwGDE"><span title="Hepburn transliteration" about="#mwt2783" typeof="mw:Transclusion" id="mwGDI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;雨天'''ならば'''運動会は延期だ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Uten '''naraba''' undōkai wa enki da&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Uten <b>naraba</b> undōkai wa enki da</i></span><span style="font-weight: normal" about="#mwt2783" id="mwGDM"> (<span title="Japanese-language text"><span lang="ja">雨天<b>ならば</b>運動会は延期だ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGDQ">
<td id="mwGDU">I'd be delighted if this book proved helpful to those intending to join a caring profession.</td>
<td id="mwGDY"><span title="Hepburn transliteration" about="#mwt2784" typeof="mw:Transclusion" id="mwGDc" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;本書が介護職を志す人々の一助と'''なるならば'''幸いである&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Honsho ga kaigoshoku o kokorozasu hitobito no ichijo to '''naru naraba''' saiwai de aru&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Honsho ga kaigoshoku o kokorozasu hitobito no ichijo to <b>naru naraba</b> saiwai de aru</i></span><span style="font-weight: normal" about="#mwt2784" id="mwGDg"> (<span title="Japanese-language text"><span lang="ja">本書が介護職を志す人々の一助と<b>なるならば</b>幸いである</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGDk">
<td id="mwGDo">If you give the money at all, give it all willingly.</td>
<td id="mwGDs"><span title="Hepburn transliteration" about="#mwt2785" typeof="mw:Transclusion" id="mwGDw" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;どうせ金を'''出すなら'''きれいに出せ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Dōse kane o '''dasu nara''' kirei ni dase&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Dōse kane o <b>dasu nara</b> kirei ni dase</i></span><span style="font-weight: normal" about="#mwt2785" id="mwGD0"> (<span title="Japanese-language text"><span lang="ja">どうせ金を<b>出すなら</b>きれいに出せ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGD4">
<td id="mwGD8">The nastier criticism is, the more readers lap it up.</td>
<td id="mwGEA"><span title="Hepburn transliteration" about="#mwt2786" typeof="mw:Transclusion" id="mwGEE" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;批評は辛辣'''であれば'''あるほど読者受けする&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Hihyō wa shinratsu '''de areba''' aru hodo dokusha uke suru&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Hihyō wa shinratsu <b>de areba</b> aru hodo dokusha uke suru</i></span><span style="font-weight: normal" about="#mwt2786" id="mwGEI"> (<span title="Japanese-language text"><span lang="ja">批評は辛辣<b>であれば</b>あるほど読者受けする</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGEM">
<td id="mwGEQ">Many a little makes a mickle.<sup about="#mwt2787" class="mw-ref reference" id="cite_ref-462" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;lower-alpha&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-462&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;efn&quot;,&quot;href&quot;:&quot;./Template:Efn&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Whenever piled up, even dust becomes mountains.&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-462" data-mw-group="lower-alpha" id="mwGEU"><span class="mw-reflink-text" id="mwGEY"><span class="cite-bracket" id="mwGEc">[</span>z<span class="cite-bracket" id="mwGEg">]</span></span></a></sup></td>
<td id="mwGEk"><span title="Hepburn transliteration" about="#mwt2790" typeof="mw:Transclusion" id="mwGEo" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;塵も'''積もれば'''山となる&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Chiri mo '''tsumoreba''' yama to naru&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Chiri mo <b>tsumoreba</b> yama to naru</i></span><span style="font-weight: normal" about="#mwt2790" id="mwGEs"> (<span title="Japanese-language text"><span lang="ja">塵も<b>積もれば</b>山となる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td>
<td rowspan="4" id="mwGEw">consequential condition ("whenever/every time it happens / doesn't happen")</td></tr>
<tr id="mwGE0">
<td id="mwGE4">2 times 2 is 4.<sup about="#mwt2791" class="mw-ref reference" id="cite_ref-463" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;lower-alpha&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-463&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;efn&quot;,&quot;href&quot;:&quot;./Template:Efn&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Whenever you multiply 2 by 2, it becomes 4.&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-463" data-mw-group="lower-alpha" id="mwGE8"><span class="mw-reflink-text" id="mwGFA"><span class="cite-bracket" id="mwGFE">[</span>aa<span class="cite-bracket" id="mwGFI">]</span></span></a></sup></td>
<td id="mwGFM"><span title="Hepburn transliteration" about="#mwt2794" typeof="mw:Transclusion" id="mwGFQ" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;２に２を'''掛ければ'''４になる&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Ni ni ni o '''kakereba''' yon ni naru&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Ni ni ni o <b>kakereba</b> yon ni naru</i></span><span style="font-weight: normal" about="#mwt2794" id="mwGFU"> (<span title="Japanese-language text"><span lang="ja">２に２を<b>掛ければ</b>４になる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGFY">
<td id="mwGFc">Clicking on the linked items brings up relevant pages.<sup about="#mwt2795" class="mw-ref reference" id="cite_ref-464" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;lower-alpha&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-464&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;efn&quot;,&quot;href&quot;:&quot;./Template:Efn&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Whenever you click on the linked items, relevant pages are displayed.&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-464" data-mw-group="lower-alpha" id="mwGFg"><span class="mw-reflink-text" id="mwGFk"><span class="cite-bracket" id="mwGFo">[</span>ab<span class="cite-bracket" id="mwGFs">]</span></span></a></sup></td>
<td id="mwGFw"><span title="Hepburn transliteration" about="#mwt2798" typeof="mw:Transclusion" id="mwGF0" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;リンク項目を'''クリックすれば'''、関連ページが表示される&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Rinku kōmoku o '''kurikku sureba''', kanren pēji ga hyōji sareru&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Rinku kōmoku o <b>kurikku sureba</b>, kanren pēji ga hyōji sareru</i></span><span style="font-weight: normal" about="#mwt2798" id="mwGF4"> (<span title="Japanese-language text"><span lang="ja">リンク項目を<b>クリックすれば</b>、関連ページが表示される</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGF8">
<td id="mwGGA">There's <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Safety_in_numbers" title="Safety in numbers" id="mwGGE">safety in numbers</a>.<sup about="#mwt2799" class="mw-ref reference" id="cite_ref-465" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;lower-alpha&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-465&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;efn&quot;,&quot;href&quot;:&quot;./Template:Efn&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Whenever there are many people, it's reassuring.&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-465" data-mw-group="lower-alpha" id="mwGGI"><span class="mw-reflink-text" id="mwGGM"><span class="cite-bracket" id="mwGGQ">[</span>ac<span class="cite-bracket" id="mwGGU">]</span></span></a></sup></td>
<td id="mwGGY"><span title="Hepburn transliteration" about="#mwt2802" typeof="mw:Transclusion" id="mwGGc" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;人数が'''多ければ'''安心だ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Ninzū ga '''ōkereba''' anshin da&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Ninzū ga <b>ōkereba</b> anshin da</i></span><span style="font-weight: normal" about="#mwt2802" id="mwGGg"> (<span title="Japanese-language text"><span lang="ja">人数が<b>多ければ</b>安心だ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGGk">
<td id="mwGGo">If you happen to see him, tell him to come and see me.</td>
<td id="mwGGs"><span title="Hepburn transliteration" about="#mwt2803" typeof="mw:Transclusion" id="mwGGw" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;もし彼に'''会ったら'''来るように言ってください&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Moshi kare ni '''attara''' kuru yō ni itte kudasai&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Moshi kare ni <b>attara</b> kuru yō ni itte kudasai</i></span><span style="font-weight: normal" about="#mwt2803" id="mwGG0"> (<span title="Japanese-language text"><span lang="ja">もし彼に<b>会ったら</b>来るように言ってください</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td>
<td rowspan="3" id="mwGG4">contingent condition ("if perchance it happens/had happened / doesn't/hadn't happen")</td></tr>
<tr id="mwGG8">
<td id="mwGHA">If I say it's white, it's white.</td>
<td id="mwGHE"><span title="Hepburn transliteration" about="#mwt2804" typeof="mw:Transclusion" id="mwGHI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;俺が白だと'''言ったら'''白なんだ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Ore ga shiro da to '''ittara''' shiro na n da&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Ore ga shiro da to <b>ittara</b> shiro na n da</i></span><span style="font-weight: normal" about="#mwt2804" id="mwGHM"> (<span title="Japanese-language text"><span lang="ja">俺が白だと<b>言ったら</b>白なんだ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGHQ">
<td id="mwGHU">She's the type that would risk her life for love.<sup about="#mwt2805" class="mw-ref reference" id="cite_ref-466" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;lower-alpha&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-466&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;efn&quot;,&quot;href&quot;:&quot;./Template:Efn&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;She's the type that would risk her life once she falls in love.&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-466" data-mw-group="lower-alpha" id="mwGHY"><span class="mw-reflink-text" id="mwGHc"><span class="cite-bracket" id="mwGHg">[</span>ad<span class="cite-bracket" id="mwGHk">]</span></span></a></sup></td>
<td id="mwGHo"><span title="Hepburn transliteration" about="#mwt2808" typeof="mw:Transclusion" id="mwGHs" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;あの女は'''思い込んだら'''命懸けのタイプだ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Ano onna wa '''omoikondara''' inochigake no taipu da&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Ano onna wa <b>omoikondara</b> inochigake no taipu da</i></span><span style="font-weight: normal" about="#mwt2808" id="mwGHw"> (<span title="Japanese-language text"><span lang="ja">あの女は<b>思い込んだら</b>命懸けのタイプだ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGH0">
<td id="mwGH4">From now on, too, I don’t want to regret things, thinking that I should have done things differently that time.</td>
<td id="mwGH8"><span title="Hepburn transliteration" about="#mwt2809" typeof="mw:Transclusion" id="mwGIA" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;これからも、あのときああ'''すればよかった'''と後悔することはしたくない。&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Kore kara mo, ano toki ā '''sureba yokatta''' to kōkai suru koto wa shitaku nai.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Kore kara mo, ano toki ā <b>sureba yokatta</b> to kōkai suru koto wa shitaku nai.</i></span><span style="font-weight: normal" about="#mwt2809" id="mwGIE"> (<span title="Japanese-language text"><span lang="ja">これからも、あのときああ<b>すればよかった</b>と後悔することはしたくない。</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span><sup about="#mwt2810" class="mw-ref reference" id="cite_ref-FOOTNOTEKaiserIchikawaKobayashiYamamoto2013572_467-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEKaiserIchikawaKobayashiYamamoto2013572&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEKaiserIchikawaKobayashiYamamoto2013572-467&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Kaiser&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Ichikawa&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;Kobayashi&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Yamamoto&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;2013&quot;},&quot;p&quot;:{&quot;wt&quot;:&quot;572&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEKaiserIchikawaKobayashiYamamoto2013572-467" id="mwGII"><span class="mw-reflink-text" id="mwGIM"><span class="cite-bracket" id="mwGIQ">[</span>437<span class="cite-bracket" id="mwGIU">]</span></span></a></sup></td>
<td rowspan="4" id="mwGIY"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Counterfactual_condition" title="Counterfactual condition" class="mw-redirect" id="mwGIc">counterfactual condition</a> ("if it (had) happened / didn't/hadn't happened")</td></tr>
<tr id="mwGIg">
<td id="mwGIk">If it were me, I wouldn't do such thing.</td>
<td id="mwGIo"><span title="Hepburn transliteration" about="#mwt2813" typeof="mw:Transclusion" id="mwGIs" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;私'''だったら'''そんなことはしませんね&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Watashi '''dattara''' sonna koto wa shimasen ne&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Watashi <b>dattara</b> sonna koto wa shimasen ne</i></span><span style="font-weight: normal" about="#mwt2813" id="mwGIw"> (<span title="Japanese-language text"><span lang="ja">私<b>だったら</b>そんなことはしませんね</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGI0">
<td id="mwGI4">It'd be great if this child were a boy.<sup about="#mwt2814" class="mw-ref reference" id="cite_ref-468" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;lower-alpha&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-468&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;efn&quot;,&quot;href&quot;:&quot;./Template:Efn&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Spoken by a parent who has a daughter. If the child's gender is not known yet, for example in the early stage of a pregnancy, this can be translated as \&quot;It'll be great if this child is a boy.\&quot;&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-468" data-mw-group="lower-alpha" id="mwGI8"><span class="mw-reflink-text" id="mwGJA"><span class="cite-bracket" id="mwGJE">[</span>ae<span class="cite-bracket" id="mwGJI">]</span></span></a></sup></td>
<td id="mwGJM"><span title="Hepburn transliteration" about="#mwt2817" typeof="mw:Transclusion" id="mwGJQ" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;この子が男'''だったら'''、いいのになあ！&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Kono ko ga otoko '''dattara''', ii no ni nā.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Kono ko ga otoko <b>dattara</b>, ii no ni nā.</i></span><span style="font-weight: normal" about="#mwt2817" id="mwGJU"> (<span title="Japanese-language text"><span lang="ja">この子が男<b>だったら</b>、いいのになあ！</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span><sup about="#mwt2818" class="mw-ref reference" id="cite_ref-akatsuka-1985_455-1" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;akatsuka-1985&quot;}}"><a href="#cite_note-akatsuka-1985-455" id="mwGJY"><span class="mw-reflink-text" id="mwGJc"><span class="cite-bracket" id="mwGJg">[</span>430<span class="cite-bracket" id="mwGJk">]</span></span></a></sup></td></tr>
<tr id="mwGJo">
<td id="mwGJs">If it'd been him, he wouldn't've made such a blunder.</td>
<td id="mwGJw"><span title="Hepburn transliteration" about="#mwt2819" typeof="mw:Transclusion" id="mwGJ0" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;彼'''なら'''そんなへまはしなかっただろう&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Kare '''nara''' sonna hema wa shinakatta darō&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Kare <b>nara</b> sonna hema wa shinakatta darō</i></span><span style="font-weight: normal" about="#mwt2819" id="mwGJ4"> (<span title="Japanese-language text"><span lang="ja">彼<b>なら</b>そんなへまはしなかっただろう</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGJ8">
<td id="mwGKA">His death will turn his family adrift.<sup about="#mwt2820" class="mw-ref reference" id="cite_ref-469" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;lower-alpha&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-469&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;efn&quot;,&quot;href&quot;:&quot;./Template:Efn&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;If/When he dies, his family will get lost on the wayside.&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-469" data-mw-group="lower-alpha" id="mwGKE"><span class="mw-reflink-text" id="mwGKI"><span class="cite-bracket" id="mwGKM">[</span>af<span class="cite-bracket" id="mwGKQ">]</span></span></a></sup></td>
<td id="mwGKU"><span title="Hepburn transliteration" about="#mwt2823" typeof="mw:Transclusion" id="mwGKY" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;彼が'''死んだら'''一家は路頭に迷うだろう&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Kare ga '''shindara''' ikka wa rotō ni mayou darō&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Kare ga <b>shindara</b> ikka wa rotō ni mayou darō</i></span><span style="font-weight: normal" about="#mwt2823" id="mwGKc"> (<span title="Japanese-language text"><span lang="ja">彼が<b>死んだら</b>一家は路頭に迷うだろう</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td>
<td rowspan="5" id="mwGKg">temporal condition ("when/at the time it happens/happened / doesn't/didn't happen")</td></tr>
<tr id="mwGKk">
<td id="mwGKo">I'll be going as soon as I'm done with this, so wait a little bit, okay?</td>
<td id="mwGKs"><span title="Hepburn transliteration" about="#mwt2824" typeof="mw:Transclusion" id="mwGKw" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;この仕事を'''上げたら'''行くからちょっと待ってて&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Kono shigoto o '''agetara''' iku kara chotto matte 'te&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Kono shigoto o <b>agetara</b> iku kara chotto matte 'te</i></span><span style="font-weight: normal" about="#mwt2824" id="mwGK0"> (<span title="Japanese-language text"><span lang="ja">この仕事を<b>上げたら</b>行くからちょっと待ってて</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGK4">
<td id="mwGK8">The door opened when pushed.</td>
<td id="mwGLA"><span title="Hepburn transliteration" about="#mwt2825" typeof="mw:Transclusion" id="mwGLE" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''押したら'''ドアが開いた&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;'''Oshitara''' doa ga aita&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn"><b>Oshitara</b> doa ga aita</i></span><span style="font-weight: normal" about="#mwt2825" id="mwGLI"> (<span title="Japanese-language text"><span lang="ja"><b>押したら</b>ドアが開いた</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span></td></tr>
<tr id="mwGLM">
<td id="mwGLQ">Once you’ve bought the <i id="mwGLU">Editor</i> book, it comes with a bonus section called “An Inside Look into <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Character_Encoding" title="Character Encoding" class="mw-redirect" id="mwGLY">Character Encoding</a>.”</td>
<td id="mwGLc"><span title="Hepburn transliteration" about="#mwt2826" typeof="mw:Transclusion" id="mwGLg" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;エディタの本を'''買ったらば'''、「文字コード裏話」という読み物がオマケでついてきた。&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Edita no hon o '''kattaraba''', “Moji Kōdo Urabanashi” to yū yomimono ga omake de tsuite kita.&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Edita no hon o <b>kattaraba</b>, “Moji Kōdo Urabanashi” to yū yomimono ga omake de tsuite kita.</i></span><span style="font-weight: normal" about="#mwt2826" id="mwGLk"> (<span title="Japanese-language text"><span lang="ja">エディタの本を<b>買ったらば</b>、「文字コード裏話」という読み物がオマケでついてきた。</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span><sup about="#mwt2829" class="mw-ref reference" id="cite_ref-470" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-470&quot;}}"><a href="#cite_note-470" id="mwGLo"><span class="mw-reflink-text" id="mwGLs"><span class="cite-bracket" id="mwGLw">[</span>438<span class="cite-bracket" id="mwGL0">]</span></span></a></sup></td></tr>
<tr id="mwGL4">
<td id="mwGL8">If I told you the truth that when we die, we’re always reborn in the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Sukhavati" title="Sukhavati" id="mwGMA">Land of Absolute Bliss</a>, would you believe it?</td>
<td id="mwGME"><span title="Hepburn transliteration" about="#mwt2830" typeof="mw:Transclusion" id="mwGMI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;例えば私たちが'''死んだらば'''必ず往生しますという真実をお話ししても皆さんは信じられますか？&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Tatoeba watashitachi ga '''shindaraba''' kanarazu ōjō shimasu to yū shinjitsu o ohanashi shite mo minasan wa shinjiraremasu ka?&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">Tatoeba watashitachi ga <b>shindaraba</b> kanarazu ōjō shimasu to yū shinjitsu o ohanashi shite mo minasan wa shinjiraremasu ka?</i></span><span style="font-weight: normal" about="#mwt2830" id="mwGMM"> (<span title="Japanese-language text"><span lang="ja">例えば私たちが<b>死んだらば</b>必ず往生しますという真実をお話ししても皆さんは信じられますか？</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span><sup about="#mwt2833" class="mw-ref reference" id="cite_ref-471" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-471&quot;}}"><a href="#cite_note-471" id="mwGMQ"><span class="mw-reflink-text" id="mwGMU"><span class="cite-bracket" id="mwGMY">[</span>439<span class="cite-bracket" id="mwGMc">]</span></span></a></sup></td></tr>
</tbody></table>

<section data-mw-section-id="22" id="mwGMg" aria-labelledby="Conditional:_Conjugation_table"><div class="mw-heading mw-heading3"><h3 id="Conditional:_Conjugation_table">Conditional: Conjugation table</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Japanese_conjugation&amp;action=edit&amp;section=22" title="Edit section: Conditional: Conjugation table"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwGMk">The conditional form is created by using the <a rel="mw:WikiLink" href="#kateikei" class="mw-selflink-fragment" id="mwGMo">kateikei base</a>, followed by a conditional particle, usually the hypothetical/provisional <span title="Hepburn transliteration" about="#mwt2834" typeof="mw:Transclusion" id="mwGMs" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;ば&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;ba&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">ba</i></span><span style="font-weight: normal" about="#mwt2834" id="mwGMw"> (<span title="Japanese-language text"><span lang="ja">ば</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span>, and occasionally with the elevated concessive <span title="Hepburn transliteration" about="#mwt2835" typeof="mw:Transclusion" id="mwGM0" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;ど(も)&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;do (mo)&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">do (mo)</i></span><span style="font-weight: normal" about="#mwt2835" id="mwGM4"> (<span title="Japanese-language text"><span lang="ja">ど(も)</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span>.</p>

<p id="mwGM8">The <i id="mwGNA">‑eba</i> ending can be colloquially reduced to <i id="mwGNE">‑ya(a)</i>, where the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_phonology#Lenition" title="Japanese phonology" id="mwGNI">consonant <i id="mwGNM">b</i> is weakened</a> to the point of complete omission, as in <span title="Hepburn transliteration" about="#mwt2836" typeof="mw:Transclusion" id="mwGNQ" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;言えば&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;ieba → *iewa → iya(a)&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|provided that one says}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">ieba → *iewa → iya(a)</i></span><span style="font-weight: normal" about="#mwt2836" id="mwGNU"> (<span title="Japanese-language text"><span lang="ja">言えば</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">provided that one says</span><span class="gloss-quot">'</span>)</span>, <span title="Hepburn transliteration" about="#mwt2837" typeof="mw:Transclusion" id="mwGNY" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;行けば&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;ikeba → *ikewa → ikya(a)&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|provided that one goes}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">ikeba → *ikewa → ikya(a)</i></span><span style="font-weight: normal" about="#mwt2837" id="mwGNc"> (<span title="Japanese-language text"><span lang="ja">行けば</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">provided that one goes</span><span class="gloss-quot">'</span>)</span>, <span title="Hepburn transliteration" about="#mwt2838" typeof="mw:Transclusion" id="mwGNg" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;見れば&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;mireba → *mirewa → mirya(a)&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|provided that one looks}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">mireba → *mirewa → mirya(a)</i></span><span style="font-weight: normal" about="#mwt2838" id="mwGNk"> (<span title="Japanese-language text"><span lang="ja">見れば</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">provided that one looks</span><span class="gloss-quot">'</span>)</span>, etc. In cases like <span title="Hepburn transliteration" about="#mwt2839" typeof="mw:Transclusion" id="mwGNo" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;待てば&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;mateba → *matewa → matya(a)&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|provided that one waits}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">mateba → *matewa → matya(a)</i></span><span style="font-weight: normal" about="#mwt2839" id="mwGNs"> (<span title="Japanese-language text"><span lang="ja">待てば</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">provided that one waits</span><span class="gloss-quot">'</span>)</span>, <span title="Hepburn transliteration" about="#mwt2840" typeof="mw:Transclusion" id="mwGNw" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;話せば&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;hanaseba → *hanasewa → hanasya(a)&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|provided that one speaks}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">hanaseba → *hanasewa → hanasya(a)</i></span><span style="font-weight: normal" about="#mwt2840" id="mwGN0"> (<span title="Japanese-language text"><span lang="ja">話せば</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">provided that one speaks</span><span class="gloss-quot">'</span>)</span>, etc, the consonants <i id="mwGN4">ty</i> and <i id="mwGN8">sy</i> may be used rather than <i id="mwGOA">ch</i> and <i id="mwGOE">sh</i>.<sup about="#mwt2850" class="mw-ref reference" id="cite_ref-472" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-472&quot;}}"><a href="#cite_note-472" id="mwGOI"><span class="mw-reflink-text" id="mwGOM"><span class="cite-bracket" id="mwGOQ">[</span>440<span class="cite-bracket" id="mwGOU">]</span></span></a></sup> The adjectival ending <i id="mwGOY">‑kereba</i> → <i id="mwGOc">‑kerya(a)</i> in particular can be further reduced to <i id="mwGOg">‑kya(a)</i>, as in <span title="Hepburn transliteration" about="#mwt2841" typeof="mw:Transclusion" id="mwGOk" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;赤ければ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;akakereba → *akakerewa → akakerya(a) → akakya(a)&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{gloss|provided that one's red}}&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">akakereba → *akakerewa → akakerya(a) → akakya(a)</i></span><span style="font-weight: normal" about="#mwt2841" id="mwGOo"> (<span title="Japanese-language text"><span lang="ja">赤ければ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; <span class="gloss-quot">'</span><span class="gloss-text">provided that one's red</span><span class="gloss-quot">'</span>)</span>. In western dialects where <i id="mwGOs">‑n</i> is used instead of <i id="mwGOw">‑nai</i>, there are <i id="mwGO0">‑nkerya(a)</i> and <i id="mwGO4">‑nkya(a)</i> (from <i id="mwGO8">‑nkereba</i>), and <i id="mwGPA">‑nya(a)</i> (from <i id="mwGPE">‑neba</i>).<sup about="#mwt2842" class="mw-ref reference" id="cite_ref-FOOTNOTEMartin2004372,_555–564_473-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMartin2004372, 555–564&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMartin2004372,_555–564-473&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Martin&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2004&quot;},&quot;p&quot;:{&quot;wt&quot;:&quot;372, 555–564&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMartin2004372,_555–564-473" id="mwGPI"><span class="mw-reflink-text" id="mwGPM"><span class="cite-bracket" id="mwGPQ">[</span>441<span class="cite-bracket" id="mwGPU">]</span></span></a></sup> These colloquial reductions are analogous to how <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_conjugation_(ren'yōkei_base)#Gerund" title="Japanese conjugation (ren'yōkei base)" id="mwGPY"><i id="mwGPc">‑te wa/‑de wa</i> are reduced to <i id="mwGPg">‑tya(a)/‑dya(a)</i>, <i id="mwGPk">‑te aru/‑de aru/‑te yaru/‑de yaru</i> to <i id="mwGPo">‑ty(a)aru/‑dy(a)aru</i></a>, <a rel="mw:WikiLink" href="#Copula:_Conjugation_table" class="mw-selflink-fragment" id="mwGPs"><i id="mwGPw">de wa</i> to <i id="mwGP0">dya(a)</i> to <i id="mwGP4">ja(a)</i>, and <i id="mwGP8">de atte</i> to <i id="mwGQA">dy(a)atte</i> to <i id="mwGQE">j(a)atte</i></a>, etc, although some of these reductions may be more dialectal than the others.<sup about="#mwt2845" class="mw-ref reference" id="cite_ref-FOOTNOTEMartin2004167–172,_523–524_474-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMartin2004167–172, 523–524&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMartin2004167–172,_523–524-474&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Martin&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2004&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;167–172, 523–524&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMartin2004167–172,_523–524-474" id="mwGQI"><span class="mw-reflink-text" id="mwGQM"><span class="cite-bracket" id="mwGQQ">[</span>442<span class="cite-bracket" id="mwGQU">]</span></span></a></sup></p>

<p id="mwGQY">As is the case of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_conjugation_(imperfective_form)#Conjugation_table" title="Japanese conjugation (imperfective form)" id="mwGQc">conclusives and attributives</a> of <i id="mwGQg">nidan</i> verbs, <i id="mwGQk">shinu</i> and <i id="mwGQo">deku</i>, their provisionals have been used in modern literature for literary flair before the 21st century, although currently their modern <i id="mwGQs">ichidan</i> and <i id="mwGQw">godan</i> counterparts are preferred.</p>

<p id="mwGQ0">The polite auxiliary <i id="mwGQ4">‑masu</i> has two options, the provisional <i id="mwGQ8">‑masureba</i>, and the morphologically hypothetical yet semantically provisional <i id="mwGRA">‑maseba</i>.<sup about="#mwt2851" class="mw-ref reference" id="cite_ref-FOOTNOTEAkimotoAkimotoIshikawaItoi2001745–747_475-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEAkimotoAkimotoIshikawaItoi2001745–747&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEAkimotoAkimotoIshikawaItoi2001745–747-475&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Akimoto&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Akimoto&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;Ishikawa&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Itoi&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;2001&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;745–747&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEAkimotoAkimotoIshikawaItoi2001745–747-475" id="mwGRE"><span class="mw-reflink-text" id="mwGRI"><span class="cite-bracket" id="mwGRM">[</span>443<span class="cite-bracket" id="mwGRQ">]</span></span></a></sup> <i id="mwGRU">‑Masureba</i> has been said to be uncommon, while <i id="mwGRY">‑maseba</i> has been said to be nonstandard.<sup about="#mwt2854" class="mw-ref reference" id="cite_ref-FOOTNOTEMartin2004557_476-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMartin2004557&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMartin2004557-476&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Martin&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2004&quot;},&quot;p&quot;:{&quot;wt&quot;:&quot;557&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMartin2004557-476" id="mwGRc"><span class="mw-reflink-text" id="mwGRg"><span class="cite-bracket" id="mwGRk">[</span>444<span class="cite-bracket" id="mwGRo">]</span></span></a></sup></p>

<table class="wikitable" id="mwGRs">
<tbody id="mwGRw"><tr id="mwGR0">
<th id="mwGR4">Dictionary form</th>
<th colspan="3" id="mwGR8">Pattern <sup about="#mwt2857" class="mw-ref reference" id="cite_ref-FOOTNOTEMakinoTsutsui2018576–579&quot;Appendix_1_Basic_Conjugations&quot;_(Verbs)_2-4" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMakinoTsutsui2018576–579\&quot;Appendix 1 Basic Conjugations\&quot; (Verbs)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMakinoTsutsui2018576–579\&quot;Appendix_1_Basic_Conjugations\&quot;_(Verbs)-2&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Makino&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Tsutsui&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;2018&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;576–579&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;Appendix 1 Basic Conjugations\&quot; (Verbs)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMakinoTsutsui2018576–579&quot;Appendix_1_Basic_Conjugations&quot;_(Verbs)-2" id="mwGSA"><span class="mw-reflink-text" id="mwGSE"><span class="cite-bracket" id="mwGSI">[</span>2<span class="cite-bracket" id="mwGSM">]</span></span></a></sup></th>
<th id="mwGSQ">Conditional form</th>
<th id="mwGSU">Fast-speech reduction</th></tr>
<tr id="mwGSY">
<th colspan="6" style="text-align:left" id="mwGSc"><i id="mwGSg">Godan</i> and pseudo-<i id="mwGSk">yodan</i> verbs</th></tr>
<tr id="mwGSo">
<td id="mwGSs"><span style="font-weight: normal" about="#mwt2860" typeof="mw:Transclusion" id="mwGSw" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo_krt&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;fasten&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;結う&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yuu/yū&quot;}},&quot;i&quot;:0}}]}"><span title="Japanese-language text"><span lang="ja">結う</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text"> <span style="margin-right:.09em">(</span><span title="Hepburn transliteration"><i lang="ja-Latn">yuu/yū</i></span>, fasten)</span></td>
