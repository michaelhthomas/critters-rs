<th id="mwZA">Ichidan Verb<br id="mwZQ"><span style="font-weight: normal" about="#mwt27" typeof="mw:Transclusion" id="mwZg" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo_krt&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;'''to see'''&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''見る'''&quot;}},&quot;i&quot;:0}}]}"><span title="Japanese-language text"><span lang="ja"><b>見る</b></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text"> (<b>to see</b>)</span></th>
