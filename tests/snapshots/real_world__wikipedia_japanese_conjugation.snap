<td style="text-align:center" id="mwyw"><span title="Japanese-language text" about="#mwt59" typeof="mw:Transclusion" id="mwzA" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;止'''め'''られる&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">止<b>め</b>られる</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt59" id="mwzQ"><br id="mwzg"><span title="Hepburn transliteration" about="#mwt60" typeof="mw:Transclusion" id="mwzw" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;to'''me'''rareru&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">to<b>me</b>rareru</i></span><span style="font-weight: normal" about="#mwt60" id="mw0A"></span></td></tr>
<tr id="mw0Q">
<th id="mw0g">Hortative</th>
<th id="mw0w"><span style="font-weight: normal" about="#mwt61" typeof="mw:Transclusion" id="mw1A" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo_krt&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''も'''&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;'''mo'''&quot;}},&quot;i&quot;:0}}]}"><span title="Japanese-language text"><span lang="ja"><b>も</b></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text"> (<span title="Hepburn transliteration"><i lang="ja-Latn"><b>mo</b></i></span>)</span></th>
<td id="mw1Q"><span title="Japanese-language text" about="#mwt62" typeof="mw:Transclusion" id="mw1g" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;読'''も'''う&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">読<b>も</b>う</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt62" id="mw1w"><br id="mw2A"><span title="Hepburn transliteration" about="#mwt63" typeof="mw:Transclusion" id="mw2Q" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yo'''mō'''&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">yo<b>mō</b></i></span><span style="font-weight: normal" about="#mwt63" id="mw2g"></span></td>
<th id="mw2w">Hortative</th>
<td style="text-align:center" id="mw3A"><span title="Japanese-language text" about="#mwt64" typeof="mw:Transclusion" id="mw3Q" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;'''み'''よう&quot;}},&quot;i&quot;:0}}]}"><span lang="ja"><b>み</b>よう</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt64" id="mw3g"><span style="font-weight:normal" id="mw3w"><sup class="plainlinks nourlexpansion citation" id="mw4A" about="#mwt65" typeof="mw:Transclusion" data-x-id="ref_verbgroups1" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;ref&quot;,&quot;href&quot;:&quot;./Template:Ref&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;verbgroups1&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;*&quot;}},&quot;i&quot;:0}}]}"><a rel="mw:WikiLink" href="#endnote_verbgroups1" class="mw-selflink-fragment">*</a></sup></span><br id="mw4Q"><span title="Hepburn transliteration" about="#mwt66" typeof="mw:Transclusion" id="mw4g" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;'''mi'''yō&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn"><b>mi</b>yō</i></span><span style="font-weight: normal" about="#mwt66" id="mw4w"></span></td>
<td style="text-align:center" id="mw5A"><span title="Japanese-language text" about="#mwt67" typeof="mw:Transclusion" id="mw5Q" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;止'''め'''よう&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">止<b>め</b>よう</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt67" id="mw5g"><br id="mw5w"><span title="Hepburn transliteration" about="#mwt68" typeof="mw:Transclusion" id="mw6A" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;to'''me'''yō&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">to<b>me</b>yō</i></span><span style="font-weight: normal" about="#mwt68" id="mw6Q"></span></td></tr>
</tbody></table>
<dl id="mw6g"><dd id="mw6w"><span class="citation wikicite" id="endnote_verbgroups1" about="#mwt69"><sup>*</sup></span><span about="#mwt69"> </span> <small id="mw7Q">These forms are given here in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Hiragana" title="Hiragana" id="mw7g">hiragana</a> for illustrative purposes; they would normally be written with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Kanji" title="Kanji" id="mw7w">kanji</a> as <span title="Japanese-language text" about="#mwt71" typeof="mw:Transclusion" id="mw8A" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;見ない&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">見ない</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt71" id="mw8Q">, <span title="Japanese-language text" about="#mwt72" typeof="mw:Transclusion" id="mw8g" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:lang&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;lang&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;見ます&quot;}},&quot;i&quot;:0}}]}"><span lang="ja">見ます</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt72" id="mw8w"> etc.</small></dd></dl>

<p id="mw9A">As can be seen above, the godan verb <span title="Hepburn transliteration" about="#mwt73" typeof="mw:Transclusion" id="mw9Q" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo3&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;to read&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;読む&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yomu&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">yomu</i></span><span style="font-weight: normal" about="#mwt73" id="mw9g"> (<span title="Japanese-language text"><span lang="ja">読む</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">, to read)</span> has a static verb stem, <span title="Hepburn transliteration" about="#mwt74" typeof="mw:Transclusion" id="mw9w" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo3&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;読〜&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yo-&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">yo-</i></span><span style="font-weight: normal" about="#mwt74" id="mw-A"> (<span title="Japanese-language text"><span lang="ja">読〜</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span>, and a dynamic conjugational stem which changes depending on the purpose: <span title="Hepburn transliteration" about="#mwt75" typeof="mw:Transclusion" id="mw-Q" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo3&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;読'''ま'''〜&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yo'''ma'''‑&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;row 1&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">yo<b>ma</b>‑</i></span><span style="font-weight: normal" about="#mwt75" id="mw-g"> (<span title="Japanese-language text"><span lang="ja">読<b>ま</b>〜</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; row 1)</span>, <span title="Hepburn transliteration" about="#mwt76" typeof="mw:Transclusion" id="mw-w" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo3&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;読'''み'''〜&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yo'''mi'''‑&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;row 2&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">yo<b>mi</b>‑</i></span><span style="font-weight: normal" about="#mwt76" id="mw_A"> (<span title="Japanese-language text"><span lang="ja">読<b>み</b>〜</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; row 2)</span>, <span title="Hepburn transliteration" about="#mwt77" typeof="mw:Transclusion" id="mw_Q" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo3&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;読'''む'''&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yo'''mu'''&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;row 3&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">yo<b>mu</b></i></span><span style="font-weight: normal" about="#mwt77" id="mw_g"> (<span title="Japanese-language text"><span lang="ja">読<b>む</b></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; row 3)</span>, <span title="Hepburn transliteration" about="#mwt78" typeof="mw:Transclusion" id="mw_w" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo3&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;読'''め'''〜&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yo'''me'''‑&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;row 4&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">yo<b>me</b>‑</i></span><span style="font-weight: normal" about="#mwt78" id="mwAQA"> (<span title="Japanese-language text"><span lang="ja">読<b>め</b>〜</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; row 4)</span> and <span title="Hepburn transliteration" about="#mwt79" typeof="mw:Transclusion" id="mwAQE" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:Nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo3&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;読'''も'''〜&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yo'''mo'''‑&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;row 5&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">yo<b>mo</b>‑</i></span><span style="font-weight: normal" about="#mwt79" id="mwAQI"> (<span title="Japanese-language text"><span lang="ja">読<b>も</b>〜</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">; row 5)</span>. Unlike godan verb stems, ichidan verb stems are also functional conjugational stems, with the final kana of the stem remaining static in all conjugations.</p>

<p id="mwAQM"><span class="anchor" id="終止形" about="#mwt80" typeof="mw:Transclusion" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;anchor&quot;,&quot;href&quot;:&quot;./Template:Anchor&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;終止形&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;shūshikei&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;shushikei&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;連体形&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;rentaikei&quot;},&quot;6&quot;:{&quot;wt&quot;:&quot;未然形&quot;},&quot;7&quot;:{&quot;wt&quot;:&quot;mizenkei&quot;},&quot;8&quot;:{&quot;wt&quot;:&quot;連用形&quot;},&quot;9&quot;:{&quot;wt&quot;:&quot;ren'yōkei&quot;},&quot;10&quot;:{&quot;wt&quot;:&quot;ren'yokei&quot;},&quot;11&quot;:{&quot;wt&quot;:&quot;renyokei&quot;},&quot;12&quot;:{&quot;wt&quot;:&quot;音便形&quot;},&quot;13&quot;:{&quot;wt&quot;:&quot;onbinkei&quot;},&quot;14&quot;:{&quot;wt&quot;:&quot;意志形&quot;},&quot;15&quot;:{&quot;wt&quot;:&quot;ishikei&quot;},&quot;16&quot;:{&quot;wt&quot;:&quot;命令形&quot;},&quot;17&quot;:{&quot;wt&quot;:&quot;meireikei&quot;},&quot;18&quot;:{&quot;wt&quot;:&quot;可能形&quot;},&quot;19&quot;:{&quot;wt&quot;:&quot;kanōkei&quot;},&quot;20&quot;:{&quot;wt&quot;:&quot;kanokei&quot;},&quot;21&quot;:{&quot;wt&quot;:&quot;仮定形&quot;},&quot;22&quot;:{&quot;wt&quot;:&quot;kateikei&quot;},&quot;23&quot;:{&quot;wt&quot;:&quot;已然形&quot;},&quot;24&quot;:{&quot;wt&quot;:&quot;izenkei&quot;}},&quot;i&quot;:0}}]}"></span><span class="anchor" id="shūshikei" about="#mwt80"></span><span class="anchor" id="shushikei" about="#mwt80"></span><span class="anchor" id="連体形" about="#mwt80"></span><span class="anchor" id="rentaikei" about="#mwt80"></span><span class="anchor" id="未然形" about="#mwt80"></span><span class="anchor" id="mizenkei" about="#mwt80"></span><span class="anchor" id="連用形" about="#mwt80"></span><span class="anchor" id="ren'yōkei" about="#mwt80"></span><span class="anchor" id="ren'yokei" about="#mwt80"></span><span class="anchor" id="renyokei" about="#mwt80"></span><span class="anchor" id="音便形" about="#mwt80"></span><span class="anchor" id="onbinkei" about="#mwt80"></span><span class="anchor" id="意志形" about="#mwt80"></span><span class="anchor" id="ishikei" about="#mwt80"></span><span class="anchor" id="命令形" about="#mwt80"></span><span class="anchor" id="meireikei" about="#mwt80"></span><span class="anchor" id="可能形" about="#mwt80"></span><span class="anchor" id="kanōkei" about="#mwt80"></span><span class="anchor" id="kanokei" about="#mwt80"></span><span class="anchor" id="仮定形" about="#mwt80"></span><span class="anchor" id="kateikei" about="#mwt80"></span><span class="anchor" id="已然形" about="#mwt80"></span><span class="anchor" id="izenkei" about="#mwt80"></span></p>

</section><section data-mw-section-id="2" id="mwAQQ" aria-labelledby="Verb_bases"><div class="mw-heading mw-heading2"><h2 id="Verb_bases">Verb bases</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Japanese_conjugation&amp;action=edit&amp;section=2" title="Edit section: Verb bases"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwAQU">Conjugable words (verbs, <i id="mwAQY">i</i>‑adjectives, and <i id="mwAQc">na</i>‑adjectives) are traditionally considered to have six possible <b about="#mwt81" typeof="mw:Transclusion" id="mwAQg" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;'''conjugational stems''' or '''bases'''&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;[[:ja:活用形|活用形]]&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;katsuyōkei&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;extra=literally \&quot;conjugation forms\&quot;&quot;}},&quot;i&quot;:0}}]}">conjugational stems</b><span about="#mwt81"> or </span><b about="#mwt81">bases</b><span style="font-weight: normal" about="#mwt81" id="mwAQk"> (<span title="Japanese-language text"><span lang="ja"><a rel="mw:WikiLink/Interwiki" href="https://ja.wikipedia.org/wiki/活用形" title="ja:活用形" class="extiw">活用形</a></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">, <span title="Hepburn transliteration"><i lang="ja-Latn">katsuyōkei</i></span>; literally "conjugation forms")</span>.<sup about="#mwt82" class="mw-ref reference" id="cite_ref-FOOTNOTEMatsuoka_McClain19815–6&quot;Verbs:_Functions_of_Six_Bases&quot;_3-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMatsuoka McClain19815–6\&quot;Verbs: Functions of Six Bases\&quot;&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMatsuoka_McClain19815–6\&quot;Verbs:_Functions_of_Six_Bases\&quot;-3&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Matsuoka McClain&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;1981&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;5–6&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;Verbs: Functions of Six Bases\&quot;&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMatsuoka_McClain19815–6&quot;Verbs:_Functions_of_Six_Bases&quot;-3" id="mwAQo"><span class="mw-reflink-text" id="mwAQs"><span class="cite-bracket" id="mwAQw">[</span>3<span class="cite-bracket" id="mwAQ0">]</span></span></a></sup> However, as a result of the language evolving,<sup about="#mwt85" class="mw-ref reference" id="cite_ref-FOOTNOTENakano2008103–105&quot;2.可能表現の形態とその内容の変遷ー動作主体性の発達&quot;_(Potential)_4-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTENakano2008103–105\&quot;2.可能表現の形態とその内容の変遷ー動作主体性の発達\&quot; (Potential)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTENakano2008103–105\&quot;2.可能表現の形態とその内容の変遷ー動作主体性の発達\&quot;_(Potential)-4&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Nakano&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2008&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;103–105&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;2.可能表現の形態とその内容の変遷ー動作主体性の発達\&quot; (Potential)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTENakano2008103–105&quot;2.可能表現の形態とその内容の変遷ー動作主体性の発達&quot;_(Potential)-4" id="mwAQ4"><span class="mw-reflink-text" id="mwAQ8"><span class="cite-bracket" id="mwARA">[</span>4<span class="cite-bracket" id="mwARE">]</span></span></a></sup><sup about="#mwt88" class="mw-ref reference" id="cite_ref-FOOTNOTEMiyake2016&quot;可能形&quot;_(Potential)_5-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMiyake2016\&quot;可能形\&quot; (Potential)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMiyake2016\&quot;可能形\&quot;_(Potential)-5&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Miyake&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2016&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;可能形\&quot; (Potential)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMiyake2016&quot;可能形&quot;_(Potential)-5" id="mwARI"><span class="mw-reflink-text" id="mwARM"><span class="cite-bracket" id="mwARQ">[</span>5<span class="cite-bracket" id="mwARU">]</span></span></a></sup> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_grammar#Euphonic_changes_(音便_onbin)" title="Japanese grammar" id="mwARY">historical sound shifts</a>,<sup about="#mwt91" class="mw-ref reference" id="cite_ref-FOOTNOTENakamura2009&quot;音便形&quot;_(Euphonic_Change)_6-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTENakamura2009\&quot;音便形\&quot; (Euphonic Change)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTENakamura2009\&quot;音便形\&quot;_(Euphonic_Change)-6&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Nakamura&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2009&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;音便形\&quot; (Euphonic Change)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTENakamura2009&quot;音便形&quot;_(Euphonic_Change)-6" id="mwARc"><span class="mw-reflink-text" id="mwARg"><span class="cite-bracket" id="mwARk">[</span>6<span class="cite-bracket" id="mwARo">]</span></span></a></sup><sup about="#mwt94" class="mw-ref reference" id="cite_ref-FOOTNOTESakaki2019&quot;音便形&quot;_(Euphonic_Change)_7-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTESakaki2019\&quot;音便形\&quot; (Euphonic Change)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTESakaki2019\&quot;音便形\&quot;_(Euphonic_Change)-7&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Sakaki&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2019&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;音便形\&quot; (Euphonic Change)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTESakaki2019&quot;音便形&quot;_(Euphonic_Change)-7" id="mwARs"><span class="mw-reflink-text" id="mwARw"><span class="cite-bracket" id="mwAR0">[</span>7<span class="cite-bracket" id="mwAR4">]</span></span></a></sup> and the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_script_reform#Reforms" title="Japanese script reform" id="mwAR8">post‑WWII spelling reforms</a>,<sup about="#mwt97" class="mw-ref reference" id="cite_ref-FOOTNOTEKoyanagi2014&quot;意志形&quot;_(Volitional)_8-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEKoyanagi2014\&quot;意志形\&quot; (Volitional)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEKoyanagi2014\&quot;意志形\&quot;_(Volitional)-8&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Koyanagi&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;2014&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;意志形\&quot; (Volitional)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEKoyanagi2014&quot;意志形&quot;_(Volitional)-8" id="mwASA"><span class="mw-reflink-text" id="mwASE"><span class="cite-bracket" id="mwASI">[</span>8<span class="cite-bracket" id="mwASM">]</span></span></a></sup> three additional sub‑bases have emerged for verbs (seen in the table below as the Potential, Tentative, and Euphonic bases). Meanwhile, verbs no longer differentiate between the <span about="#mwt100" typeof="mw:Transclusion" id="mwASQ" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;conclusive form&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;終止形&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;shūshikei&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;extra=used to terminate a predicate&quot;}},&quot;i&quot;:0}}]}">conclusive form</span><span style="font-weight: normal" about="#mwt100" id="mwASU"> (<span title="Japanese-language text"><span lang="ja">終止形</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">, <span title="Hepburn transliteration"><i lang="ja-Latn">shūshikei</i></span>; used to terminate a predicate)</span> and the <span about="#mwt101" typeof="mw:Transclusion" id="mwASY" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;attributive form&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;連体形&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;rentaikei&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;extra=used to modify a noun or noun phrase&quot;}},&quot;i&quot;:0}}]}">attributive form</span><span style="font-weight: normal" about="#mwt101" id="mwASc"> (<span title="Japanese-language text"><span lang="ja">連体形</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">, <span title="Hepburn transliteration"><i lang="ja-Latn">rentaikei</i></span>; used to modify a noun or noun phrase)</span> bases (these bases are only distinguished for <i id="mwASg">na</i>‑adjectives in the modern language, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_adjectives" title="Japanese adjectives" id="mwASk">Japanese adjectives</a>).<sup about="#mwt102" class="mw-ref reference" id="cite_ref-FOOTNOTEMatsuoka_McClain19816&quot;Verbs:_3._Third_Base&quot;_(終止形/連体形;_Conclusive/Attributive_Base)_9-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMatsuoka McClain19816\&quot;Verbs: 3. Third Base\&quot; (終止形/連体形; Conclusive/Attributive Base)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMatsuoka_McClain19816\&quot;Verbs:_3._Third_Base\&quot;_(終止形/連体形;_Conclusive/Attributive_Base)-9&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Matsuoka McClain&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;1981&quot;},&quot;p&quot;:{&quot;wt&quot;:&quot;6&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;Verbs: 3. Third Base\&quot; (終止形/連体形; Conclusive/Attributive Base)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMatsuoka_McClain19816&quot;Verbs:_3._Third_Base&quot;_(終止形/連体形;_Conclusive/Attributive_Base)-9" id="mwASo"><span class="mw-reflink-text" id="mwASs"><span class="cite-bracket" id="mwASw">[</span>9<span class="cite-bracket" id="mwAS0">]</span></span></a></sup><sup about="#mwt105" class="mw-ref reference" id="cite_ref-FOOTNOTEMakinoTsutsui2018580–581&quot;Appendix_1_Basic_Conjugations&quot;_(Adjectives)_10-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMakinoTsutsui2018580–581\&quot;Appendix 1 Basic Conjugations\&quot; (Adjectives)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMakinoTsutsui2018580–581\&quot;Appendix_1_Basic_Conjugations\&quot;_(Adjectives)-10&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Makino&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Tsutsui&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;2018&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;580–581&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;Appendix 1 Basic Conjugations\&quot; (Adjectives)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMakinoTsutsui2018580–581&quot;Appendix_1_Basic_Conjugations&quot;_(Adjectives)-10" id="mwAS4"><span class="mw-reflink-text" id="mwAS8"><span class="cite-bracket" id="mwATA">[</span>10<span class="cite-bracket" id="mwATE">]</span></span></a></sup> Verb bases function as the necessary stem forms to which <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Inflectional_suffix" title="Inflectional suffix" class="mw-redirect" id="mwATI">inflectional suffixes</a> attach.</p>

<p id="mwATM">The "default" dictionary form, or <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Lemma_(morphology)" title="Lemma (morphology)" id="mwATQ">lemma</a>, of any conjugational morpheme, be it a verb, an adjective or an auxiliary, is its conclusive form, which is listed first in the table below. The verb group (<i id="mwATU">godan</i>, <i id="mwATY">ichidan</i>, or irregular) determines how to derive any given conjugation base for the verb. With <i id="mwATc">godan</i> verbs, the base is derived by shifting the final kana along the respective vowel row of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Gojūon#Table" title="Gojūon" id="mwATg">gojūon kana table</a>. With <i id="mwATk">ichidan</i> verbs, the base is derived by removing or replacing the final <span title="Hepburn transliteration" about="#mwt108" typeof="mw:Transclusion" id="mwATo" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;る&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;ru&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">ru</i></span><span style="font-weight: normal" about="#mwt108" id="mwATs"> (<span title="Japanese-language text"><span lang="ja">る</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span> kana.<sup about="#mwt109" class="mw-ref reference" id="cite_ref-FOOTNOTEMakinoTsutsui2018576–579&quot;Appendix_1_Basic_Conjugations&quot;_(Verbs)_2-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMakinoTsutsui2018576–579\&quot;Appendix 1 Basic Conjugations\&quot; (Verbs)&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMakinoTsutsui2018576–579\&quot;Appendix_1_Basic_Conjugations\&quot;_(Verbs)-2&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Makino&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Tsutsui&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;2018&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;576–579&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;Appendix 1 Basic Conjugations\&quot; (Verbs)&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMakinoTsutsui2018576–579&quot;Appendix_1_Basic_Conjugations&quot;_(Verbs)-2" id="mwATw"><span class="mw-reflink-text" id="mwAT0"><span class="cite-bracket" id="mwAT4">[</span>2<span class="cite-bracket" id="mwAT8">]</span></span></a></sup></p>

<p id="mwAUA">The table below illustrates the various verb bases across the verb groups, with the patterns starting from the dictionary form.<sup about="#mwt112" class="mw-ref reference" id="cite_ref-FOOTNOTEMatsuoka_McClain19816–13&quot;Verbs:_Conjugation_Charts&quot;_11-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMatsuoka McClain19816–13\&quot;Verbs: Conjugation Charts\&quot;&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMatsuoka_McClain19816–13\&quot;Verbs:_Conjugation_Charts\&quot;-11&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Matsuoka McClain&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;1981&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;6–13&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;Verbs: Conjugation Charts\&quot;&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMatsuoka_McClain19816–13&quot;Verbs:_Conjugation_Charts&quot;-11" id="mwAUE"><span class="mw-reflink-text" id="mwAUI"><span class="cite-bracket" id="mwAUM">[</span>11<span class="cite-bracket" id="mwAUQ">]</span></span></a></sup> The mizenkei base for verbs ending in <span title="Hepburn transliteration" about="#mwt115" typeof="mw:Transclusion" id="mwAUU" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;〜う&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;‑u&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">‑u</i></span><span style="font-weight: normal" about="#mwt115" id="mwAUY"> (<span title="Japanese-language text"><span lang="ja">〜う</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span> appears to be an exceptional case with the unexpected <span title="Hepburn transliteration" about="#mwt116" typeof="mw:Transclusion" id="mwAUc" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;〜わ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;‑wa&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">‑wa</i></span><span style="font-weight: normal" about="#mwt116" id="mwAUg"> (<span title="Japanese-language text"><span lang="ja">〜わ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span>. This realization of <span title="Japanese-language romanization" about="#mwt117" typeof="mw:Transclusion" id="mwAUk" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Transliteration&quot;,&quot;href&quot;:&quot;./Template:Transliteration&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;‑wa&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">‑wa</i></span> is a leftover from past sound changes, an artifact preserved from the archaic Japanese <span title="Japanese-language romanization" about="#mwt118" typeof="mw:Transclusion" id="mwAUo" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Transliteration&quot;,&quot;href&quot;:&quot;./Template:Transliteration&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;‑fu&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">‑fu</i></span> from <span title="Japanese-language romanization" about="#mwt119" typeof="mw:Transclusion" id="mwAUs" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Transliteration&quot;,&quot;href&quot;:&quot;./Template:Transliteration&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;‑pu&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">‑pu</i></span> verbs (which would have yielded, regularly, <span title="Japanese-language romanization" about="#mwt120" typeof="mw:Transclusion" id="mwAUw" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Transliteration&quot;,&quot;href&quot;:&quot;./Template:Transliteration&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;‑wa&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">‑wa</i></span> from <span title="Japanese-language romanization" about="#mwt121" typeof="mw:Transclusion" id="mwAU0" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Transliteration&quot;,&quot;href&quot;:&quot;./Template:Transliteration&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;‑fa&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">‑fa</i></span> from <span title="Japanese-language romanization" about="#mwt122" typeof="mw:Transclusion" id="mwAU4" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Transliteration&quot;,&quot;href&quot;:&quot;./Template:Transliteration&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;‑pa&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">‑pa</i></span>). This is noted with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Historical_kana_orthography" title="Historical kana orthography" id="mwAU8">historical kana orthography</a> in dictionaries; for example, <span title="Hepburn transliteration" about="#mwt123" typeof="mw:Transclusion" id="mwAVA" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;言う&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;yū&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">yū</i></span><span style="font-weight: normal" about="#mwt123" id="mwAVE"> (<span title="Japanese-language text"><span lang="ja">言う</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span> from <span title="Hepburn transliteration" about="#mwt124" typeof="mw:Transclusion" id="mwAVI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;言ふ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;ifu&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">ifu</i></span><span style="font-weight: normal" about="#mwt124" id="mwAVM"> (<span title="Japanese-language text"><span lang="ja">言ふ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span> from <span title="Japanese-language romanization" about="#mwt125" typeof="mw:Transclusion" id="mwAVQ" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Transliteration&quot;,&quot;href&quot;:&quot;./Template:Transliteration&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ipu&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">ipu</i></span> and <span title="Hepburn transliteration" about="#mwt126" typeof="mw:Transclusion" id="mwAVU" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;言わぬ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;iwanu&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">iwanu</i></span><span style="font-weight: normal" about="#mwt126" id="mwAVY"> (<span title="Japanese-language text"><span lang="ja">言わぬ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span> from <span title="Hepburn transliteration" about="#mwt127" typeof="mw:Transclusion" id="mwAVc" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:nihongo&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;nihongo&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;言はぬ&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;ifanu&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">ifanu</i></span><span style="font-weight: normal" about="#mwt127" id="mwAVg"> (<span title="Japanese-language text"><span lang="ja">言はぬ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text">)</span> (from <span title="Japanese-language romanization" about="#mwt128" typeof="mw:Transclusion" id="mwAVk" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Transliteration&quot;,&quot;href&quot;:&quot;./Template:Transliteration&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;ja&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ipanu&quot;}},&quot;i&quot;:0}}]}"><i lang="ja-Latn">ipanu</i></span>).<sup about="#mwt140" class="mw-ref reference" id="cite_ref-chamberlain-1907_12-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;chamberlain-1907&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-chamberlain-1907-12&quot;}}"><a href="#cite_note-chamberlain-1907-12" id="mwAVo"><span class="mw-reflink-text" id="mwAVs"><span class="cite-bracket" id="mwAVw">[</span>12<span class="cite-bracket" id="mwAV0">]</span></span></a></sup> In modern Japanese, original instances of mid‑word consonant [w] have since been dropped before all vowels except [a].<sup about="#mwt141" class="mw-ref reference" id="cite_ref-chamberlain-1907_12-1" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;chamberlain-1907&quot;}}"><a href="#cite_note-chamberlain-1907-12" id="mwAV4"><span class="mw-reflink-text" id="mwAV8"><span class="cite-bracket" id="mwAWA">[</span>12<span class="cite-bracket" id="mwAWE">]</span></span></a></sup><sup about="#mwt129" class="mw-ref reference" id="cite_ref-FOOTNOTEBannoIkedaOhnoShinagawa2020a232–233&quot;Lesson_22,_Grammar_1:_Causative_Sentences&quot;_13-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEBannoIkedaOhnoShinagawa2020a232–233\&quot;Lesson 22, Grammar 1: Causative Sentences\&quot;&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEBannoIkedaOhnoShinagawa2020a232–233\&quot;Lesson_22,_Grammar_1:_Causative_Sentences\&quot;-13&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Banno&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Ikeda&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;Ohno&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;Shinagawa&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;2020a&quot;},&quot;pp&quot;:{&quot;wt&quot;:&quot;232–233&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;Lesson 22, Grammar 1: Causative Sentences\&quot;&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEBannoIkedaOhnoShinagawa2020a232–233&quot;Lesson_22,_Grammar_1:_Causative_Sentences&quot;-13" id="mwAWI"><span class="mw-reflink-text" id="mwAWM"><span class="cite-bracket" id="mwAWQ">[</span>13<span class="cite-bracket" id="mwAWU">]</span></span></a></sup><sup about="#mwt132" class="mw-ref reference" id="cite_ref-FOOTNOTEMatsuoka_McClain19818-11&quot;Verbs:_Conjugation_of_Japanese_Verbs:_II._Consonant-stem_verbs&quot;_14-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEMatsuoka McClain19818-11\&quot;Verbs: Conjugation of Japanese Verbs: II. Consonant-stem verbs\&quot;&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEMatsuoka_McClain19818-11\&quot;Verbs:_Conjugation_of_Japanese_Verbs:_II._Consonant-stem_verbs\&quot;-14&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfnp&quot;,&quot;href&quot;:&quot;./Template:Sfnp&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Matsuoka McClain&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;1981&quot;},&quot;p&quot;:{&quot;wt&quot;:&quot;8-11&quot;},&quot;loc&quot;:{&quot;wt&quot;:&quot;\&quot;Verbs: Conjugation of Japanese Verbs: II. Consonant-stem verbs\&quot;&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEMatsuoka_McClain19818-11&quot;Verbs:_Conjugation_of_Japanese_Verbs:_II._Consonant-stem_verbs&quot;-14" id="mwAWY"><span class="mw-reflink-text" id="mwAWc"><span class="cite-bracket" id="mwAWg">[</span>14<span class="cite-bracket" id="mwAWk">]</span></span></a></sup> (For more on this shift in consonants, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Old_Japanese#Consonants" title="Old Japanese" about="#mwt135" typeof="mw:Transclusion" id="mwAWo" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;section link&quot;,&quot;href&quot;:&quot;./Template:Section_link&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Old Japanese&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Consonants&quot;}},&quot;i&quot;:0}}]}">Old Japanese §<span typeof="mw:Entity">&nbsp;</span>Consonants</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Early_Middle_Japanese#Consonants" title="Early Middle Japanese" about="#mwt136" typeof="mw:Transclusion" id="mwAWs" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;section link&quot;,&quot;href&quot;:&quot;./Template:Section_link&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Early Middle Japanese&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Consonants&quot;}},&quot;i&quot;:0}}]}">Early Middle Japanese §<span typeof="mw:Entity">&nbsp;</span>Consonants</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Late_Middle_Japanese#/h/_and_/p/" title="Late Middle Japanese" about="#mwt137" typeof="mw:Transclusion" id="mwAWw" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;section link&quot;,&quot;href&quot;:&quot;./Template:Section_link&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Late Middle Japanese&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;/h/ and /p/&quot;}},&quot;i&quot;:0}}]}">Late Middle Japanese §<span typeof="mw:Entity">&nbsp;</span>/h/ and /p/</a>).</p>


<table class="wikitable" style="text-align:center" id="mwAW8">
<caption style="text-align:left" id="mwAXA">Verb base formation table</caption>
<tbody id="mwAXE"><tr id="mwAXI">
<th colspan="2" rowspan="2" id="mwAXM"><big id="mwAXQ">Verb base</big></th>
<th rowspan="2" style="width:150px" id="mwAXU">Aliases<sup about="#mwt144" class="mw-ref reference" id="cite_ref-23" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;lower-alpha&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-23&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;efn&quot;,&quot;href&quot;:&quot;./Template:Efn&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;<ref name=satow-1873/>{{sfnp|Ministry of Education, Science, Sports and Culture|1935a|p=99}}{{sfnp|Henderson|1948|p=12}}{{sfnp|Kuno|1973|pp=27–28}}{{sfnp|Matsuoka McClain|1981|pp=5–6}}{{sfnp|Martin|2004|pp=1093–1198}}{{sfnp|Shirane|2005|pp=24–25, 402}}{{sfnp|Frellesvig|2010|pp=xxi, 115}}&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-23" data-mw-group="lower-alpha" id="mwAXY"><span class="mw-reflink-text" id="mwAXc"><span class="cite-bracket" id="mwAXg">[</span>a<span class="cite-bracket" id="mwAXk">]</span></span></a></sup></th>
<th colspan="2" id="mwAXo"><i id="mwAXs">Godan</i></th>
<th colspan="2" id="mwAXw"><i id="mwAX0">Ichidan</i></th>
<th colspan="4" id="mwAX4">Irregular</th>
