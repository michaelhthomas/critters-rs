</section><section data-mw-section-id="7" id="mwCtc" aria-labelledby="Political_trends"><div class="mw-heading mw-heading3"><h3 id="Political_trends">Political trends</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2020s&amp;action=edit&amp;section=7" title="Edit section: Political trends"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<span class="mw-empty-elt" about="#mwt810" typeof="mw:Transclusion" id="mwCtg" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Further&quot;,&quot;href&quot;:&quot;./Template:Further&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;2020s in politics&quot;}},&quot;i&quot;:0}}]}"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1353705441" about="#mwt811" typeof="mw:Extension/templatestyles" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Module:Hatnote/styles.css&quot;},&quot;body&quot;:{&quot;extsrc&quot;:&quot;&quot;}}"></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt810" id="mwCtk">Further information: <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2020s_in_politics" title="2020s in politics">2020s in politics</a></div>
<span class="mw-empty-elt" about="#mwt812" typeof="mw:Transclusion" id="mwCto" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Multiple image\n&quot;,&quot;href&quot;:&quot;./Template:Multiple_image&quot;},&quot;params&quot;:{&quot;image1&quot;:{&quot;wt&quot;:&quot;V-Dem Electoral Democracy Index 2026 World.svg&quot;},&quot;image2&quot;:{&quot;wt&quot;:&quot;V-Dem Liberal Democracy Index 2026 World.svg&quot;},&quot;image3&quot;:{&quot;wt&quot;:&quot;The Economist Democracy Index 2025.svg&quot;},&quot;image4&quot;:{&quot;wt&quot;:&quot;Press freedom 2025.svg&quot;},&quot;caption1&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;footer&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;caption4&quot;:{&quot;wt&quot;:&quot;The 2026 [[V-Dem Democracy Indices]], the 2025 [[The Economist Democracy Index|Economist Democracy Index]], and the 2025 [[World Press Freedom Index]] by [[Reporters Without Borders]] (RSF)<ref name=\&quot;j496\&quot;>{{cite web |title=Democracy Report 2026, Unraveling The Democratic Era? |url=https://v-dem.net/documents/75/V-Dem_Institute_Democracy_Report_2026_lowres.pdf |access-date=2026-03-17}}</ref><ref name=\&quot;l511\&quot;>{{cite web |date=2026 |title=The V-Dem Dataset – V-Dem |url=https://v-dem.net/data/the-v-dem-dataset/ |access-date=2026-03-17 |website=V-Dem |publisher=V-Dem Institute}}</ref><ref>{{cite web |title=RSF World Press Freedom Index 2025: economic fragility a leading threat to press freedom |url=https://rsf.org/en/rsf-world-press-freedom-index-2025-economic-fragility-leading-threat-press-freedom |access-date=May 3, 2025 |website=Reporters Without Borders}}</ref>&quot;},&quot;footer_align&quot;:{&quot;wt&quot;:&quot;center&quot;},&quot;direction&quot;:{&quot;wt&quot;:&quot;vertical&quot;},&quot;total_width&quot;:{&quot;wt&quot;:&quot;240&quot;}},&quot;i&quot;:0}}]}"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1349637415/mw-parser-output/.tmulti" about="#mwt813" typeof="mw:Extension/templatestyles" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Multiple image/styles.css&quot;,&quot;wrapper&quot;:&quot;.tmulti&quot;},&quot;body&quot;:{&quot;extsrc&quot;:&quot;&quot;}}"></span><div class="thumb tmulti floatright" about="#mwt812"><div class="thumbinner multiimageinner" style="width:232px;max-width:232px"><div class="trow"><div class="tsingle" style="width:230px;max-width:230px"><div class="thumbimage" style="height:115px;overflow:hidden"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:V-Dem_Electoral_Democracy_Index_2026_World.svg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:V-Dem_Electoral_Democracy_Index_2026_World.svg" src="//upload.wikimedia.org/wikipedia/commons/thumb/4/4e/V-Dem_Electoral_Democracy_Index_2026_World.svg/250px-V-Dem_Electoral_Democracy_Index_2026_World.svg.png" decoding="async" data-file-width="768" data-file-height="390" data-file-type="drawing" height="116" width="228" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/4/4e/V-Dem_Electoral_Democracy_Index_2026_World.svg/500px-V-Dem_Electoral_Democracy_Index_2026_World.svg.png 2x" class="mw-file-element"></a></span></div></div></div><div class="trow"><div class="tsingle" style="width:230px;max-width:230px"><div class="thumbimage" style="height:115px;overflow:hidden"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:V-Dem_Liberal_Democracy_Index_2026_World.svg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:V-Dem_Liberal_Democracy_Index_2026_World.svg" src="//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/V-Dem_Liberal_Democracy_Index_2026_World.svg/250px-V-Dem_Liberal_Democracy_Index_2026_World.svg.png" decoding="async" data-file-width="768" data-file-height="390" data-file-type="drawing" height="116" width="228" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/V-Dem_Liberal_Democracy_Index_2026_World.svg/500px-V-Dem_Liberal_Democracy_Index_2026_World.svg.png 2x" class="mw-file-element"></a></span></div></div></div><div class="trow"><div class="tsingle" style="width:230px;max-width:230px"><div class="thumbimage" style="height:115px;overflow:hidden"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:The_Economist_Democracy_Index_2025.svg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:The_Economist_Democracy_Index_2025.svg" src="//upload.wikimedia.org/wikipedia/commons/thumb/7/77/The_Economist_Democracy_Index_2025.svg/250px-The_Economist_Democracy_Index_2025.svg.png" decoding="async" data-file-width="2754" data-file-height="1398" data-file-type="drawing" height="116" width="228" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/7/77/The_Economist_Democracy_Index_2025.svg/500px-The_Economist_Democracy_Index_2025.svg.png 2x" class="mw-file-element"></a></span></div></div></div><div class="trow"><div class="tsingle" style="width:230px;max-width:230px"><div class="thumbimage" style="height:115px;overflow:hidden"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:Press_freedom_2025.svg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Press_freedom_2025.svg" src="//upload.wikimedia.org/wikipedia/commons/thumb/4/41/Press_freedom_2025.svg/250px-Press_freedom_2025.svg.png" decoding="async" data-file-width="3494" data-file-height="1772" data-file-type="drawing" height="116" width="228" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/4/41/Press_freedom_2025.svg/500px-Press_freedom_2025.svg.png 2x" class="mw-file-element"></a></span></div><div class="thumbcaption">The 2026 <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/V-Dem_Democracy_Indices" title="V-Dem Democracy Indices">V-Dem Democracy Indices</a>, the 2025 <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/The_Economist_Democracy_Index" title="The Economist Democracy Index">Economist Democracy Index</a>, and the 2025 <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/World_Press_Freedom_Index" title="World Press Freedom Index">World Press Freedom Index</a> by <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Reporters_Without_Borders" title="Reporters Without Borders">Reporters Without Borders</a> (RSF)<sup about="#mwt816" class="mw-ref reference" id="cite_ref-j496_231-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;j496&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-j496-231&quot;}}"><a href="#cite_note-j496-231" id="mwCts"><span class="mw-reflink-text" id="mwCtw"><span class="cite-bracket" id="mwCt0">[</span>231<span class="cite-bracket" id="mwCt4">]</span></span></a></sup><sup about="#mwt821" class="mw-ref reference" id="cite_ref-l511_232-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;l511&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-l511-232&quot;}}"><a href="#cite_note-l511-232" id="mwCt8"><span class="mw-reflink-text" id="mwCuA"><span class="cite-bracket" id="mwCuE">[</span>232<span class="cite-bracket" id="mwCuI">]</span></span></a></sup><sup about="#mwt826" class="mw-ref reference" id="cite_ref-233" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-233&quot;}}"><a href="#cite_note-233" id="mwCuM"><span class="mw-reflink-text" id="mwCuQ"><span class="cite-bracket" id="mwCuU">[</span>233<span class="cite-bracket" id="mwCuY">]</span></span></a></sup></div></div></div></div></div><span class="mw-empty-elt" about="#mwt812"><link rel="mw:PageProp/Category" href="./Category:Pages_using_multiple_image_with_auto_scaled_images"></span>
<p id="mwCuc">The 2020s marked the end of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Post-Cold_War_era" title="Post-Cold War era" class="mw-redirect" id="mwCug">post-Cold War era</a>, particularly in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Post-communism" title="Post-communism" id="mwCuk">post-communist</a> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Eastern_Europe" title="Eastern Europe" id="mwCuo">Eastern Europe</a>, east of the former <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Iron_Curtain" title="Iron Curtain" id="mwCus">Iron Curtain</a>.<sup about="#mwt831" class="mw-ref reference" id="cite_ref-Ghodsee2017_234-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Ghodsee2017&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Ghodsee2017-234&quot;}}"><a href="#cite_note-Ghodsee2017-234" id="mwCuw"><span class="mw-reflink-text" id="mwCu0"><span class="cite-bracket" id="mwCu4">[</span>234<span class="cite-bracket" id="mwCu8">]</span></span></a></sup> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pasokification" title="Pasokification" id="mwCvA">Pasokification</a> marked the decline of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Centre-left_politics" title="Centre-left politics" id="mwCvE">centre-left</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Centre-right_politics" title="Centre-right politics" id="mwCvI">centre-right politics</a> throughout the Western world during the decade, led by demographic changes such as increased <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Tertiary_education" title="Tertiary education" id="mwCvM">tertiary education</a> and ethnic diversity as well as the waning influence of religion and the rise of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Identity_politics" title="Identity politics" id="mwCvQ">identity politics</a>. At this time, centre-right parties drifted rightward towards <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Libertarianism" title="Libertarianism" id="mwCvU">libertarianism</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Right-wing_populism" title="Right-wing populism" id="mwCvY">right-wing populism</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/National_conservatism" title="National conservatism" id="mwCvc">national conservatism</a>, or were supplanted by new far-right parties.<sup about="#mwt834" class="mw-ref reference" id="cite_ref-235" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-235&quot;}}"><a href="#cite_note-235" id="mwCvg"><span class="mw-reflink-text" id="mwCvk"><span class="cite-bracket" id="mwCvo">[</span>235<span class="cite-bracket" id="mwCvs">]</span></span></a></sup> Centre-left politics has not declined to the same extent, although some have, most notably <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Joe_Biden" title="Joe Biden" id="mwCvw">Joe Biden</a> (particularly <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Age_and_health_concerns_about_Joe_Biden" title="Age and health concerns about Joe Biden" id="mwCv0">age and health concerns</a>).<sup about="#mwt837" class="mw-ref reference" id="cite_ref-236" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-236&quot;}}"><a href="#cite_note-236" id="mwCv4"><span class="mw-reflink-text" id="mwCv8"><span class="cite-bracket" id="mwCwA">[</span>236<span class="cite-bracket" id="mwCwE">]</span></span></a></sup> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Volodymyr_Zelenskyy" title="Volodymyr Zelenskyy" id="mwCwI">Volodymyr Zelenskyy</a> in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Ukraine" title="Ukraine" id="mwCwM">Ukraine</a> is also struggling, with the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Next_Ukrainian_presidential_election" title="Next Ukrainian presidential election" id="mwCwQ">next Ukrainian presidential election</a> indefinitely postponed due to the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Russo-Ukrainian_war_(2022–present)" title="Russo-Ukrainian war (2022–present)" id="mwCwU">Russo-Ukrainian war</a>.<sup about="#mwt840" class="mw-ref reference" id="cite_ref-no_term_end_237-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;no term end&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-no_term_end-237&quot;}}"><a href="#cite_note-no_term_end-237" id="mwCwY"><span class="mw-reflink-text" id="mwCwc"><span class="cite-bracket" id="mwCwg">[</span>237<span class="cite-bracket" id="mwCwk">]</span></span></a></sup><sup about="#mwt843" class="mw-ref reference" id="cite_ref-238" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-238&quot;}}"><a href="#cite_note-238" id="mwCwo"><span class="mw-reflink-text" id="mwCws"><span class="cite-bracket" id="mwCww">[</span>238<span class="cite-bracket" id="mwCw0">]</span></span></a></sup></p>

<p id="mwCw4">A deep political divide has arisen in the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/United_States" title="United States" id="mwCw8">United States</a>,<sup about="#mwt846" class="mw-ref reference" id="cite_ref-239" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-239&quot;}}"><a href="#cite_note-239" id="mwCxA"><span class="mw-reflink-text" id="mwCxE"><span class="cite-bracket" id="mwCxI">[</span>239<span class="cite-bracket" id="mwCxM">]</span></span></a></sup> which has seen acute <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Political_polarization_in_the_United_States" title="Political polarization in the United States" id="mwCxQ">political polarization</a>, with stark divides along <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Race_and_ethnicity_in_the_United_States" title="Race and ethnicity in the United States" id="mwCxU">race and ethnicity</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Educational_attainment_in_the_United_States" title="Educational attainment in the United States" id="mwCxY">educational attainment</a>,<sup about="#mwt849" class="mw-ref reference" id="cite_ref-gap_within_the_gender_gap_240-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;gap within the gender gap&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-gap_within_the_gender_gap-240&quot;}}"><a href="#cite_note-gap_within_the_gender_gap-240" id="mwCxc"><span class="mw-reflink-text" id="mwCxg"><span class="cite-bracket" id="mwCxk">[</span>240<span class="cite-bracket" id="mwCxo">]</span></span></a></sup> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Blue_states_and_red_states" title="Blue states and red states" class="mw-redirect" id="mwCxs">political polarization among states</a>.<sup about="#mwt852" class="mw-ref reference" id="cite_ref-CNN_2024_241-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;CNN 2024&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-CNN_2024-241&quot;}}"><a href="#cite_note-CNN_2024-241" id="mwCxw"><span class="mw-reflink-text" id="mwCx0"><span class="cite-bracket" id="mwCx4">[</span>241<span class="cite-bracket" id="mwCx8">]</span></span></a></sup> The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2024_United_States_presidential_election" title="2024 United States presidential election" id="mwCyA">2024 United States presidential election</a> was decided by 1.5% (49.8–48.3%), <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/List_of_United_States_presidential_elections_by_popular_vote_margin" title="List of United States presidential elections by popular vote margin" id="mwCyE">a close race</a> by popular vote margin. In 2024, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Donald_Trump" title="Donald Trump" id="mwCyI">Donald Trump</a> defeated <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Kamala_Harris" title="Kamala Harris" id="mwCyM">Kamala Harris</a> after Harris previously defeated Trump in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2020_United_States_presidential_election" title="2020 United States presidential election" id="mwCyQ">2020</a> as the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Vice_President_of_the_United_States" title="Vice President of the United States" id="mwCyU">Vice presidential</a> candidate, in a quasi-rematch.<sup about="#mwt855" class="mw-ref reference" id="cite_ref-242" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-242&quot;}}"><a href="#cite_note-242" id="mwCyY"><span class="mw-reflink-text" id="mwCyc"><span class="cite-bracket" id="mwCyg">[</span>242<span class="cite-bracket" id="mwCyk">]</span></span></a></sup></p>

<p id="mwCyo"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Western_Europe" title="Western Europe" id="mwCys">Western Europe</a>,<sup about="#mwt858" class="mw-ref reference" id="cite_ref-243" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-243&quot;}}"><a href="#cite_note-243" id="mwCyw"><span class="mw-reflink-text" id="mwCy0"><span class="cite-bracket" id="mwCy4">[</span>243<span class="cite-bracket" id="mwCy8">]</span></span></a></sup> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Canada" title="Canada" id="mwCzA">Canada</a>,<sup about="#mwt861" class="mw-ref reference" id="cite_ref-Canada_2025_244-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Canada 2025&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Canada_2025-244&quot;}}"><a href="#cite_note-Canada_2025-244" id="mwCzE"><span class="mw-reflink-text" id="mwCzI"><span class="cite-bracket" id="mwCzM">[</span>244<span class="cite-bracket" id="mwCzQ">]</span></span></a></sup> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Oceania" title="Oceania" id="mwCzU">Oceania</a> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Australia" title="Australia" id="mwCzY">Australia</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/New_Zealand" title="New Zealand" id="mwCzc">New Zealand</a>) have largely avoided democratic backsliding and the rise of far-right politics,<sup about="#mwt864" class="mw-ref reference" id="cite_ref-245" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-245&quot;}}"><a href="#cite_note-245" id="mwCzg"><span class="mw-reflink-text" id="mwCzk"><span class="cite-bracket" id="mwCzo">[</span>245<span class="cite-bracket" id="mwCzs">]</span></span></a></sup> but even there political instability and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Political_polarization" title="Political polarization" id="mwCzw">polarization</a> has increased.<sup about="#mwt867" class="mw-ref reference" id="cite_ref-246" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-246&quot;}}"><a href="#cite_note-246" id="mwCz0"><span class="mw-reflink-text" id="mwCz4"><span class="cite-bracket" id="mwCz8">[</span>246<span class="cite-bracket" id="mwC0A">]</span></span></a></sup> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Keir_Starmer" title="Keir Starmer" id="mwC0E">Keir Starmer</a> of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/United_Kingdom" title="United Kingdom" id="mwC0I">United Kingdom</a> has seen his approval ratings fall precipitously, prompting <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Resignation_of_Keir_Starmer" title="Resignation of Keir Starmer" class="mw-redirect" id="mwC0M">his resignation</a> in June 2026,<sup about="#mwt870" class="mw-ref reference" id="cite_ref-Starmer_CNBC_247-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Starmer CNBC&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Starmer_CNBC-247&quot;}}"><a href="#cite_note-Starmer_CNBC-247" id="mwC0Q"><span class="mw-reflink-text" id="mwC0U"><span class="cite-bracket" id="mwC0Y">[</span>247<span class="cite-bracket" id="mwC0c">]</span></span></a></sup> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Emmanuel_Macron" title="Emmanuel Macron" id="mwC0g">Emmanuel Macron</a> of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/France" title="France" id="mwC0k">France</a> has faced a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2024–2025_French_political_crisis" title="2024–2025 French political crisis" id="mwC0o">French political crisis</a> due to a hung parliament.<sup about="#mwt873" class="mw-ref reference" id="cite_ref-248" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-248&quot;}}"><a href="#cite_note-248" id="mwC0s"><span class="mw-reflink-text" id="mwC0w"><span class="cite-bracket" id="mwC00">[</span>248<span class="cite-bracket" id="mwC04">]</span></span></a></sup><sup about="#mwt874" class="mw-ref reference" id="cite_ref-German_GC_249-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;German GC&quot;}}"><a href="#cite_note-German_GC-249" id="mwC08"><span class="mw-reflink-text" id="mwC1A"><span class="cite-bracket" id="mwC1E">[</span>249<span class="cite-bracket" id="mwC1I">]</span></span></a></sup> However, in the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2025_Dutch_general_election" title="2025 Dutch general election" id="mwC1M">2025 Dutch general election</a> the liberal <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Democrats_66" title="Democrats 66" id="mwC1Q">Democrats 66</a> party won the most seats.<sup about="#mwt877" class="mw-ref reference" id="cite_ref-NLD_250-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;NLD&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-NLD-250&quot;}}"><a href="#cite_note-NLD-250" id="mwC1U"><span class="mw-reflink-text" id="mwC1Y"><span class="cite-bracket" id="mwC1c">[</span>250<span class="cite-bracket" id="mwC1g">]</span></span></a></sup></p>

<p id="mwC1k">The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Gen_Z_protests_in_Asia" title="Gen Z protests in Asia" id="mwC1o">Gen Z protests in Asia</a> began in 2024, with the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/July_Revolution_(Bangladesh)" title="July Revolution (Bangladesh)" class="mw-redirect" id="mwC1s">July Revolution in Bangladesh</a> being described as the world's first <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Generation_Z" title="Generation Z" id="mwC1w">Generation Z</a> revolution.<sup about="#mwt878" class="mw-ref reference" id="cite_ref-BanglaOust_251-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;BanglaOust&quot;}}"><a href="#cite_note-BanglaOust-251" id="mwC10"><span class="mw-reflink-text" id="mwC14"><span class="cite-bracket" id="mwC18">[</span>251<span class="cite-bracket" id="mwC2A">]</span></span></a></sup> The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2026_Bangladeshi_general_election" title="2026 Bangladeshi general election" id="mwC2E">2026 Bangladeshi</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2026_Nepalese_general_election" title="2026 Nepalese general election" id="mwC2I">Nepalese general elections</a> held which resulted both landslide victories of liberal and reformist opposition parties, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Bangladesh_Nationalist_Party" title="Bangladesh Nationalist Party" id="mwC2M">Bangladesh Nationalist Party</a> and the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Rastriya_Swatantra_Party" title="Rastriya Swatantra Party" id="mwC2Q">Rastriya Swatantra Party</a>, both the elections held since the chaotic Gen Z protests.<sup about="#mwt881" class="mw-ref reference" id="cite_ref-252" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-252&quot;}}"><a href="#cite_note-252" id="mwC2U"><span class="mw-reflink-text" id="mwC2Y"><span class="cite-bracket" id="mwC2c">[</span>252<span class="cite-bracket" id="mwC2g">]</span></span></a></sup><sup about="#mwt884" class="mw-ref reference" id="cite_ref-253" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-253&quot;}}"><a href="#cite_note-253" id="mwC2k"><span class="mw-reflink-text" id="mwC2o"><span class="cite-bracket" id="mwC2s">[</span>253<span class="cite-bracket" id="mwC2w">]</span></span></a></sup></p>

<p id="mwC20">In <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Southeast_Asia" title="Southeast Asia" id="mwC24">Southeast Asia</a> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ASEAN" title="ASEAN" id="mwC28">ASEAN</a>) and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/East_Asia" title="East Asia" id="mwC3A">East Asian</a> countries, political instability has also increased, particularly in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Thailand" title="Thailand" id="mwC3E">Thailand</a>, the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Philippines" title="Philippines" id="mwC3I">Philippines</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japan" title="Japan" id="mwC3M">Japan</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/South_Korea" title="South Korea" id="mwC3Q">South Korea</a>. Thailand and the Philippines had major political crises such as impeachments and dismissals of Prime Ministers <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Srettha_Thavisin" title="Srettha Thavisin" id="mwC3U">Srettha Thavisin</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Paetongtarn_Shinawatra" title="Paetongtarn Shinawatra" id="mwC3Y">Paetongtarn Shinawatra</a>,<sup about="#mwt887" class="mw-ref reference" id="cite_ref-254" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-254&quot;}}"><a href="#cite_note-254" id="mwC3c"><span class="mw-reflink-text" id="mwC3g"><span class="cite-bracket" id="mwC3k">[</span>254<span class="cite-bracket" id="mwC3o">]</span></span></a></sup><sup about="#mwt890" class="mw-ref reference" id="cite_ref-255" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-255&quot;}}"><a href="#cite_note-255" id="mwC3s"><span class="mw-reflink-text" id="mwC3w"><span class="cite-bracket" id="mwC30">[</span>255<span class="cite-bracket" id="mwC34">]</span></span></a></sup><sup about="#mwt893" class="mw-ref reference" id="cite_ref-256" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-256&quot;}}"><a href="#cite_note-256" id="mwC38"><span class="mw-reflink-text" id="mwC4A"><span class="cite-bracket" id="mwC4E">[</span>256<span class="cite-bracket" id="mwC4I">]</span></span></a></sup> as well as the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/First_Impeachment_of_Sara_Duterte" title="First Impeachment of Sara Duterte" class="mw-redirect" id="mwC4M">impeachment of Sara Duterte</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Arrest_of_Rodrigo_Duterte" title="Arrest of Rodrigo Duterte" id="mwC4Q">arrest of Rodrigo Duterte</a>.<sup about="#mwt896" class="mw-ref reference" id="cite_ref-257" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-257&quot;}}"><a href="#cite_note-257" id="mwC4U"><span class="mw-reflink-text" id="mwC4Y"><span class="cite-bracket" id="mwC4c">[</span>257<span class="cite-bracket" id="mwC4g">]</span></span></a></sup><sup about="#mwt899" class="mw-ref reference" id="cite_ref-258" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-258&quot;}}"><a href="#cite_note-258" id="mwC4k"><span class="mw-reflink-text" id="mwC4o"><span class="cite-bracket" id="mwC4s">[</span>258<span class="cite-bracket" id="mwC4w">]</span></span></a></sup> South Korea had a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2024_South_Korean_martial_law_crisis" title="2024 South Korean martial law crisis" id="mwC40">martial law crisis in 2024</a> resulted the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Impeachment_of_Yoon_Suk_Yeol" title="Impeachment of Yoon Suk Yeol" id="mwC44">impeachment of Yoon Suk Yeol</a> for eight years since <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Impeachment_of_Park_Geun-hye" title="Impeachment of Park Geun-hye" id="mwC48">Park Geun-hye</a> in 2017,<sup about="#mwt900" class="mw-ref reference" id="cite_ref-South_Korea_2024_259-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;South Korea 2024&quot;}}"><a href="#cite_note-South_Korea_2024-259" id="mwC5A"><span class="mw-reflink-text" id="mwC5E"><span class="cite-bracket" id="mwC5I">[</span>259<span class="cite-bracket" id="mwC5M">]</span></span></a></sup><sup about="#mwt903" class="mw-ref reference" id="cite_ref-260" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-260&quot;}}"><a href="#cite_note-260" id="mwC5Q"><span class="mw-reflink-text" id="mwC5U"><span class="cite-bracket" id="mwC5Y">[</span>260<span class="cite-bracket" id="mwC5c">]</span></span></a></sup><sup about="#mwt906" class="mw-ref reference" id="cite_ref-261" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-261&quot;}}"><a href="#cite_note-261" id="mwC5g"><span class="mw-reflink-text" id="mwC5k"><span class="cite-bracket" id="mwC5o">[</span>261<span class="cite-bracket" id="mwC5s">]</span></span></a></sup> while in Japan was marred by anti-government protests and riots, the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Liberal_Democratic_Party_(Japan)" title="Liberal Democratic Party (Japan)" id="mwC5w">LDP</a> lost its majority in both houses of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/National_Diet" title="National Diet" id="mwC50">National Diet</a> and regained in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2026_Japanese_general_election" title="2026 Japanese general election" id="mwC54">2026</a> for a four-year electoral comeback since <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2021_Japanese_general_election" title="2021 Japanese general election" id="mwC58">2021</a>.<sup about="#mwt909" class="mw-ref reference" id="cite_ref-Japan_2025_262-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Japan 2025&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Japan_2025-262&quot;}}"><a href="#cite_note-Japan_2025-262" id="mwC6A"><span class="mw-reflink-text" id="mwC6E"><span class="cite-bracket" id="mwC6I">[</span>262<span class="cite-bracket" id="mwC6M">]</span></span></a></sup><sup about="#mwt912" class="mw-ref reference" id="cite_ref-263" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-263&quot;}}"><a href="#cite_note-263" id="mwC6Q"><span class="mw-reflink-text" id="mwC6U"><span class="cite-bracket" id="mwC6Y">[</span>263<span class="cite-bracket" id="mwC6c">]</span></span></a></sup> The Bangkok–Manila–Seoul–Tokyo Frontline led as the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/NATO" title="NATO" id="mwC6g">NATO</a>–US defence initiative focused to prevent <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2026_Iran_war" title="2026 Iran war" id="mwC6k">threats from Iran</a>, revenge with the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Russo-Ukrainian_war_(2022–present)" title="Russo-Ukrainian war (2022–present)" id="mwC6o">Russo-Ukrainian war</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Cross-strait_relations" title="Cross-strait relations" id="mwC6s">Chinese invasion of Taiwan</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Territorial_disputes_in_the_South_China_Sea" title="Territorial disputes in the South China Sea" id="mwC6w">South China Sea dispute</a>, led by <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Anutin_Charnvirakul" title="Anutin Charnvirakul" id="mwC60">Anutin Charnvirakul</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Bongbong_Marcos" title="Bongbong Marcos" id="mwC64">Bongbong Marcos</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Lee_Jae_Myung" title="Lee Jae Myung" id="mwC68">Lee Jae Myung</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Sanae_Takaichi" title="Sanae Takaichi" id="mwC7A">Sanae Takaichi</a>.<sup about="#mwt915" class="mw-ref reference" id="cite_ref-264" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-264&quot;}}"><a href="#cite_note-264" id="mwC7E"><span class="mw-reflink-text" id="mwC7I"><span class="cite-bracket" id="mwC7M">[</span>264<span class="cite-bracket" id="mwC7Q">]</span></span></a></sup><sup about="#mwt918" class="mw-ref reference" id="cite_ref-265" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-265&quot;}}"><a href="#cite_note-265" id="mwC7U"><span class="mw-reflink-text" id="mwC7Y"><span class="cite-bracket" id="mwC7c">[</span>265<span class="cite-bracket" id="mwC7g">]</span></span></a></sup> The initiative was implemented after a turbulent political crises, US Secretary of Defense <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pete_Hegseth" title="Pete Hegseth" id="mwC7k">Pete Hegseth</a> made positive views of a frontline along with the Pacific Squad members from Australia, India, and Canada.<sup about="#mwt921" class="mw-ref reference" id="cite_ref-266" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-266&quot;}}"><a href="#cite_note-266" id="mwC7o"><span class="mw-reflink-text" id="mwC7s"><span class="cite-bracket" id="mwC7w">[</span>266<span class="cite-bracket" id="mwC70">]</span></span></a></sup></p>

<p id="mwC74"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Zohran_Mamdani" title="Zohran Mamdani" id="mwC78">Zohran Mamdani</a> was <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2025_New_York_City_mayoral_election" title="2025 New York City mayoral election" id="mwC8A">elected mayor of New York City in 2025</a> at the age of 34, defeating former <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Governor_of_New_York" title="Governor of New York" id="mwC8E">Governor of New York</a> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Andrew_Cuomo" title="Andrew Cuomo" id="mwC8I">Andrew Cuomo</a>. Mamdani became the first Muslim, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Indians_in_Uganda" title="Indians in Uganda" id="mwC8M">Indian-Ugandan</a>, and first <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Millennials" title="Millennials" id="mwC8Q">millennial</a> mayor of New York City.<sup about="#mwt924" class="mw-ref reference" id="cite_ref-267" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-267&quot;}}"><a href="#cite_note-267" id="mwC8U"><span class="mw-reflink-text" id="mwC8Y"><span class="cite-bracket" id="mwC8c">[</span>267<span class="cite-bracket" id="mwC8g">]</span></span></a></sup><sup about="#mwt927" class="mw-ref reference" id="cite_ref-268" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-268&quot;}}"><a href="#cite_note-268" id="mwC8k"><span class="mw-reflink-text" id="mwC8o"><span class="cite-bracket" id="mwC8s">[</span>268<span class="cite-bracket" id="mwC8w">]</span></span></a></sup></p>

<section data-mw-section-id="8" id="mwC80" aria-labelledby="Political_economic_trends"><div class="mw-heading mw-heading4"><h4 id="Political_economic_trends">Political economic trends</h4><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2020s&amp;action=edit&amp;section=8" title="Edit section: Political economic trends"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwC84">The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2021-2023_inflation_surge" title="2021-2023 inflation surge" class="mw-redirect" id="mwC88">2021-2023 inflation surge</a> discredited or weakened nearly all governing parties and leaders during the early 2020s, across ideological lines.<sup about="#mwt930" class="mw-ref reference" id="cite_ref-269" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-269&quot;}}"><a href="#cite_note-269" id="mwC9A"><span class="mw-reflink-text" id="mwC9E"><span class="cite-bracket" id="mwC9I">[</span>269<span class="cite-bracket" id="mwC9M">]</span></span></a></sup> In 2025, Trump <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Tariffs_in_the_second_Trump_administration" title="Tariffs in the second Trump administration" id="mwC9Q">triggered a global trade war</a>, repudiating <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Neoliberalism" title="Neoliberalism" id="mwC9U">neoliberalism</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Free_trade" title="Free trade" id="mwC9Y">free trade</a>,<sup about="#mwt933" class="mw-ref reference" id="cite_ref-Gerstle2022_270-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Gerstle2022&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Gerstle2022-270&quot;}}"><a href="#cite_note-Gerstle2022-270" id="mwC9c"><span class="mw-reflink-text" id="mwC9g"><span class="cite-bracket" id="mwC9k">[</span>270<span class="cite-bracket" id="mwC9o">]</span></span></a></sup><sup about="#mwt936" class="mw-ref reference" id="cite_ref-271" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-271&quot;}}"><a href="#cite_note-271" id="mwC9s"><span class="mw-reflink-text" id="mwC9w"><span class="cite-bracket" id="mwC90">[</span>271<span class="cite-bracket" id="mwC94">]</span></span></a></sup> in favour of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mercantilism" title="Mercantilism" id="mwC98">mercantilism</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Protectionism" title="Protectionism" id="mwC-A">protectionism</a>. This was a sea change in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Republican_Party_(United_States)" title="Republican Party (United States)" id="mwC-E">Republican Party</a> ideology, raising tariffs to the highest levels since the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Smoot–Hawley_Tariff_Act" title="Smoot–Hawley Tariff Act" id="mwC-I">Smoot–Hawley Tariff Act</a> of 1930.<sup about="#mwt939" class="mw-ref reference" id="cite_ref-272" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-272&quot;}}"><a href="#cite_note-272" id="mwC-M"><span class="mw-reflink-text" id="mwC-Q"><span class="cite-bracket" id="mwC-U">[</span>272<span class="cite-bracket" id="mwC-Y">]</span></span></a></sup><sup about="#mwt942" class="mw-ref reference" id="cite_ref-273" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-273&quot;}}"><a href="#cite_note-273" id="mwC-c"><span class="mw-reflink-text" id="mwC-g"><span class="cite-bracket" id="mwC-k">[</span>273<span class="cite-bracket" id="mwC-o">]</span></span></a></sup></p>

<p id="mwC-s">Despite being a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Capitalism" title="Capitalism" id="mwC-w">capitalist</a> country, the relationship between income and voter support in the United States inverted in 2024, because of educational polarization. Kamala Harris won voters making over $100,000 and $200,000 a year, but lost the election.<sup about="#mwt943" class="mw-ref reference" id="cite_ref-Well-to-Do_274-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Well-to-Do&quot;}}"><a href="#cite_note-Well-to-Do-274" id="mwC-0"><span class="mw-reflink-text" id="mwC-4"><span class="cite-bracket" id="mwC-8">[</span>274<span class="cite-bracket" id="mwC_A">]</span></span></a></sup> Similar trends have occurred in Canada and the United Kingdom, as <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Centre-left_politics" title="Centre-left politics" id="mwC_E">centre-left</a> parties lose the support of those without college degrees,<sup about="#mwt946" class="mw-ref reference" id="cite_ref-275" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-275&quot;}}"><a href="#cite_note-275" id="mwC_I"><span class="mw-reflink-text" id="mwC_M"><span class="cite-bracket" id="mwC_Q">[</span>275<span class="cite-bracket" id="mwC_U">]</span></span></a></sup><sup about="#mwt949" class="mw-ref reference" id="cite_ref-276" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-276&quot;}}"><a href="#cite_note-276" id="mwC_Y"><span class="mw-reflink-text" id="mwC_c"><span class="cite-bracket" id="mwC_g">[</span>276<span class="cite-bracket" id="mwC_k">]</span></span></a></sup> including many with lower incomes.<sup about="#mwt950" class="mw-ref reference" id="cite_ref-Canada_2025_244-1" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Canada 2025&quot;}}"><a href="#cite_note-Canada_2025-244" id="mwC_o"><span class="mw-reflink-text" id="mwC_s"><span class="cite-bracket" id="mwC_w">[</span>244<span class="cite-bracket" id="mwC_0">]</span></span></a></sup> The right-wing populist <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Reform_UK" title="Reform UK" id="mwC_4">Reform UK</a> party has attracted lower-income voters who tend to be older, did not graduate from university, and male.<sup about="#mwt953" class="mw-ref reference" id="cite_ref-277" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-277&quot;}}"><a href="#cite_note-277" id="mwC_8"><span class="mw-reflink-text" id="mwDAA"><span class="cite-bracket" id="mwDAE">[</span>277<span class="cite-bracket" id="mwDAI">]</span></span></a></sup> As early as 2018, French economist <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Thomas_Piketty" title="Thomas Piketty" id="mwDAM">Thomas Piketty</a> had predicted that centre-left parties would come to represent women, the highly educated and high-income,<sup about="#mwt956" class="mw-ref reference" id="cite_ref-278" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-278&quot;}}"><a href="#cite_note-278" id="mwDAQ"><span class="mw-reflink-text" id="mwDAU"><span class="cite-bracket" id="mwDAY">[</span>278<span class="cite-bracket" id="mwDAc">]</span></span></a></sup> and ethnic minorities, instead of those with low incomes.<sup about="#mwt959" class="mw-ref reference" id="cite_ref-279" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-279&quot;}}"><a href="#cite_note-279" id="mwDAg"><span class="mw-reflink-text" id="mwDAk"><span class="cite-bracket" id="mwDAo">[</span>279<span class="cite-bracket" id="mwDAs">]</span></span></a></sup> Kamala Harris's strongest voters were women with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Postgraduate_education" title="Postgraduate education" id="mwDAw">graduate degrees</a> and Black women, herself a Black woman with a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Juris_Doctor" title="Juris Doctor" id="mwDA0">Juris Doctor</a>.<sup about="#mwt962" class="mw-ref reference" id="cite_ref-Well-to-Do_274-1" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Well-to-Do&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Well-to-Do-274&quot;}}"><a href="#cite_note-Well-to-Do-274" id="mwDA4"><span class="mw-reflink-text" id="mwDA8"><span class="cite-bracket" id="mwDBA">[</span>274<span class="cite-bracket" id="mwDBE">]</span></span></a></sup></p>

<p id="mwDBI">The Republican Party's core demographics changed to becoming a party primarily of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Blue-collar_worker" title="Blue-collar worker" id="mwDBM">men without college degrees</a>, including <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Hispanic_and_Latino_Americans" title="Hispanic and Latino Americans" id="mwDBQ">Hispanic</a> men.<sup about="#mwt963" class="mw-ref reference" id="cite_ref-gap_within_the_gender_gap_240-1" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;gap within the gender gap&quot;}}"><a href="#cite_note-gap_within_the_gender_gap-240" id="mwDBU"><span class="mw-reflink-text" id="mwDBY"><span class="cite-bracket" id="mwDBc">[</span>240<span class="cite-bracket" id="mwDBg">]</span></span></a></sup><sup about="#mwt966" class="mw-ref reference" id="cite_ref-Hispanic_men,_white_women_280-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Hispanic men, white women&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Hispanic_men,_white_women-280&quot;}}"><a href="#cite_note-Hispanic_men,_white_women-280" id="mwDBk"><span class="mw-reflink-text" id="mwDBo"><span class="cite-bracket" id="mwDBs">[</span>280<span class="cite-bracket" id="mwDBw">]</span></span></a></sup> The Democratic Party's core demographics changed to becoming a party primarily of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/White-collar_worker" title="White-collar worker" id="mwDB0">women with college degrees</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Black_women_in_American_politics" title="Black women in American politics" id="mwDB4">Black women</a>. Hispanic men voted to the right of White women in 2024.<sup about="#mwt967" class="mw-ref reference" id="cite_ref-Hispanic_men,_white_women_280-1" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Hispanic men, white women&quot;}}"><a href="#cite_note-Hispanic_men,_white_women-280" id="mwDB8"><span class="mw-reflink-text" id="mwDCA"><span class="cite-bracket" id="mwDCE">[</span>280<span class="cite-bracket" id="mwDCI">]</span></span></a></sup> Women without college degrees and men with college degrees were both fairly evenly split.<sup about="#mwt968" class="mw-ref reference" id="cite_ref-gap_within_the_gender_gap_240-2" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;gap within the gender gap&quot;}}"><a href="#cite_note-gap_within_the_gender_gap-240" id="mwDCM"><span class="mw-reflink-text" id="mwDCQ"><span class="cite-bracket" id="mwDCU">[</span>240<span class="cite-bracket" id="mwDCY">]</span></span></a></sup></p>

<p id="mwDCc">Former <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Communism" title="Communism" id="mwDCg">communist</a> countries, particularly in the former <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Eastern_Bloc" title="Eastern Bloc" id="mwDCk">Eastern Bloc</a>, have pivoted towards <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/National_conservatism" title="National conservatism" id="mwDCo">national conservatism</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Far-right_politics" title="Far-right politics" id="mwDCs">far-right politics</a>. This includes <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Russia" title="Russia" id="mwDCw">Russia</a> itself under the authoritarian dictatorship of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Vladimir_Putin" title="Vladimir Putin" id="mwDC0">Vladimir Putin</a>. Putin launched the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022_Russian_invasion_of_Ukraine" title="2022 Russian invasion of Ukraine" id="mwDC4">2022 Russian invasion of Ukraine</a> with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Russian_irredentism" title="Russian irredentism" class="mw-redirect" id="mwDC8">irredentist</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Putinism" title="Putinism" id="mwDDA">Putinist</a> motives.<sup about="#mwt971" class="mw-ref reference" id="cite_ref-281" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-281&quot;}}"><a href="#cite_note-281" id="mwDDE"><span class="mw-reflink-text" id="mwDDI"><span class="cite-bracket" id="mwDDM">[</span>281<span class="cite-bracket" id="mwDDQ">]</span></span></a></sup><sup about="#mwt974" class="mw-ref reference" id="cite_ref-282" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-282&quot;}}"><a href="#cite_note-282" id="mwDDU"><span class="mw-reflink-text" id="mwDDY"><span class="cite-bracket" id="mwDDc">[</span>282<span class="cite-bracket" id="mwDDg">]</span></span></a></sup> The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Russo-Ukrainian_war_(2022–present)" title="Russo-Ukrainian war (2022–present)" id="mwDDk">Russo-Ukrainian war (2022–present)</a> represents the deadliest war in Eastern Europe since the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Eastern_Front_(World_War_II)" title="Eastern Front (World War II)" id="mwDDo">Eastern Front of World War II</a> and the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Russian_Civil_War" title="Russian Civil War" id="mwDDs">Russian Civil War</a>.<sup about="#mwt977" class="mw-ref reference" id="cite_ref-283" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-283&quot;}}"><a href="#cite_note-283" id="mwDDw"><span class="mw-reflink-text" id="mwDD0"><span class="cite-bracket" id="mwDD4">[</span>283<span class="cite-bracket" id="mwDD8">]</span></span></a></sup> But the trend was broader, also including <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Viktor_Orbán" title="Viktor Orbán" id="mwDEA">Viktor Orbán</a> in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Hungary" title="Hungary" id="mwDEE">Hungary</a>, the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Law_and_Justice" title="Law and Justice" id="mwDEI">Law and Justice</a> party in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Poland" title="Poland" id="mwDEM">Poland</a>, and the far-right <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Alternative_for_Germany" title="Alternative for Germany" id="mwDEQ">Alternative for Germany</a> party, which is strongest in the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/New_states_of_Germany" title="New states of Germany" id="mwDEU">New states of Germany</a> that once comprised <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/East_Germany" title="East Germany" id="mwDEY">East Germany</a>.<sup about="#mwt980" class="mw-ref reference" id="cite_ref-Global_Divide_284-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Global Divide&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Global_Divide-284&quot;}}"><a href="#cite_note-Global_Divide-284" id="mwDEc"><span class="mw-reflink-text" id="mwDEg"><span class="cite-bracket" id="mwDEk">[</span>284<span class="cite-bracket" id="mwDEo">]</span></span></a></sup></p>

</section><section data-mw-section-id="9" id="mwDEs" aria-labelledby="Electoral_trends"><div class="mw-heading mw-heading4"><h4 id="Electoral_trends">Electoral trends</h4><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2020s&amp;action=edit&amp;section=9" title="Edit section: Electoral trends"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<span class="mw-empty-elt" about="#mwt981" typeof="mw:Transclusion" id="mwDEw" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:multiple image&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;\n&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot; title             = US presidential candidates in the 2020s\n&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot; direction         = horizontal\n&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot; total_width       = 350\n&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot; image1            = January 2025 Official Presidential Portrait of Donald J. Trump.jpg\n&quot;},&quot;6&quot;:{&quot;wt&quot;:&quot; image2            = Kamala Harris Vice Presidential Portrait (cropped).jpg\n&quot;},&quot;7&quot;:{&quot;wt&quot;:&quot; footer            = {{center|'''Left to right:'''}}National conservative and 45th &amp; 47th [[President of the United States]] [[Donald Trump]] (2017–2021, 2025–present); Liberal and 49th [[Vice President of the United States]] [[Kamala Harris]] (2021–2025). They defeated each other in the [[2020 United States presidential election|2020]] and [[2024 United States presidential election|2024]] United States presidential elections.\n&quot;}},&quot;i&quot;:0}}]}"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1349637415/mw-parser-output/.tmulti" about="#mwt982" typeof="mw:Extension/templatestyles" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Multiple image/styles.css&quot;,&quot;wrapper&quot;:&quot;.tmulti&quot;},&quot;body&quot;:{&quot;extsrc&quot;:&quot;&quot;}}"></span><div class="thumb tmulti floatright" about="#mwt981"><div class="thumbinner multiimageinner" style="width:342px;max-width:342px"><div class="trow"><div class="theader">US presidential candidates in the 2020s</div></div><div class="trow"><div class="tsingle" style="width:172px;max-width:172px"><div class="thumbimage" style="height:219px;overflow:hidden"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:January_2025_Official_Presidential_Portrait_of_Donald_J._Trump.jpg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:January_2025_Official_Presidential_Portrait_of_Donald_J._Trump.jpg" src="//upload.wikimedia.org/wikipedia/commons/thumb/1/19/January_2025_Official_Presidential_Portrait_of_Donald_J._Trump.jpg/250px-January_2025_Official_Presidential_Portrait_of_Donald_J._Trump.jpg" decoding="async" data-file-width="2550" data-file-height="3300" data-file-type="bitmap" height="220" width="170" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/1/19/January_2025_Official_Presidential_Portrait_of_Donald_J._Trump.jpg/500px-January_2025_Official_Presidential_Portrait_of_Donald_J._Trump.jpg 2x" class="mw-file-element"></a></span></div></div><div class="tsingle" style="width:166px;max-width:166px"><div class="thumbimage" style="height:219px;overflow:hidden"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:Kamala_Harris_Vice_Presidential_Portrait_(cropped).jpg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Kamala_Harris_Vice_Presidential_Portrait_(cropped).jpg" src="//upload.wikimedia.org/wikipedia/commons/thumb/b/b9/Kamala_Harris_Vice_Presidential_Portrait_%28cropped%29.jpg/250px-Kamala_Harris_Vice_Presidential_Portrait_%28cropped%29.jpg" decoding="async" data-file-width="1537" data-file-height="2051" data-file-type="bitmap" height="219" width="164" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/b/b9/Kamala_Harris_Vice_Presidential_Portrait_%28cropped%29.jpg/330px-Kamala_Harris_Vice_Presidential_Portrait_%28cropped%29.jpg 2x" class="mw-file-element"></a></span></div></div></div><div class="trow" style="display:flex"><div class="thumbcaption"><div class="center"><b>Left to right:</b></div>National conservative and 45th &amp; 47th <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/President_of_the_United_States" title="President of the United States">President of the United States</a> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Donald_Trump" title="Donald Trump">Donald Trump</a> (2017–2021, 2025–present); Liberal and 49th <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Vice_President_of_the_United_States" title="Vice President of the United States">Vice President of the United States</a> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Kamala_Harris" title="Kamala Harris">Kamala Harris</a> (2021–2025). They defeated each other in the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2020_United_States_presidential_election" title="2020 United States presidential election">2020</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2024_United_States_presidential_election" title="2024 United States presidential election">2024</a> United States presidential elections.</div></div></div></div><span class="mw-empty-elt" about="#mwt981"><link rel="mw:PageProp/Category" href="./Category:Pages_using_multiple_image_with_auto_scaled_images"></span>

<figure typeof="mw:File/Thumb" id="mwDE0"><a href="https://en.wikipedia.org/wiki/File:U.S._Presidential_Election_Swing_by_County_from_2020_to_2024.svg" class="mw-file-description" id="mwDE4"><img resource="https://en.wikipedia.org/wiki/File:U.S._Presidential_Election_Swing_by_County_from_2020_to_2024.svg" src="//upload.wikimedia.org/wikipedia/commons/thumb/6/60/U.S._Presidential_Election_Swing_by_County_from_2020_to_2024.svg/330px-U.S._Presidential_Election_Swing_by_County_from_2020_to_2024.svg.png" decoding="async" data-file-width="555" data-file-height="352" data-file-type="drawing" height="190" width="300" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/6/60/U.S._Presidential_Election_Swing_by_County_from_2020_to_2024.svg/960px-U.S._Presidential_Election_Swing_by_County_from_2020_to_2024.svg.png 2x" class="mw-file-element" id="mwDE8"></a><figcaption id="mwDFA">In the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2024_United_States_presidential_election" title="2024 United States presidential election" id="mwDFE">2024 U.S. presidential election</a>, all 50 states and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/District_of_Columbia" title="District of Columbia" class="mw-redirect" id="mwDFI">D.C.</a> swung rightward, as did around 90% of counties.<sup about="#mwt985" class="mw-ref reference" id="cite_ref-Red_Shift_285-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Red Shift&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Red_Shift-285&quot;}}"><a href="#cite_note-Red_Shift-285" id="mwDFM"><span class="mw-reflink-text" id="mwDFQ"><span class="cite-bracket" id="mwDFU">[</span>285<span class="cite-bracket" id="mwDFY">]</span></span></a></sup></figcaption></figure>

<p id="mwDFc">Having suffered decline in the years after the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Great_Recession" title="Great Recession" id="mwDFg">Great Recession</a>, the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Centre-left_politics" title="Centre-left politics" id="mwDFk">centre-left politics</a> and the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/1990s#Political_trends" title="1990s" id="mwDFo">1990s political model</a> (like <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Progressivism" title="Progressivism" id="mwDFs">progressivism</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Liberalism" title="Liberalism" id="mwDFw">liberalism</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Social_democracy" title="Social democracy" id="mwDF0">social democracy</a> policies) experienced a resurgence across <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Europe" title="Europe" id="mwDF4">Europe</a> and the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Anglosphere" title="Anglosphere" id="mwDF8">Anglosphere</a> in the early 2020s, with <i id="mwDGA"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/New_Statesman" title="New Statesman" id="mwDGE">New Statesman</a></i> suggesting various causes, including natural shifts in the electoral cycle and conservatives' unpopularity among university graduates and voters under the age of 40.<sup about="#mwt988" class="mw-ref reference" id="cite_ref-286" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-286&quot;}}"><a href="#cite_note-286" id="mwDGI"><span class="mw-reflink-text" id="mwDGM"><span class="cite-bracket" id="mwDGQ">[</span>286<span class="cite-bracket" id="mwDGU">]</span></span></a></sup></p>

<p id="mwDGY">The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2020_United_States_presidential_election" title="2020 United States presidential election" id="mwDGc">2020 United States presidential election</a> saw the election of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Kamala_Harris" title="Kamala Harris" id="mwDGg">Kamala Harris</a> as vice president was widely regarded as a historic milestone, as the first woman and multicultural (African American and Asian American) to hold the office, reflecting broader trends toward increased diversity and representation in American politics, culture and society.<sup about="#mwt991" class="mw-ref reference" id="cite_ref-287" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-287&quot;}}"><a href="#cite_note-287" id="mwDGk"><span class="mw-reflink-text" id="mwDGo"><span class="cite-bracket" id="mwDGs">[</span>287<span class="cite-bracket" id="mwDGw">]</span></span></a></sup> She was conceded defeat as a presidential candidate at the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2024_United_States_presidential_election" title="2024 United States presidential election" id="mwDG0">2024 United States presidential election</a> to  Donald Trump.<sup about="#mwt994" class="mw-ref reference" id="cite_ref-288" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-288&quot;}}"><a href="#cite_note-288" id="mwDG4"><span class="mw-reflink-text" id="mwDG8"><span class="cite-bracket" id="mwDHA">[</span>288<span class="cite-bracket" id="mwDHE">]</span></span></a></sup></p>

<p id="mwDHI">Following the election of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Donald_Trump" title="Donald Trump" id="mwDHM">Donald Trump</a> in the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2024_United_States_presidential_election" title="2024 United States presidential election" id="mwDHQ">2024 United States presidential election</a>, the mid-2020s saw the resurgence of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Right-wing_populism" title="Right-wing populism" id="mwDHU">right-wing populism</a> and the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/1980s#Politics_and_wars" title="1980s" id="mwDHY">1980s political model</a> (like <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Trumpist" title="Trumpist" class="mw-redirect" id="mwDHc">Trumpist</a> ideologies of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Conservatism" title="Conservatism" id="mwDHg">conservatism</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Social_conservatism" title="Social conservatism" id="mwDHk">social conservatism</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Anti-communism" title="Anti-communism" id="mwDHo">anti-communist</a> policies).<sup about="#mwt997" class="mw-ref reference" id="cite_ref-289" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-289&quot;}}"><a href="#cite_note-289" id="mwDHs"><span class="mw-reflink-text" id="mwDHw"><span class="cite-bracket" id="mwDH0">[</span>289<span class="cite-bracket" id="mwDH4">]</span></span></a></sup><sup about="#mwt1000" class="mw-ref reference" id="cite_ref-290" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-290&quot;}}"><a href="#cite_note-290" id="mwDH8"><span class="mw-reflink-text" id="mwDIA"><span class="cite-bracket" id="mwDIE">[</span>290<span class="cite-bracket" id="mwDII">]</span></span></a></sup></p>

<p id="mwDIM"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Political_polarization" title="Political polarization" id="mwDIQ">Political polarization</a> has risen in other Western countries, not just the United States.<sup about="#mwt1003" class="mw-ref reference" id="cite_ref-291" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-291&quot;}}"><a href="#cite_note-291" id="mwDIU"><span class="mw-reflink-text" id="mwDIY"><span class="cite-bracket" id="mwDIc">[</span>291<span class="cite-bracket" id="mwDIg">]</span></span></a></sup> while those who have very unfavourable opinions of the opposing party are at record highs as of 2022.<sup about="#mwt1006" class="mw-ref reference" id="cite_ref-292" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-292&quot;}}"><a href="#cite_note-292" id="mwDIk"><span class="mw-reflink-text" id="mwDIo"><span class="cite-bracket" id="mwDIs">[</span>292<span class="cite-bracket" id="mwDIw">]</span></span></a></sup> <i id="mwDI0"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/The_New_York_Times" title="The New York Times" id="mwDI4">The New York Times</a></i> characterized this as part of a "new global divide", between <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/National_conservatism" title="National conservatism" id="mwDI8">national conservatism</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Social_conservatism" title="Social conservatism" id="mwDJA">social conservatism</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Right-wing_populism" title="Right-wing populism" id="mwDJE">right-wing populism</a> versus <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Social_democracy" title="Social democracy" id="mwDJI">social democracy</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Liberalism" title="Liberalism" id="mwDJM">liberalism</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pro-Europeanism" title="Pro-Europeanism" id="mwDJQ">pro-Europeanism</a> (in Europe) or ethnic minorities such as <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/African_Americans" title="African Americans" id="mwDJU">African Americans</a> (in the United States).<sup about="#mwt1007" class="mw-ref reference" id="cite_ref-Global_Divide_284-1" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Global Divide&quot;}}"><a href="#cite_note-Global_Divide-284" id="mwDJY"><span class="mw-reflink-text" id="mwDJc"><span class="cite-bracket" id="mwDJg">[</span>284<span class="cite-bracket" id="mwDJk">]</span></span></a></sup> The 2020s saw rise of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Far-right_politics" title="Far-right politics" id="mwDJo">far-right</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Ultranationalism" title="Ultranationalism" id="mwDJs">ultranationalist</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Libertarianism" title="Libertarianism" id="mwDJw">libertarian</a>, or right-wing populist political parties in the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Western_Bloc" title="Western Bloc" id="mwDJ0">Western Bloc</a> and C12 member states, such as the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/People's_Party_of_Canada" title="People's Party of Canada" id="mwDJ4">People's Party of Canada</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Liberal_Party_(Brazil,_2006)" title="Liberal Party (Brazil, 2006)" id="mwDJ8">Liberal Party of Brazil</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/National_Rally" title="National Rally" id="mwDKA">National Rally</a> (France), <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Alternative_for_Germany" title="Alternative for Germany" id="mwDKE">Alternative for Germany</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Reform_UK" title="Reform UK" id="mwDKI">Reform UK</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Reform_Party_(South_Korea)" title="Reform Party (South Korea)" id="mwDKM">Reform Party</a> (South Korea), <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Sanseitō" title="Sanseitō" id="mwDKQ">Sanseitō</a> (Japan), and in some cases, the Trump-faction of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Republican_Party_(United_States)" title="Republican Party (United States)" id="mwDKU">Republican Party</a>.<sup about="#mwt1010" class="mw-ref reference" id="cite_ref-Beauchamp_2024_293-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Beauchamp 2024&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Beauchamp_2024-293&quot;}}"><a href="#cite_note-Beauchamp_2024-293" id="mwDKY"><span class="mw-reflink-text" id="mwDKc"><span class="cite-bracket" id="mwDKg">[</span>293<span class="cite-bracket" id="mwDKk">]</span></span></a></sup> Incumbent parties in all 10 major counties that held elections in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2024" title="2024" id="mwDKo">2024</a> lost, the first time this has ever happened since 1905. All 50 states and the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/District_of_Columbia" title="District of Columbia" class="mw-redirect" id="mwDKs">District of Columbia</a> shifted towards the Republican Party in the 2024 U.S. presidential election.<sup about="#mwt1013" class="mw-ref reference" id="cite_ref-graveyard_294-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;graveyard&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-graveyard-294&quot;}}"><a href="#cite_note-graveyard-294" id="mwDKw"><span class="mw-reflink-text" id="mwDK0"><span class="cite-bracket" id="mwDK4">[</span>294<span class="cite-bracket" id="mwDK8">]</span></span></a></sup></p>

</section><section data-mw-section-id="10" id="mwDLA" aria-labelledby="Deaths"><div class="mw-heading mw-heading4"><h4 id="Deaths">Deaths</h4><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2020s&amp;action=edit&amp;section=10" title="Edit section: Deaths"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwDLE">Sitting leaders that died such as <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Qaboos_bin_Said" title="Qaboos bin Said" id="mwDLI">Qaboos bin Said</a> of Oman, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pierre_Nkurunziza" title="Pierre Nkurunziza" id="mwDLM">Pierre Nkurunziza</a> of Burundi, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Amadou_Gon_Coulibaly" title="Amadou Gon Coulibaly" id="mwDLQ">Amadou Gon Coulibaly</a> of the Ivory Coast, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Sabah_al-Ahmad_al-Jaber_al-Sabah" title="Sabah al-Ahmad al-Jaber al-Sabah" class="mw-redirect" id="mwDLU">Sabah al-Ahmad al-Jaber al-Sabah</a> of Kuwait, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Khalifa_bin_Salman_Al_Khalifa" title="Khalifa bin Salman Al Khalifa" id="mwDLY">Khalifa bin Salman Al Khalifa</a> of Bahrain, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/John_Magufuli" title="John Magufuli" id="mwDLc">John Magufuli</a> of Tanzania, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Idriss_Déby" title="Idriss Déby" id="mwDLg">Idriss Déby</a> of Chad, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Jovenel_Moïse" title="Jovenel Moïse" id="mwDLk">Jovenel Moïse</a> of Haiti, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Khalifa_bin_Zayed_Al_Nahyan" title="Khalifa bin Zayed Al Nahyan" id="mwDLo">Khalifa bin Zayed Al Nahyan</a> of the United Arab Emirates, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Elizabeth_II" title="Elizabeth II" id="mwDLs">Elizabeth II</a> of the United Kingdom, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Nawaf_Al-Ahmad_Al-Jaber_Al-Sabah" title="Nawaf Al-Ahmad Al-Jaber Al-Sabah" id="mwDLw">Nawaf Al-Ahmad Al-Jaber Al-Sabah</a> of Kuwait, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Hage_Geingob" title="Hage Geingob" id="mwDL0">Hage Geingob</a> of Namibia, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Ebrahim_Raisi" title="Ebrahim Raisi" id="mwDL4">Ebrahim Raisi</a> of Iran, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Nguyễn_Phú_Trọng" title="Nguyễn Phú Trọng" id="mwDL8">Nguyễn Phú Trọng</a> of Vietnam, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Didier_Guillaume" title="Didier Guillaume" id="mwDMA">Didier Guillaume</a> of Monaco, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pope_Francis" title="Pope Francis" id="mwDME">Pope Francis</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Ali_Khamenei" title="Ali Khamenei" id="mwDMI">Ali Khamenei</a> of Iran.<sup about="#mwt1016" class="mw-ref reference" id="cite_ref-295" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-295&quot;}}"><a href="#cite_note-295" id="mwDMM"><span class="mw-reflink-text" id="mwDMQ"><span class="cite-bracket" id="mwDMU">[</span>295<span class="cite-bracket" id="mwDMY">]</span></span></a></sup><sup about="#mwt1019" class="mw-ref reference" id="cite_ref-296" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-296&quot;}}"><a href="#cite_note-296" id="mwDMc"><span class="mw-reflink-text" id="mwDMg"><span class="cite-bracket" id="mwDMk">[</span>296<span class="cite-bracket" id="mwDMo">]</span></span></a></sup><sup about="#mwt1022" class="mw-ref reference" id="cite_ref-297" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-297&quot;}}"><a href="#cite_note-297" id="mwDMs"><span class="mw-reflink-text" id="mwDMw"><span class="cite-bracket" id="mwDM0">[</span>297<span class="cite-bracket" id="mwDM4">]</span></span></a></sup><sup about="#mwt1025" class="mw-ref reference" id="cite_ref-298" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-298&quot;}}"><a href="#cite_note-298" id="mwDM8"><span class="mw-reflink-text" id="mwDNA"><span class="cite-bracket" id="mwDNE">[</span>298<span class="cite-bracket" id="mwDNI">]</span></span></a></sup><sup about="#mwt1028" class="mw-ref reference" id="cite_ref-299" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-299&quot;}}"><a href="#cite_note-299" id="mwDNM"><span class="mw-reflink-text" id="mwDNQ"><span class="cite-bracket" id="mwDNU">[</span>299<span class="cite-bracket" id="mwDNY">]</span></span></a></sup><sup about="#mwt1031" class="mw-ref reference" id="cite_ref-300" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-300&quot;}}"><a href="#cite_note-300" id="mwDNc"><span class="mw-reflink-text" id="mwDNg"><span class="cite-bracket" id="mwDNk">[</span>300<span class="cite-bracket" id="mwDNo">]</span></span></a></sup><sup about="#mwt1034" class="mw-ref reference" id="cite_ref-301" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-301&quot;}}"><a href="#cite_note-301" id="mwDNs"><span class="mw-reflink-text" id="mwDNw"><span class="cite-bracket" id="mwDN0">[</span>301<span class="cite-bracket" id="mwDN4">]</span></span></a></sup></p>

</section></section><section data-mw-section-id="11" id="mwDN8" aria-labelledby="Prominent_political_events"><div class="mw-heading mw-heading3"><h3 id="Prominent_political_events">Prominent political events</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2020s&amp;action=edit&amp;section=11" title="Edit section: Prominent political events"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>

