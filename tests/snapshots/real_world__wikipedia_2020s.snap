</section><section data-mw-section-id="31" id="mwJp0" aria-labelledby="Volcanic_eruptions"><div class="mw-heading mw-heading4"><h4 id="Volcanic_eruptions">Volcanic eruptions</h4><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2020s&amp;action=edit&amp;section=31" title="Edit section: Volcanic eruptions"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<table class="wikitable mw-collapsible sortable" id="mwJp4">
<tbody id="mwJp8"><tr id="mwJqA">
<th style="width:120px;" id="mwJqE">Event</th>
<th style="width:120px;" id="mwJqI">Date</th>
