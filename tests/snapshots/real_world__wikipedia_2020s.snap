<span class="mw-empty-elt" about="#mwt2538" typeof="mw:Transclusion" id="mwH7Q" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Main&quot;,&quot;href&quot;:&quot;./Template:Main&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;List of earthquakes in 2020&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;List of earthquakes in 2021&quot;},&quot;l2&quot;:{&quot;wt&quot;:&quot;2021&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;List of earthquakes in 2022&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;List of earthquakes in 2023&quot;},&quot;l3&quot;:{&quot;wt&quot;:&quot;2022&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;List of earthquakes in 2024&quot;},&quot;6&quot;:{&quot;wt&quot;:&quot;List of earthquakes in 2025&quot;},&quot;l4&quot;:{&quot;wt&quot;:&quot;2023&quot;},&quot;7&quot;:{&quot;wt&quot;:&quot;List of earthquakes in 2026&quot;},&quot;l5&quot;:{&quot;wt&quot;:&quot;2024&quot;},&quot;l6&quot;:{&quot;wt&quot;:&quot;2025&quot;},&quot;l7&quot;:{&quot;wt&quot;:&quot;2026&quot;}},&quot;i&quot;:0}}]}"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1353705441" about="#mwt2539" typeof="mw:Extension/templatestyles" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Module:Hatnote/styles.css&quot;},&quot;body&quot;:{&quot;extsrc&quot;:&quot;&quot;}}"></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt2538" id="mwH7U">Main articles: <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/List_of_earthquakes_in_2020" title="List of earthquakes in 2020">List of earthquakes in 2020</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/List_of_earthquakes_in_2021" title="List of earthquakes in 2021">2021</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/List_of_earthquakes_in_2022" title="List of earthquakes in 2022">2022</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/List_of_earthquakes_in_2023" title