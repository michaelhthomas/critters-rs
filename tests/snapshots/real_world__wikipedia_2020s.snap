<td id="mwCsg"><span class="flagicon" about="#mwt803" typeof="mw:Transclusion" id="mwCsk" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:flag&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Germany&quot;}},&quot;i&quot;:0}}]}"><span class="mw-image-border" typeof="mw:File"><span><img alt="" resource="https://en.wikipedia.org/wiki/File:Flag_of_Germany.svg" src="//upload.wikimedia.org/wikipedia/en/thumb/b/ba/Flag_of_Germany.svg/40px-Flag_of_Germany.svg.png" decoding="async" data-file-width="1000" data-file-height="600" data-file-type="drawing" height="14" width="23" srcset="//upload.wikimedia.org/wikipedia/en/thumb/b/ba/Flag_of_Germany.svg/60px-Flag_of_Germany.svg.png 2x" class="mw-file-element"></span></span><span typeof="mw:Entity">&nbsp;</span></span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Germany" title="Germany" about="#mwt803" id="mwCso">Germany</a></td>
<td id="mwCss">5</td>
<td id="mwCsw">40</td>
<td id="mwCs0"><sup about="#mwt806" class="mw-ref reference" id="cite_ref-229" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-229&quot;}}"><a href="#cite_note-229" id="mwCs4"><span class="mw-reflink-text" id="mwCs8"><span class="cite-bracket" id="mwCtA">[</span>229<span class="cite-bracket" id="mwCtE">]</span></span></a></sup><sup about="#mwt809" class="mw-ref reference" id="cite_ref-230" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-230&quot;}}"><a href="#cite_note-230" id="mwCtI"><span class="mw-reflink-text" id="mwCtM"><span class="cite-bracket" id="mwCtQ">[</span>230<span class="cite-bracket" id="mwCtU">]</span></span></a></sup></td></tr>
<tr class="mw-empty-elt" id="mwCtY"></tr>
