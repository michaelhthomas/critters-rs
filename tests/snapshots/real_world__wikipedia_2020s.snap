<tr id="mwGYA">
<td id="mwGYE">3 January 2020</td>
<td id="mwGYI"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Qasem_Soleimani" title="Qasem Soleimani" id="mwGYM">Qasem Soleimani</a>, Iranian general, and leader in the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Islamic_Revolutionary_Guard" title="Islamic Revolutionary Guard" class="mw-redirect" id="mwGYQ">Islamic Revolutionary Guard</a>, is killed in an <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2020_Baghdad_International_Airport_airstrike" title="2020 Baghdad International Airport airstrike" class="mw-redirect" id="mwGYU">airstrike</a> conducted by the United States near <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Baghdad_International_Airport" title="Baghdad International Airport" id="mwGYY">Baghdad International Airport</a>.</td>
<td id="mwGYc"><sup about="#mwt2038" class="mw-ref reference" id="cite_ref-576" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-576&quot;}}"><a href="#cite_note-576" id="mwGYg"><span class="mw-reflink-text" id="mwGYk"><span class="cite-bracket" id="mwGYo">[</span>576<span class="cite-bracket" id="mwGYs">]</span></span></a></sup></td></tr>
<tr id="mwGYw">
