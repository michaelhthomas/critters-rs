<td id="mwJ-k"><sup about="#mwt3127" class="mw-ref reference" id="cite_ref-829" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-829&quot;}}"><a href="#cite_note-829" id="mwJ-o"><span class="mw-reflink-text" id="mwJ-s"><span class="cite-bracket" id="mwJ-w">[</span>829<span class="cite-bracket" id="mwJ-0">]</span></span></a></sup><sup about="#mwt3130" class="mw-ref reference" id="cite_ref-830" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-830&quot;}}"><a href="#cite_note-830" id="mwJ-4"><span class="mw-reflink-text" id="mwJ-8"><span class="cite-bracket" id="mwJ_A">[</span>830<span class="cite-bracket" id="mwJ_E">]</span></span></a></sup><sup about="#mwt3133" class="mw-ref reference" id="cite_ref-831" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-831&quot;}}"><a href="#cite_note-831" id="mwJ_I"><span class="mw-reflink-text" id="mwJ_M"><span class="cite-bracket" id="mwJ_Q">[</span>831<span class="cite-bracket" id="mwJ_U">]</span></span></a></sup></td></tr>
<tr id="mwJ_Y">
<td id="mwJ_c"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2025_South_Korea_wildfires" title="2025 South Korea wildfires" id="mwJ_g">2025 South Korea wildfires</a></td>
<td id="mwJ_k">21 March – 18 May 2025</td>
<td id="mwJ_o"><span class="flagicon" about="#mwt3134" typeof="mw:Transclusion" id="mwJ_s" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:flag&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;South Korea&quot;}},&quot;i&quot;:0}}]}"><span class="mw-image-border" typeof="mw:File"><span><img alt="" resource="https://en.wikipedia.org/wiki/File:Flag_of_South_Korea.svg" src="//upload.wikimedia.org/wikipedia/commons/thumb/0/09/Flag_of_South_Korea.svg/40px-Flag_of_South_Korea.svg.png" decoding="async" data-file-width="900" data-file-height="600" data-file-type="drawing" height="15" width="23" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/0/09/Flag_of_South_Korea.svg/60px-Flag_of_South_Korea.svg.png 2x" class="mw-file-element"></span></span><span typeof="mw:Entity">&nbsp;</span></span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/South_Korea" title="South Korea" about="#mwt3134" id="mwJ_w">South Korea</a></td>
<td id="mwJ_0">Wildfires have affected central and southern locations, it has been worst wildfires in history.</td>
<td id="mwJ_4"><sup about="#mwt3137" class="mw-ref reference" id="cite_ref-832" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-832&quot;}}"><a href="#cite_note-832" id="mwJ_8"><span class="mw-reflink-text" id="mwKAA"><span class="cite-bracket" id="mwKAE">[</span>832<span class="cite-bracket" id="mwKAI">]</span></span></a></sup><sup about="#mwt3140" class="mw-ref reference" id="cite_ref-833" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-833&quot;}}"><a href="#cite_note-833" id="mwKAM"><span class="mw-reflink-text" id="mwKAQ"><span class="cite-bracket" id="mwKAU">[</span>833<span class="cite-bracket" id="mwKAY">]</span></span></a></sup></td></tr>
<tr id="mwKAc">
<td id="mwKAg">2025 Northeast Thailand wildfires</td>
<td id="mwKAk">26 March – 6 May 2025</td>
<td id="mwKAo"><span class="flagicon" about="#mwt3141" typeof="mw:Transclusion" id="mwKAs" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:flag&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Thailand&quot;}},&quot;i&quot;:0}}]}"><span class="mw-image-border" typeof="mw:File"><span><img alt="" resource="https://en.wikipedia.org/wiki/File:Flag_of_Thailand.svg" src="//upload.wikimedia.org/wikipedia/commons/thumb/a/a9/Flag_of_Thailand.svg/40px-Flag_of_Thailand.svg.png" decoding="async" data-file-width="900" data-file-height="600" data-file-type="drawing" height="15" width="23" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/a/a9/Flag_of_Thailand.svg/60px-Flag_of_Thailand.svg.png 2x" class="mw-file-element"></span></span><span typeof="mw:Entity">&nbsp;</span></span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Thailand" title="Thailand" about="#mwt3141" id="mwKAw">Thailand</a></td>
<td id="mwKA0">Wildfires have affected <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Isan" title="Isan" id="mwKA4">Isan</a> regional provinces such as <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Udon_Thani_province" title="Udon Thani province" id="mwKA8">Udon Thani</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Nong_Bua_Lamphu_province" title="Nong Bua Lamphu province" id="mwKBA">Nong Bua Lamphu</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Kalasin_province" title="Kalasin province" id="mwKBE">Kalasin</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Khon_Kaen_province" title="Khon Kaen province" id="mwKBI">Khon Kaen provinces</a>.</td>
<td id="mwKBM"></td></tr>
<tr id="mwKBQ">
<td id="mwKBU"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2025_Israel–West_Bank_fires" title="2025 Israel–West Bank fires" id="mwKBY">2025 Israel–West Bank fires</a></td>
<td id="mwKBc">30 April – 3 May 2025</td>
<td id="mwKBg"><span class="flagicon" about="#mwt3142" typeof="mw:Transclusion" id="mwKBk" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:flag&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Israel&quot;}},&quot;i&quot;:0}}]}"><span class="mw-image-border" typeof="mw:File"><span><img alt="" resource="https://en.wikipedia.org/wiki/File:Flag_of_Israel.svg" src="//upload.wikimedia.org/wikipedia/commons/thumb/d/d4/Flag_of_Israel.svg/40px-Flag_of_Israel.svg.png" decoding="async" data-file-width="1100" data-file-height="800" data-file-type="drawing" height="15" width="21" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/d/d4/Flag_of_Israel.svg/60px-Flag_of_Israel.svg.png 2x" class="mw-file-element"></span></span><span typeof="mw:Entity">&nbsp;</span></span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Israel" title="Israel" about="#mwt3142" id="mwKBo">Israel</a></td>
<td id="mwKBs">Wildfires have affected around <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Jerusalem" title="Jerusalem" id="mwKBw">Jerusalem</a>, in at least 100 different locations through the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Judean_Mountains" title="Judean Mountains" class="mw-redirect" id="mwKB0">Judean Mountains</a> area.</td>
<td id="mwKB4"><sup about="#mwt3145" class="mw-ref reference" id="cite_ref-834" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-834&quot;}}"><a href="#cite_note-834" id="mwKB8"><span class="mw-reflink-text" id="mwKCA"><span class="cite-bracket" id="mwKCE">[</span>834<span class="cite-bracket" id="mwKCI">]</span></span></a></sup><sup about="#mwt3148" class="mw-ref reference" id="cite_ref-835" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-835&quot;}}"><a href="#cite_note-835" id="mwKCM"><span class="mw-reflink-text" id="mwKCQ"><span class="cite-bracket" id="mwKCU">[</span>835<span class="cite-bracket" id="mwKCY">]</span></span></a></sup><sup about="#mwt3151" class="mw-ref reference" id="cite_ref-836" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-836&quot;}}"><a href="#cite_note-836" id="mwKCc"><span class="mw-reflink-text" id="mwKCg"><span class="cite-bracket" id="mwKCk">[</span>836<span class="cite-bracket" id="mwKCo">]</span></span></a></sup></td></tr>
<tr id="mwKCs">
<td id="mwKCw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2026_European_heatwaves" title="2026 European heatwaves" id="mwKC0">2026 European heatwaves</a></td>
<td id="mwKC4">May – September 2026</td>
<td id="mwKC8"><span class="flagicon" about="#mwt3152" typeof="mw:Transclusion" id="mwKDA" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:flag&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;European Union&quot;}},&quot;i&quot;:0}}]}"><span class="mw-image-border" typeof="mw:File"><span><img alt="" resource="https://en.wikipedia.org/wiki/File:Flag_of_Europe.svg" src="//upload.wikimedia.org/wikipedia/commons/thumb/b/b7/Flag_of_Europe.svg/40px-Flag_of_Europe.svg.png" decoding="async" data-file-width="900" data-file-height="600" data-file-type="drawing" height="15" width="23" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/b/b7/Flag_of_Europe.svg/60px-Flag_of_Europe.svg.png 2x" class="mw-file-element"></span></span><span typeof="mw:Entity">&nbsp;</span></span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/European_Union" title="European Union" about="#mwt3152" id="mwKDE">European Union</a></td>
<td id="mwKDI">Since late May 2026, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Europe" title="Europe" id="mwKDM">Europe</a> has been struck by severe <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Heatwaves" title="Heatwaves" class="mw-redirect" id="mwKDQ">heatwaves</a>. Temperature records have been broken in several European countries, with temperatures higher than normal, resulting several deaths including heatstroke and drownings. Temperatures were the highest ever recorded for May and spring, with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Climate_change" title="Climate change" id="mwKDU">climate change</a> causing the earlier onset of Central European summer in June and July. On 26 June, the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/World_Meteorological_Organization" title="World Meteorological Organization" id="mwKDY">World Meteorological Organization</a> (WMO) said the heatwave was expected to affect many areas, with the focus of the heat likely to shift towards the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Balkans" title="Balkans" id="mwKDc">Balkans</a>. The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/World_Health_Organization" title="World Health Organization" id="mwKDg">WHO</a> said that more than 1,300 <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Excess_mortality" title="Excess mortality" id="mwKDk">excess deaths</a> linked to high temperatures had been recorded across Europe.</td>
<td id="mwKDo"><sup about="#mwt3155" class="mw-ref reference" id="cite_ref-837" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-837&quot;}}"><a href="#cite_note-837" id="mwKDs"><span class="mw-reflink-text" id="mwKDw"><span class="cite-bracket" id="mwKD0">[</span>837<span class="cite-bracket" id="mwKD4">]</span></span></a></sup><sup about="#mwt3158" class="mw-ref reference" id="cite_ref-838" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-838&quot;}}"><a href="#cite_note-838" id="mwKD8"><span class="mw-reflink-text" id="mwKEA"><span class="cite-bracket" id="mwKEE">[</span>838<span class="cite-bracket" id="mwKEI">]</span></span></a></sup><sup about="#mwt3161" class="mw-ref reference" id="cite_ref-wmo_839-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;wmo&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-wmo-839&quot;}}"><a href="#cite_note-wmo-839" id="mwKEM"><span class="mw-reflink-text" id="mwKEQ"><span class="cite-bracket" id="mwKEU">[</span>839<span class="cite-bracket" id="mwKEY">]</span></span></a></sup></td></tr>
<tr id="mwKEc">
<td id="mwKEg"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wildfires_in_2026#Europe" title="Wildfires in 2026" id="mwKEk">2026 European wildfires</a></td>
<td id="mwKEo">July – September 2026</td>
<td id="mwKEs"><span class="flagicon" about="#mwt3162" typeof="mw:Transclusion" id="mwKEw" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:flag&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;European Union&quot;}},&quot;i&quot;:0}}]}"><span class="mw-image-border" typeof="mw:File"><span><img alt="" resource="https://en.wikipedia.org/wiki/File:Flag_of_Europe.svg" src="//upload.wikimedia.org/wikipedia/commons/thumb/b/b7/Flag_of_Europe.svg/40px-Flag_of_Europe.svg.png" decoding="async" data-file-width="900" data-file-height="600" data-file-type="drawing" height="15" width="23" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/b/b7/Flag_of_Europe.svg/60px-Flag_of_Europe.svg.png 2x" class="mw-file-element"></span></span><span typeof="mw:Entity">&nbsp;</span></span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/European_Union" title="European Union" about="#mwt3162" id="mwKE0">European Union</a></td>
<td id="mwKE4">Wildfires across Europe began with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Almería" title="Almería" id="mwKE8">Almería</a> and a majority in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Gironde" title="Gironde" id="mwKFA">Gironde</a>, it was affected by <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2026_European_heatwaves" title="2026 European heatwaves" id="mwKFE">2026 European heatwaves</a> are thought to have been in part caused by the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/El_Niño–Southern_Oscillation" title="El Niño–Southern Oscillation" id="mwKFI">El Niño</a>. Several wildfires in the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Province_of_Ávila" title="Province of Ávila" id="mwKFM">Ávila</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Community_of_Madrid" title="Community of Madrid" id="mwKFQ">Madrid provinces</a>, about 50km west from the city of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Madrid" title="Madrid" id="mwKFU">Madrid</a>, merged into a single blaze. The wildfire, which had burned 15,000, as well in Gironde, had burnt close to 20,000 hectares and was nearby <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Bordeaux" title="Bordeaux" id="mwKFY">Bordeaux</a>.</td>
<td id="mwKFc"><sup about="#mwt3165" class="mw-ref reference" id="cite_ref-840" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-840&quot;}}"><a href="#cite_note-840" id="mwKFg"><span class="mw-reflink-text" id="mwKFk"><span class="cite-bracket" id="mwKFo">[</span>840<span class="cite-bracket" id="mwKFs">]</span></span></a></sup><sup about="#mwt3168" class="mw-ref reference" id="cite_ref-841" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-841&quot;}}"><a href="#cite_note-841" id="mwKFw"><span class="mw-reflink-text" id="mwKF0"><span class="cite-bracket" id="mwKF4">[</span>841<span class="cite-bracket" id="mwKF8">]</span></span></a></sup><sup about="#mwt3171" class="mw-ref reference" id="cite_ref-842" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-842&quot;}}"><a href="#cite_note-842" id="mwKGA"><span class="mw-reflink-text" id="mwKGE"><span class="cite-bracket" id="mwKGI">[</span>842<span class="cite-bracket" id="mwKGM">]</span></span></a></sup><sup about="#mwt3174" class="mw-ref reference" id="cite_ref-843" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-843&quot;}}"><a href="#cite_note-843" id="mwKGQ"><span class="mw-reflink-text" id="mwKGU"><span class="cite-bracket" id="mwKGY">[</span>843<span class="cite-bracket" id="mwKGc">]</span></span></a></sup><sup about="#mwt3177" class="mw-ref reference" id="cite_ref-844" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-844&quot;}}"><a href="#cite_note-844" id="mwKGg"><span class="mw-reflink-text" id="mwKGk"><span class="cite-bracket" id="mwKGo">[</span>844<span class="cite-bracket" id="mwKGs">]</span></span></a></sup></td></tr>
<tr id="mwKGw">
<td id="mwKG0">2026 Kyushu wildfires</td>
<td id="mwKG4">29 July 2026 – present</td>
<td id="mwKG8"><span class="flagicon" about="#mwt3178" typeof="mw:Transclusion" id="mwKHA" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:flag&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Japan&quot;}},&quot;i&quot;:0}}]}"><span class="mw-image-border" typeof="mw:File"><span><img alt="" resource="https://en.wikipedia.org/wiki/File:Flag_of_Japan.svg" src="//upload.wikimedia.org/wikipedia/en/thumb/9/9e/Flag_of_Japan.svg/40px-Flag_of_Japan.svg.png" decoding="async" data-file-width="900" data-file-height="600" data-file-type="drawing" height="15" width="23" srcset="//upload.wikimedia.org/wikipedia/en/thumb/9/9e/Flag_of_Japan.svg/60px-Flag_of_Japan.svg.png 2x" class="mw-file-element"></span></span><span typeof="mw:Entity">&nbsp;</span></span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japan" title="Japan" about="#mwt3178" id="mwKHE">Japan</a></td>
<td id="mwKHI">A destructive willdfires have affected two prefectures in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Kyushu" title="Kyushu" id="mwKHM">Kyushu</a> such as <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Kumamoto_Prefecture" title="Kumamoto Prefecture" id="mwKHQ">Kumamoto</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Miyazaki_Prefecture" title="Miyazaki Prefecture" id="mwKHU">Miyazaki Prefectures</a>, The wildfires have been deemed the worst-ever in the aftermath of a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2026_Kumamoto_earthquake" title="2026 Kumamoto earthquake" id="mwKHY">major earthquake</a> and impacted by the heatwaves since <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2026_Ōtsuchi_wildfires" title="2026 Ōtsuchi wildfires" id="mwKHc">Otsuchi</a> in April.</td>
<td id="mwKHg"><sup about="#mwt3181" class="mw-ref reference" id="cite_ref-845" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-845&quot;}}"><a href="#cite_note-845" id="mwKHk"><span class="mw-reflink-text" id="mwKHo"><span class="cite-bracket" id="mwKHs">[</span>845<span class="cite-bracket" id="mwKHw">]</span></span></a></sup><sup about="#mwt3184" class="mw-ref reference" id="cite_ref-846" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-846&quot;}}"><a href="#cite_note-846" id="mwKH0"><span class="mw-reflink-text" id="mwKH4"><span class="cite-bracket" id="mwKH8">[</span>846<span class="cite-bracket" id="mwKIA">]</span></span></a></sup><sup about="#mwt3187" class="mw-ref reference" id="cite_ref-847" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-847&quot;}}"><a href="#cite_note-847" id="mwKIE"><span class="mw-reflink-text" id="mwKII"><span class="cite-bracket" id="mwKIM">[</span>847<span class="cite-bracket" id="mwKIQ">]</span></span></a></sup></td></tr>
</tbody></table>

</section><section data-mw-section-id="33" id="mwKIU" aria-labelledby="Biological_disasters"><div class="mw-heading mw-heading4"><h4 id="Biological_disasters">Biological disasters</h4><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2020s&amp;action=edit&amp;section=33" title="Edit section: Biological disasters"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<table class="wikitable mw-collapsible sortable" id="mwKIY">
<tbody id="mwKIc"><tr id="mwKIg">
<th style="width:120px;" id="mwKIk">Event</th>
<th style="width:120px;" id="mwKIo">Date</th>
<th id="mwKIs">Country</th>
<th id="mwKIw">Description</th></tr>
<tr id="mwKI0">
<td id="mwKI4"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022_Oder_environmental_disaster" title="2022 Oder environmental disaster" id="mwKI8">2022 Oder environmental disaster</a></td>
<td id="mwKJA">July – August 2022</td>
<td id="mwKJE"><span class="flagicon" about="#mwt3188" typeof="mw:Transclusion" id="mwKJI" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:flag&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Poland&quot;}},&quot;i&quot;:0}}]}"><span class="mw-image-border" typeof="mw:File"><span><img alt="" resource="https://en.wikipedia.org/wiki/File:Flag_of_Poland.svg" src="//upload.wikimedia.org/wikipedia/en/thumb/1/12/Flag_of_Poland.svg/40px-Flag_of_Poland.svg.png" decoding="async" data-file-width="1280" data-file-height="800" data-file-type="drawing" height="14" width="23" srcset="//upload.wikimedia.org/wikipedia/en/thumb/1/12/Flag_of_Poland.svg/60px-Flag_of_Poland.svg.png 2x" class="mw-file-element"></span></span><span typeof="mw:Entity">&nbsp;</span></span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Poland" title="Poland" about="#mwt3188" id="mwKJM">Poland</a><br id="mwKJQ"><span class="flagicon" about="#mwt3189" typeof="mw:Transclusion" id="mwKJU" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:flag&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Germany&quot;}},&quot;i&quot;:0}}]}"><span class="mw-image-border" typeof="mw:File"><span><img alt="" resource="https://en.wikipedia.org/wiki/File:Flag_of_Germany.svg" src="//upload.wikimedia.org/wikipedia/en/thumb/b/ba/Flag_of_Germany.svg/40px-Flag_of_Germany.svg.png" decoding="async" data-file-width="1000" data-file-height="600" data-file-type="drawing" height="14" width="23" srcset="//upload.wikimedia.org/wikipedia/en/thumb/b/ba/Flag_of_Germany.svg/60px-Flag_of_Germany.svg.png 2x" class="mw-file-element"></span></span><span typeof="mw:Entity">&nbsp;</span></span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Germany" title="Germany" about="#mwt3189" id="mwKJY">Germany</a></td>
<td id="mwKJc">A mass fish kill occurs in the river <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Oder" title="Oder" id="mwKJg">Oder</a> in Poland and Germany attributed to an <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Algal_bloom" title="Algal bloom" id="mwKJk">algal bloom</a>.</td></tr>
</tbody></table>

</section><section data-mw-section-id="34" id="mwKJo" aria-labelledby="Other_natural_events"><div class="mw-heading mw-heading4"><h4 id="Other_natural_events">Other natural events</h4><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2020s&amp;action=edit&amp;section=34" title="Edit section: Other natural events"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwKJs">Beginning in 2019 until 2022, a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–2022_locust_infestation" title="2019–2022 locust infestation" id="mwKJw">huge swarm</a> of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Desert_locust" title="Desert locust" id="mwKJ0">desert locusts</a> threatened to engulf massive portions of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Middle_East" title="Middle East" id="mwKJ4">Middle East</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Africa" title="Africa" id="mwKJ8">Africa</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Asia" title="Asia" id="mwKKA">Asia</a>.<sup about="#mwt3192" class="mw-ref reference" id="cite_ref-848" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-848&quot;}}"><a href="#cite_note-848" id="mwKKE"><span class="mw-reflink-text" id="mwKKI"><span class="cite-bracket" id="mwKKM">[</span>848<span class="cite-bracket" id="mwKKQ">]</span></span></a></sup><sup about="#mwt3195" class="mw-ref reference" id="cite_ref-849" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-849&quot;}}"><a href="#cite_note-849" id="mwKKU"><span class="mw-reflink-text" id="mwKKY"><span class="cite-bracket" id="mwKKc">[</span>849<span class="cite-bracket" id="mwKKg">]</span></span></a></sup><sup about="#mwt3198" class="mw-ref reference" id="cite_ref-850" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-850&quot;}}"><a href="#cite_note-850" id="mwKKk"><span class="mw-reflink-text" id="mwKKo"><span class="cite-bracket" id="mwKKs">[</span>850<span class="cite-bracket" id="mwKKw">]</span></span></a></sup><sup about="#mwt3201" class="mw-ref reference" id="cite_ref-851" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-851&quot;}}"><a href="#cite_note-851" id="mwKK0"><span class="mw-reflink-text" id="mwKK4"><span class="cite-bracket" id="mwKK8">[</span>851<span class="cite-bracket" id="mwKLA">]</span></span></a></sup><sup about="#mwt3204" class="mw-ref reference" id="cite_ref-852" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-852&quot;}}"><a href="#cite_note-852" id="mwKLE"><span class="mw-reflink-text" id="mwKLI"><span class="cite-bracket" id="mwKLM">[</span>852<span class="cite-bracket" id="mwKLQ">]</span></span></a></sup><sup about="#mwt3207" class="mw-ref reference" id="cite_ref-853" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-853&quot;}}"><a href="#cite_note-853" id="mwKLU"><span class="mw-reflink-text" id="mwKLY"><span class="cite-bracket" id="mwKLc">[</span>853<span class="cite-bracket" id="mwKLg">]</span></span></a></sup></p>

</section></section></section><section data-mw-section-id="35" id="mwKLk" aria-labelledby="Economics"><div class="mw-heading mw-heading2"><h2 id="Economics">Economics</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2020s&amp;action=edit&amp;section=35" title="Edit section: Economics"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<span class="mw-empty-elt" about="#mwt3208" typeof="mw:Transclusion" id="mwKLo" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Main&quot;,&quot;href&quot;:&quot;./Template:Main&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;2020s in economic history&quot;}},&quot;i&quot;:0}}]}"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1353705441" about="#mwt3209" typeof="mw:Extension/templatestyles" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Module:Hatnote/styles.css&quot;},&quot;body&quot;:{&quot;extsrc&quot;:&quot;&quot;}}"></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt3208" id="mwKLs">Main article: <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2020s_in_economic_history" title="2020s in economic history">2020s in economic history</a></div>

<span class="mw-empty-elt" about="#mwt3210" typeof="mw:Transclusion" id="mwKLw" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:multiple image&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;\n&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot; direction         = vertical\n&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot; title             = Economic indexes by country\n&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot; total_width       = 350\n&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot; image1            = Countries by GDP (nominal).svg\n&quot;},&quot;6&quot;:{&quot;wt&quot;:&quot; caption1          = \n&quot;},&quot;7&quot;:{&quot;wt&quot;:&quot; image2            = A Map of (nominal) gdp per capita in 2024 by country-nations.png\n&quot;},&quot;8&quot;:{&quot;wt&quot;:&quot; caption2          = The 2025 [[International Monetary Fund|IMF]] [[list of countries by GDP (nominal)]] and [[List of countries by GDP (nominal) per capita|per capita]]<ref>{{#invoke:cite | web |title=Data Explorer |url=https://data.imf.org/en/Data-Explorer?datasetUrn=IMF.RES:WEO(9.0.0) |website=data.imf.org |access-date=24 October 2025}}</ref>\n&quot;}},&quot;i&quot;:0}}]}"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1349637415/mw-parser-output/.tmulti" about="#mwt3211" typeof="mw:Extension/templatestyles" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Multiple image/styles.css&quot;,&quot;wrapper&quot;:&quot;.tmulti&quot;},&quot;body&quot;:{&quot;extsrc&quot;:&quot;&quot;}}"></span><div class="thumb tmulti floatright" about="#mwt3210"><div class="thumbinner multiimageinner" style="width:342px;max-width:342px"><div class="trow"><div class="theader">Economic indexes by country</div></div><div class="trow"><div class="tsingle" style="width:340px;max-width:340px"><div class="thumbimage" style="height:171px;overflow:hidden"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:Countries_by_GDP_(nominal).svg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Countries_by_GDP_(nominal).svg" src="//upload.wikimedia.org/wikipedia/commons/thumb/6/62/Countries_by_GDP_%28nominal%29.svg/500px-Countries_by_GDP_%28nominal%29.svg.png" decoding="async" data-file-width="2754" data-file-height="1398" data-file-type="drawing" height="172" width="338" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/6/62/Countries_by_GDP_%28nominal%29.svg/960px-Countries_by_GDP_%28nominal%29.svg.png 2x" class="mw-file-element"></a></span></div></div></div><div class="trow"><div class="tsingle" style="width:340px;max-width:340px"><div class="thumbimage" style="height:175px;overflow:hidden"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:A_Map_of_(nominal)_gdp_per_capita_in_2024_by_country-nations.png" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:A_Map_of_(nominal)_gdp_per_capita_in_2024_by_country-nations.png" src="//upload.wikimedia.org/wikipedia/commons/thumb/b/b1/A_Map_of_%28nominal%29_gdp_per_capita_in_2024_by_country-nations.png/500px-A_Map_of_%28nominal%29_gdp_per_capita_in_2024_by_country-nations.png" decoding="async" data-file-width="1920" data-file-height="995" data-file-type="bitmap" height="175" width="338" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/b/b1/A_Map_of_%28nominal%29_gdp_per_capita_in_2024_by_country-nations.png/960px-A_Map_of_%28nominal%29_gdp_per_capita_in_2024_by_country-nations.png 2x" class="mw-file-element"></a></span></div><div class="thumbcaption">The 2025 <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/International_Monetary_Fund" title="International Monetary Fund">IMF</a> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/List_of_countries_by_GDP_(nominal)" title="List of countries by GDP (nominal)">list of countries by GDP (nominal)</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/List_of_countries_by_GDP_(nominal)_per_capita" title="List of countries by GDP (nominal) per capita">per capita</a><sup about="#mwt3214" class="mw-ref reference" id="cite_ref-854" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-854&quot;}}"><a href="#cite_note-854" id="mwKL0"><span class="mw-reflink-text" id="mwKL4"><span class="cite-bracket" id="mwKL8">[</span>854<span class="cite-bracket" id="mwKMA">]</span></span></a></sup></div></div></div></div></div><span class="mw-empty-elt" about="#mwt3210"><link rel="mw:PageProp/Category" href="./Category:Pages_using_multiple_image_with_auto_scaled_images"></span>

<span class="mw-empty-elt" about="#mwt3217" typeof="mw:Transclusion" id="mwKME" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;#invoke:multiple image&quot;,&quot;function&quot;:&quot;invoke&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;\n&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot; title             = Forbes' ''The World's Billionaires'' of the 2020s\n&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot; direction         = horizontal\n&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot; total_width       = 350\n&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot; image1            = Elon Musk (54816836217) (cropped).jpg\n&quot;},&quot;6&quot;:{&quot;wt&quot;:&quot; image2            = Larry Ellison picture.png\n&quot;},&quot;7&quot;:{&quot;wt&quot;:&quot; image3            = Jen-Hsun Huang 2025 (2).jpg\n&quot;},&quot;8&quot;:{&quot;wt&quot;:&quot; footer            = {{center|'''Left to right:'''}}[[Elon Musk]], [[Larry Ellison]], and [[Jensen Huang]]. Musk and Ellison have been the [[The World's Billionaires|wealthiest persons in the world]], since 2021, with estimated net worths over $500 billion and $300 billion in October 2025. Huang is the wealthiest person of [[Asian Americans|Asian descent]] in the world, and leads [[Nvidia]], the most valuable company in the world. In October 2025, Nvidia had a [[market capitalization]] of $5 trillion.<ref name=\&quot;Nvidia\&quot;>{{#invoke:cite|web|last=Berkowitz|first=Ben|title=Nvidia becomes the world's first $5 trillion company|url=https://www.axios.com/2025/10/29/nvidia-5-trillion/|access-date=2025-10-29|website=Axios |date=29 October 2025 }}</ref>\n&quot;}},&quot;i&quot;:0}}]}"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1349637415/mw-parser-output/.tmulti" about="#mwt3218" typeof="mw:Extension/templatestyles" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Multiple image/styles.css&quot;,&quot;wrapper&quot;:&quot;.tmulti&quot;},&quot;body&quot;:{&quot;extsrc&quot;:&quot;&quot;}}"></span><div class="thumb tmulti floatright" about="#mwt3217"><div class="thumbinner multiimageinner" style="width:342px;max-width:342px"><div class="trow"><div class="theader">Forbes' <i>The World's Billionaires</i> of the 2020s</div></div><div class="trow"><div class="tsingle" style="width:101px;max-width:101px"><div class="thumbimage" style="height:135px;overflow:hidden"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:Elon_Musk_(54816836217)_(cropped).jpg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Elon_Musk_(54816836217)_(cropped).jpg" src="//upload.wikimedia.org/wikipedia/commons/thumb/0/00/Elon_Musk_%2854816836217%29_%28cropped%29.jpg/120px-Elon_Musk_%2854816836217%29_%28cropped%29.jpg" decoding="async" data-file-width="3632" data-file-height="4982" data-file-type="bitmap" height="136" width="99" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/0/00/Elon_Musk_%2854816836217%29_%28cropped%29.jpg/250px-Elon_Musk_%2854816836217%29_%28cropped%29.jpg 2x" class="mw-file-element"></a></span></div></div><div class="tsingle" style="width:131px;max-width:131px"><div class="thumbimage" style="height:135px;overflow:hidden"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:Larry_Ellison_picture.png" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Larry_Ellison_picture.png" src="//upload.wikimedia.org/wikipedia/commons/thumb/0/00/Larry_Ellison_picture.png/250px-Larry_Ellison_picture.png" decoding="async" data-file-width="2264" data-file-height="2376" data-file-type="bitmap" height="135" width="129" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/0/00/Larry_Ellison_picture.png/330px-Larry_Ellison_picture.png 2x" class="mw-file-element"></a></span></div></div><div class="tsingle" style="width:104px;max-width:104px"><div class="thumbimage" style="height:135px;overflow:hidden"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:Jen-Hsun_Huang_2025_(2).jpg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Jen-Hsun_Huang_2025_(2).jpg" src="//upload.wikimedia.org/wikipedia/commons/thumb/1/12/Jen-Hsun_Huang_2025_%282%29.jpg/120px-Jen-Hsun_Huang_2025_%282%29.jpg" decoding="async" data-file-width="712" data-file-height="948" data-file-type="bitmap" height="136" width="102" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/1/12/Jen-Hsun_Huang_2025_%282%29.jpg/250px-Jen-Hsun_Huang_2025_%282%29.jpg 2x" class="mw-file-element"></a></span></div></div></div><div class="trow" style="display:flex"><div class="thumbcaption"><div class="center"><b>Left to right:</b></div><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Elon_Musk" title="Elon Musk">Elon Musk</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Larry_Ellison" title="Larry Ellison">Larry Ellison</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Jensen_Huang" title="Jensen Huang">Jensen Huang</a>. Musk and Ellison have been the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/The_World's_Billionaires" title="The World's Billionaires">wealthiest persons in the world</a>, since 2021, with estimated net worths over $500 billion and $300 billion in October 2025. Huang is the wealthiest person of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Asian_Americans" title="Asian Americans">Asian descent</a> in the world, and leads <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Nvidia" title="Nvidia">Nvidia</a>, the most valuable company in the world. In October 2025, Nvidia had a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Market_capitalization" title="Market capitalization">market capitalization</a> of $5 trillion.<sup about="#mwt3221" class="mw-ref reference" id="cite_ref-Nvidia_855-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Nvidia&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Nvidia-855&quot;}}"><a href="#cite_note-Nvidia-855" id="mwKMI"><span class="mw-reflink-text" id="mwKMM"><span class="cite-bracket" id="mwKMQ">[</span>855<span class="cite-bracket" id="mwKMU">]</span></span></a></sup></div></div></div></div><span class="mw-empty-elt" about="#mwt3217"><link rel="mw:PageProp/Category" href="./Category:Pages_using_multiple_image_with_auto_scaled_images"></span>

<p id="mwKMY">The 2020s were marked by economic troubles, beginning from the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/COVID-19_recession" title="COVID-19 recession" id="mwKMc">COVID-19 recession</a> was a major global economic crisis which has caused both a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Recession" title="Recession" id="mwKMg">recession</a> in some nations, and in others a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Depression_(economic)" title="Depression (economic)" class="mw-redirect" id="mwKMk">depression</a>. The economic crisis began due to the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Economic_impact_of_the_COVID-19_pandemic" title="Economic impact of the COVID-19 pandemic" id="mwKMo">economic consequences</a> of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/COVID-19_pandemic" title="COVID-19 pandemic" id="mwKMs">COVID-19 pandemic</a>. The first major sign of a recession was the collapse of markets during the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2020_stock_market_crash" title="2020 stock market crash" id="mwKMw">2020 stock market crash</a>, which began in late February and lasted through March.<sup about="#mwt3226" class="mw-ref reference" id="cite_ref-856" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-856&quot;}}"><a href="#cite_note-856" id="mwKM0"><span class="mw-reflink-text" id="mwKM4"><span class="cite-bracket" id="mwKM8">[</span>856<span class="cite-bracket" id="mwKNA">]</span></span></a></sup><sup about="#mwt3229" class="mw-ref reference" id="cite_ref-857" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-857&quot;}}"><a href="#cite_note-857" id="mwKNE"><span class="mw-reflink-text" id="mwKNI"><span class="cite-bracket" id="mwKNM">[</span>857<span class="cite-bracket" id="mwKNQ">]</span></span></a></sup><sup about="#mwt3232" class="mw-ref reference" id="cite_ref-858" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-858&quot;}}"><a href="#cite_note-858" id="mwKNU"><span class="mw-reflink-text" id="mwKNY"><span class="cite-bracket" id="mwKNc">[</span>858<span class="cite-bracket" id="mwKNg">]</span></span></a></sup> As of September 2020, every advanced economy is in a recession or depression, whilst all emerging economies are in recession.<sup about="#mwt3235" class="mw-ref reference" id="cite_ref-859" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-859&quot;}}"><a href="#cite_note-859" id="mwKNk"><span class="mw-reflink-text" id="mwKNo"><span class="cite-bracket" id="mwKNs">[</span>859<span class="cite-bracket" id="mwKNw">]</span></span></a></sup><sup about="#mwt3238" class="mw-ref reference" id="cite_ref-:0_228-1" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;:0&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-:0-228&quot;}}"><a href="#cite_note-:0-228" id="mwKN0"><span class="mw-reflink-text" id="mwKN4"><span class="cite-bracket" id="mwKN8">[</span>228<span class="cite-bracket" id="mwKOA">]</span></span></a></sup><sup about="#mwt3241" class="mw-ref reference" id="cite_ref-860" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-860&quot;}}"><a href="#cite_note-860" id="mwKOE"><span class="mw-reflink-text" id="mwKOI"><span class="cite-bracket" id="mwKOM">[</span>860<span class="cite-bracket" id="mwKOQ">]</span></span></a></sup> Modeling by the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/World_Bank" title="World Bank" class="mw-redirect" id="mwKOU">World Bank</a> suggests that in some regions a full recovery will not be achieved until 2025 or beyond.<sup about="#mwt3244" class="mw-ref reference" id="cite_ref-861" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-861&quot;}}"><a href="#cite_note-861" id="mwKOY"><span class="mw-reflink-text" id="mwKOc"><span class="cite-bracket" id="mwKOg">[</span>861<span class="cite-bracket" id="mwKOk">]</span></span></a></sup><sup about="#mwt3247" class="mw-ref reference" id="cite_ref-862" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-862&quot;}}"><a href="#cite_note-862" id="mwKOo"><span class="mw-reflink-text" id="mwKOs"><span class="cite-bracket" id="mwKOw">[</span>862<span class="cite-bracket" id="mwKO0">]</span></span></a></sup></p>

<p id="mwKO4">Due to the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2021–2023_inflation_surge" title="2021–2023 inflation surge" id="mwKO8">2021–2023 inflation surge</a>, many countries reported the highest inflation rates in decades. The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Inflation" title="Inflation" id="mwKPA">inflation</a> surge has been attributed to various causes, including <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/List_of_COVID-19_pandemic_legislation" title="List of COVID-19 pandemic legislation" id="mwKPE">pandemic-related</a> economic dislocation; the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Fiscal_policy" title="Fiscal policy" id="mwKPI">fiscal</a> and monetary <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Stimulus_(economics)" title="Stimulus (economics)" id="mwKPM">stimulus</a> provided in 2020 and 2021 by governments and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Central_bank" title="Central bank" id="mwKPQ">central banks</a> around the world in response to the pandemic were also instrumental.<sup about="#mwt3250" class="mw-ref reference" id="cite_ref-863" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-863&quot;}}"><a href="#cite_note-863" id="mwKPU"><span class="mw-reflink-text" id="mwKPY"><span class="cite-bracket" id="mwKPc">[</span>863<span class="cite-bracket" id="mwKPg">]</span></span></a></sup><sup about="#mwt3253" class="mw-ref reference" id="cite_ref-auto3_864-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;auto3&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-auto3-864&quot;}}"><a href="#cite_note-auto3-864" id="mwKPk"><span class="mw-reflink-text" id="mwKPo"><span class="cite-bracket" id="mwKPs">[</span>864<span class="cite-bracket" id="mwKPw">]</span></span></a></sup> The effect of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022_Russian_invasion_of_Ukraine" title="2022 Russian invasion of Ukraine" id="mwKP0">2022 Russian invasion of Ukraine</a> on global <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Price_of_oil" title="Price of oil" id="mwKP4">oil prices</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Natural_gas" title="Natural gas" id="mwKP8">natural gas</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Fertilizer" title="Fertilizer" id="mwKQA">fertilizer</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022_food_crises" title="2022 food crises" class="mw-redirect" id="mwKQE">food prices</a> further exacerbated the situation.<sup about="#mwt3254" class="mw-ref reference" id="cite_ref-auto3_864-1" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;auto3&quot;}}"><a href="#cite_note-auto3-864" id="mwKQI"><span class="mw-reflink-text" id="mwKQM"><span class="cite-bracket" id="mwKQQ">[</span>864<span class="cite-bracket" id="mwKQU">]</span></span></a></sup> Higher gasoline prices were a major contributor to inflation as oil producers saw record profits.<sup about="#mwt3257" class="mw-ref reference" id="cite_ref-865" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-865&quot;}}"><a href="#cite_note-865" id="mwKQY"><span class="mw-reflink-text" id="mwKQc"><span class="cite-bracket" id="mwKQg">[</span>865<span class="cite-bracket" id="mwKQk">]</span></span></a></sup> Debate arose over whether inflationary pressures were transitory or persistent, and to what extent price gouging was a factor.<sup about="#mwt3260" class="mw-ref reference" id="cite_ref-866" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-866&quot;}}"><a href="#cite_note-866" id="mwKQo"><span class="mw-reflink-text" id="mwKQs"><span class="cite-bracket" id="mwKQw">[</span>866<span class="cite-bracket" id="mwKQ0">]</span></span></a></sup><sup about="#mwt3263" class="mw-ref reference" id="cite_ref-867" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-867&quot;}}"><a href="#cite_note-867" id="mwKQ4"><span class="mw-reflink-text" id="mwKQ8"><span class="cite-bracket" id="mwKRA">[</span>867<span class="cite-bracket" id="mwKRE">]</span></span></a></sup> The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2026_Strait_of_Hormuz_crisis" title="2026 Strait of Hormuz crisis" id="mwKRI">closure</a> of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Strait_of_Hormuz" title="Strait of Hormuz" id="mwKRM">Strait of Hormuz</a> due to the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2026_Iran_war" title="2026 Iran war" id="mwKRQ">2026 Iran war</a> caused the largest oil price increases since 2022.<sup about="#mwt3266" class="mw-ref reference" id="cite_ref-868" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-868&quot;}}"><a href="#cite_note-868" id="mwKRU"><span class="mw-reflink-text" id="mwKRY"><span class="cite-bracket" id="mwKRc">[</span>868<span class="cite-bracket" id="mwKRg">]</span></span></a></sup><sup about="#mwt3269" class="mw-ref reference" id="cite_ref-869" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-869&quot;}}"><a href="#cite_note-869" id="mwKRk"><span class="mw-reflink-text" id="mwKRo"><span class="cite-bracket" id="mwKRs">[</span>869<span class="cite-bracket" id="mwKRw">]</span></span></a></sup> Stock markets experienced declines, with the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Dow_Jones_Industrial_Average" title="Dow Jones Industrial Average" id="mwKR0">Dow Jones Industrial Average</a> falling over 400 points on 2 March.<sup about="#mwt3272" class="mw-ref reference" id="cite_ref-NPR_870-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;NPR&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-NPR-870&quot;}}"><a href="#cite_note-NPR-870" id="mwKR4"><span class="mw-reflink-text" id="mwKR8"><span class="cite-bracket" id="mwKSA">[</span>870<span class="cite-bracket" id="mwKSE">]</span></span></a></sup> Broader economic forecasts warned of inflationary pressures and slowed global growth if the conflict prolonged.<sup about="#mwt3275" class="mw-ref reference" id="cite_ref-Janes_871-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Janes&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Janes-871&quot;}}"><a href="#cite_note-Janes-871" id="mwKSI"><span class="mw-reflink-text" id="mwKSM"><span class="cite-bracket" id="mwKSQ">[</span>871<span class="cite-bracket" id="mwKSU">]</span></span></a></sup></p> 

<p id="mwKSY">American technology billionaires are largely the wealthiest individuals in the world, including <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Elon_Musk" title="Elon Musk" id="mwKSc">Elon Musk</a> (the wealthiest person as of 2026), <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Larry_Ellison" title="Larry Ellison" id="mwKSg">Larry Ellison</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mark_Zuckerberg" title="Mark Zuckerberg" id="mwKSk">Mark Zuckerberg</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Jeff_Bezos" title="Jeff Bezos" id="mwKSo">Jeff Bezos</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Jensen_Huang" title="Jensen Huang" id="mwKSs">Jensen Huang</a>. Jensen Huang is the CEO of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Nvidia" title="Nvidia" id="mwKSw">Nvidia</a>, the most valuable company in the world, and the wealthiest person of Asian descent. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Alice_Walton" title="Alice Walton" id="mwKS0">Alice Walton</a> is the wealthiest woman in the world. In 2026, Elon Musk became the first person to reach a net worth of $1 trillion.<sup about="#mwt3278" class="mw-ref reference" id="cite_ref-auto_872-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;auto&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-auto-872&quot;}}"><a href="#cite_note-auto-872" id="mwKS4"><span class="mw-reflink-text" id="mwKS8"><span class="cite-bracket" id="mwKTA">[</span>872<span class="cite-bracket" id="mwKTE">]</span></span></a></sup> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Tesla,_Inc." title="Tesla, Inc." id="mwKTI">Tesla</a> shareholders approved a $1 trillion pay plan for Musk in November 2025, provided Tesla achieves certain financial milestones.<sup about="#mwt3281" class="mw-ref reference" id="cite_ref-873" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-873&quot;}}"><a href="#cite_note-873" id="mwKTM"><span class="mw-reflink-text" id="mwKTQ"><span class="cite-bracket" id="mwKTU">[</span>873<span class="cite-bracket" id="mwKTY">]</span></span></a></sup></p>

<p id="mwKTc">Several countries from the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Balkans" title="Balkans" id="mwKTg">Balkans</a> have now reached the status of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Developed_country" title="Developed country" id="mwKTk">developed countries with high-income economies</a>, such as <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Romania" title="Romania" id="mwKTo">Romania</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Bulgaria" title="Bulgaria" id="mwKTs">Bulgaria</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Croatia" title="Croatia" id="mwKTw">Croatia</a>. All three of them have joined the open-borders <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Schengen_Area" title="Schengen Area" id="mwKT0">Schengen Area</a> this decade, with Bulgaria and Croatia also joining the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Eurozone" title="Eurozone" id="mwKT4">Eurozone</a>, thus adopting the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Euro" title="Euro" id="mwKT8">Euro</a> as their sole legal currency. The economy of Greece has also been slowly recovering from the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Greek_government-debt_crisis" title="Greek government-debt crisis" id="mwKUA">Greek government-debt crisis</a> of the 2010s, with its economy being reclassified as a developed market in 2025. The recent economic advancements from this region now mean that every single country in the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/European_Union" title="European Union" id="mwKUE">European Union</a> is now considered developed.</p>

<section data-mw-section-id="36" id="mwKUI" aria-labelledby="Trade"><div class="mw-heading mw-heading3"><h3 id="Trade">Trade</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2020s&amp;action=edit&amp;section=36" title="Edit section: Trade"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<figure class="mw-default-size" typeof="mw:File/Thumb" id="mwKUM"><a href="https://en.wikipedia.org/wiki/File:Map_of_countries_by_total_tariffs_in_the_second_Trump_administration.svg" class="mw-file-description" id="mwKUQ"><img resource="https://en.wikipedia.org/wiki/File:Map_of_countries_by_total_tariffs_in_the_second_Trump_administration.svg" src="//upload.wikimedia.org/wikipedia/commons/thumb/f/fd/Map_of_countries_by_total_tariffs_in_the_second_Trump_administration.svg/500px-Map_of_countries_by_total_tariffs_in_the_second_Trump_administration.svg.png" decoding="async" data-file-width="2192" data-file-height="1135" data-file-type="drawing" height="176" width="340" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/f/fd/Map_of_countries_by_total_tariffs_in_the_second_Trump_administration.svg/960px-Map_of_countries_by_total_tariffs_in_the_second_Trump_administration.svg.png 2x" class="mw-file-element mw-file-upright" style="--mw-file-upright: 1.35" id="mwKUU"></a><figcaption id="mwKUY">A map of countries by total baseline American tariffs (includes tariffs not yet implemented)
<span class="mw-empty-elt" about="#mwt3282" typeof="mw:Transclusion" id="mwKUc" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;legend-col&quot;,&quot;href&quot;:&quot;./Template:Legend-col&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;\n{{Legend|#961610ff|100% or higher}}&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;\n{{Legend|#de2d26ff|50% – 99%}}&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;{{Legend|#fb6a4aff|40% – 49%}}&quot;},&quot;4&quot;:{&quot;wt&quot;:&quot;{{Legend|#fca78dff|30% – 39%}}&quot;},&quot;5&quot;:{&quot;wt&quot;:&quot;{{Legend|#fccfbbff|20% – 29%}}&quot;},&quot;6&quot;:{&quot;wt&quot;:&quot;{{Legend|#fee6dcff|10% – 19%}}\n{{Legend|#b9b9b9|United States}}\n&quot;}},&quot;i&quot;:0}}]}"></span><div class="plainlist image-key" about="#mwt3282" id="mwKUg"><ul><li><span class="mw-empty-elt"></span><div class="legend"><span class="legend-color mw-no-invert" style="background-color:#961610ff; color:;-webkit-print-color-adjust: exact; print-color-adjust: exact;"><span typeof="mw:Entity">&nbsp;</span></span><span typeof="mw:Entity">&nbsp;</span>100% or higher</div></li><li><span class="mw-empty-elt"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r981673959" about="#mwt3286" typeof="mw:Extension/templatestyles" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Legend/styles.css&quot;}}"></span><div class="legend"><span class="legend-color mw-no-invert" style="background-color:#de2d26ff; color:;-webkit-print-color-adjust: exact; print-color-adjust: exact;"><span typeof="mw:Entity">&nbsp;</span></span><span typeof="mw:Entity">&nbsp;</span>50% – 99%</div></li><li><span class="mw-empty-elt"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r981673959" about="#mwt3287" typeof="mw:Extension/templatestyles" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Legend/styles.css&quot;}}"></span><div class="legend"><span class="legend-color mw-no-invert" style="background-color:#fb6a4aff; color:;-webkit-print-color-adjust: exact; print-color-adjust: exact;"><span typeof="mw:Entity">&nbsp;</span></span><span typeof="mw:Entity">&nbsp;</span>40% – 49%</div></li><li><span class="mw-empty-elt"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r981673959" about="#mwt3288" typeof="mw:Extension/templatestyles" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Legend/styles.css&quot;}}"></span><div class="legend"><span class="legend-color mw-no-invert" style="background-color:#fca78dff; color:;-webkit-print-color-adjust: exact; print-color-adjust: exact;"><span typeof="mw:Entity">&nbsp;</span></span><span typeof="mw:Entity">&nbsp;</span>30% – 39%</div></li><li><span class="mw-empty-elt"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r981673959" about="#mwt3289" typeof="mw:Extension/templatestyles" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Legend/styles.css&quot;}}"></span><div class="legend"><span class="legend-color mw-no-invert" style="background-color:#fccfbbff; color:;-webkit-print-color-adjust: exact; print-color-adjust: exact;"><span typeof="mw:Entity">&nbsp;</span></span><span typeof="mw:Entity">&nbsp;</span>20% – 29%</div></li><li><span class="mw-empty-elt"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r981673959" about="#mwt3290" typeof="mw:Extension/templatestyles" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Legend/styles.css&quot;}}"></span><div class="legend"><span class="legend-color mw-no-invert" style="background-color:#fee6dcff; color:;-webkit-print-color-adjust: exact; print-color-adjust: exact;"><span typeof="mw:Entity">&nbsp;</span></span><span typeof="mw:Entity">&nbsp;</span>10% – 19%</div>
<span class="mw-empty-elt"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r981673959" about="#mwt3291" typeof="mw:Extension/templatestyles" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Legend/styles.css&quot;}}"></span><div class="legend"><span class="legend-color mw-no-invert" style="background-color:#b9b9b9; color:black;-webkit-print-color-adjust: exact; print-color-adjust: exact;"><span typeof="mw:Entity">&nbsp;</span></span><span typeof="mw:Entity">&nbsp;</span>United States</div></li></ul></div></figcaption></figure>
<p id="mwKUk">The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/World_Trade_Organization" title="World Trade Organization" id="mwKUo">World Trade Organization</a> reported that trade growth had stagnated and that <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Trade_restriction" title="Trade restriction" id="mwKUs">trade restrictions</a> were increasing as the decade began. The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Business_sector" title="Business sector" id="mwKUw">sectors</a> most affected by <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Protectionism" title="Protectionism" id="mwKU0">import restrictions</a> were <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Ore" title="Ore" id="mwKU4">mineral</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Fuel_oil" title="Fuel oil" id="mwKU8">fuel oils</a> (17.7%), <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Machine_industry" title="Machine industry" id="mwKVA">machinery</a> and mechanical appliances (13%), <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Electric_machine" title="Electric machine" id="mwKVE">electrical machinery</a> and parts (11.7%), and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Precious_metal" title="Precious metal" id="mwKVI">precious metals</a> (6%).<sup about="#mwt3294" class="mw-ref reference" id="cite_ref-874" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-874&quot;}}"><a href="#cite_note-874" id="mwKVM"><span class="mw-reflink-text" id="mwKVQ"><span class="cite-bracket" id="mwKVU">[</span>874<span class="cite-bracket" id="mwKVY">]</span></span></a></sup> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Trade_agreement" title="Trade agreement" id="mwKVc">Regional trade agreements</a> were also found to be increasing.<sup about="#mwt3297" class="mw-ref reference" id="cite_ref-875" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-875&quot;}}"><a href="#cite_note-875" id="mwKVg"><span class="mw-reflink-text" id="mwKVk"><span class="cite-bracket" id="mwKVo">[</span>875<span class="cite-bracket" id="mwKVs">]</span></span></a></sup></p>

<p id="mwKVw">United States President <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Donald_Trump" title="Donald Trump" id="mwKV0">Donald Trump</a> announced 2 April 2025 to be "<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Liberation_Day_tariffs" title="Liberation Day tariffs" id="mwKV4">liberation day</a>", beginning to enforce <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Tariff" title="Tariff" id="mwKV8">tariffs</a> on numerous nations in the following week. This triggered an ongoing <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Trade_war" title="Trade war" id="mwKWA">economic trade war</a> as well as the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2025_stock_market_crash" title="2025 stock market crash" id="mwKWE">2025 stock market crash</a>. It is currently the largest decline in the global stock market since the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2020_stock_market_crash" title="2020 stock market crash" id="mwKWI">2020 stock market crash</a>, which was part of a recession caused by the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/COVID-19_pandemic" title="COVID-19 pandemic" id="mwKWM">COVID-19 pandemic</a>.<sup about="#mwt3300" class="mw-ref reference" id="cite_ref-876" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-876&quot;}}"><a href="#cite_note-876" id="mwKWQ"><span class="mw-reflink-text" id="mwKWU"><span class="cite-bracket" id="mwKWY">[</span>876<span class="cite-bracket" id="mwKWc">]</span></span></a></sup><sup about="#mwt3303" class="mw-ref reference" id="cite_ref-877" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-877&quot;}}"><a href="#cite_note-877" id="mwKWg"><span class="mw-reflink-text" id="mwKWk"><span class="cite-bracket" id="mwKWo">[</span>877<span class="cite-bracket" id="mwKWs">]</span></span></a></sup><sup about="#mwt3306" class="mw-ref reference" id="cite_ref-878" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-878&quot;}}"><a href="#cite_note-878" id="mwKWw"><span class="mw-reflink-text" id="mwKW0"><span class="cite-bracket" id="mwKW4">[</span>878<span class="cite-bracket" id="mwKW8">]</span></span></a></sup> From January to April 2025, the average applied US tariff rate rose from 2.5% to an estimated 27%—the highest level in over a century.<sup about="#mwt3309" class="mw-ref reference" id="cite_ref-879" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-879&quot;}}"><a href="#cite_note-879" id="mwKXA"><span class="mw-reflink-text" id="mwKXE"><span class="cite-bracket" id="mwKXI">[</span>879<span class="cite-bracket" id="mwKXM">]</span></span></a></sup> The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Supreme_Court_of_the_United_States" title="Supreme Court of the United States" id="mwKXQ">Supreme Court of the United States</a> heard the case <i id="mwKXU"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Learning_Resources_v._Trump" title="Learning Resources v. Trump" class="mw-redirect" id="mwKXY">Learning Resources v. Trump</a></i> on 5 November 2025 to determine the legality of some of Trump's tariffs. On 20 February 2026, the Supreme Court struck down many of Trump's tariffs.<sup about="#mwt3312" class="mw-ref reference" id="cite_ref-880" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-880&quot;}}"><a href="#cite_note-880" id="mwKXc"><span class="mw-reflink-text" id="mwKXg"><span class="cite-bracket" id="mwKXk">[</span>880<span class="cite-bracket" id="mwKXo">]</span></span></a></sup><sup about="#mwt3315" class="mw-ref reference" id="cite_ref-881" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-881&quot;}}"><a href="#cite_note-881" id="mwKXs"><span class="mw-reflink-text" id="mwKXw"><span class="cite-bracket" id="mwKX0">[</span>881<span class="cite-bracket" id="mwKX4">]</span></span></a></sup></p>

<p id="mwKX8">Trump's tariffs represented a repudiation of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Neoliberalism" title="Neoliberalism" id="mwKYA">neoliberalism</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Free_trade" title="Free trade" id="mwKYE">free trade</a>, instead returning to <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mercantilism" title="Mercantilism" id="mwKYI">mercantilism</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Protectionism" title="Protectionism" id="mwKYM">protectionism</a>.<sup about="#mwt3318" class="mw-ref reference" id="cite_ref-882" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-882&quot;}}"><a href="#cite_note-882" id="mwKYQ"><span class="mw-reflink-text" id="mwKYU"><span class="cite-bracket" id="mwKYY">[</span>882<span class="cite-bracket" id="mwKYc">]</span></span></a></sup> Tariffs have <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/History_of_tariffs_in_the_United_States" title="History of tariffs in the United States" id="mwKYg">a long history in the United States</a>, dating back to the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Import-Export_Clause" title="Import-Export Clause" id="mwKYk">Import-Export Clause</a> of the U.S. Constitution and even the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Navigation_Acts" title="Navigation Acts" id="mwKYo">Navigation Acts</a> when the United States was a British colony.<sup about="#mwt3321" class="mw-ref reference" id="cite_ref-ARE_883-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;ARE&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-ARE-883&quot;}}"><a href="#cite_note-ARE-883" id="mwKYs"><span class="mw-reflink-text" id="mwKYw"><span class="cite-bracket" id="mwKY0">[</span>883<span class="cite-bracket" id="mwKY4">]</span></span></a></sup></p>

<p id="mwKY8">The Israeli–United States war against Iran in 2026 caused the closure of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Strait_of_Hormuz" title="Strait of Hormuz" id="mwKZA">Strait of Hormuz</a> to maritime shipping, impacting about 20% of global oil and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Liquefied_natural_gas" title="Liquefied natural gas" id="mwKZE">liquefied natural gas</a> production.<sup about="#mwt3324" class="mw-ref reference" id="cite_ref-Reuters-11032026_884-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Reuters-11032026&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Reuters-11032026-884&quot;}}"><a href="#cite_note-Reuters-11032026-884" id="mwKZI"><span class="mw-reflink-text" id="mwKZM"><span class="cite-bracket" id="mwKZQ">[</span>884<span class="cite-bracket" id="mwKZU">]</span></span></a></sup> It became the largest energy market disruption since the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/1970s_energy_crisis" title="1970s energy crisis" id="mwKZY">1970s energy crisis</a>,<sup about="#mwt3327" class="mw-ref reference" id="cite_ref-885" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-885&quot;}}"><a href="#cite_note-885" id="mwKZc"><span class="mw-reflink-text" id="mwKZg"><span class="cite-bracket" id="mwKZk">[</span>885<span class="cite-bracket" id="mwKZo">]</span></span></a></sup> and the largest disruption of the global oil market in history, surpassing the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Yom_Kippur_War" title="Yom Kippur War" id="mwKZs">Yom Kippur War</a> in 1973 and the Russian invasion of Ukraine in 2022.<sup about="#mwt3330" class="mw-ref reference" id="cite_ref-886" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-886&quot;}}"><a href="#cite_note-886" id="mwKZw"><span class="mw-reflink-text" id="mwKZ0"><span class="cite-bracket" id="mwKZ4">[</span>886<span class="cite-bracket" id="mwKZ8">]</span></span></a></sup></p>

</section></section><section data-mw-section-id="37" id="mwKaA" aria-labelledby="Health"><div class="mw-heading mw-heading2"><h2 id="Health">Health</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2020s&amp;action=edit&amp;section=37" title="Edit section: Health"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<section data-mw-section-id="38" id="mwKaE" aria-labelledby="Epidemics/Outbreaks"><div class="mw-heading mw-heading3"><h3 id="Epidemics/Outbreaks"><span id="Epidemics.2FOutbreaks" typeof="mw:FallbackId"></span>Epidemics/Outbreaks</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2020s&amp;action=edit&amp;section=38" title="Edit section: Epidemics/Outbreaks"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<table class="wikitable sortable mw-collapsible" id="mwKaI">
<tbody id="mwKaM"><tr id="mwKaQ"><th style="width:200px;" id="mwKaU">Event</th>
<th style="width:120px;" id="mwKaY">Date</th>
<th id="mwKac">Infections and deaths</th>
<th id="mwKag">Description</th></tr>
<tr id="mwKak">
<td id="mwKao"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–2023_mpox_outbreak" title="2022–2023 mpox outbreak" id="mwKas">2022–2023 mpox outbreak</a></td>
<td id="mwKaw">6 May 2022 – 11 May 2023</td>
<td id="mwKa0">86,494 confirmed cases and 280 deaths in 109 countries and territories reported by 26 March 2023.<sup about="#mwt3333" class="mw-ref reference" id="cite_ref-887" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-887&quot;}}"><a href="#cite_note-887" id="mwKa4"><span class="mw-reflink-text" id="mwKa8"><span class="cite-bracket" id="mwKbA">[</span>887<span class="cite-bracket" id="mwKbE">]</span></span></a></sup></td>
<td id="mwKbI">First international outbreak cluster detected on 6 May 2022 in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/London" title="London" id="mwKbM">London</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/United_Kingdom" title="United Kingdom" id="mwKbQ">UK</a>. Declared a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Public_health_emergency_of_international_concern" title="Public health emergency of international concern" id="mwKbU">public health emergency of international concern</a> by <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/World_Health_Organization" title="World Health Organization" id="mwKbY">WHO</a> from 23 July 2022 to 11 May 2023.</td></tr>
</tbody></table>

</section><section data-mw-section-id="39" id="mwKbc" aria-labelledby="Pandemics"><div class="mw-heading mw-heading3"><h3 id="Pandemics">Pandemics</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2020s&amp;action=edit&amp;section=39" title="Edit section: Pandemics"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<table class="wikitable sortable mw-collapsible" id="mwKbg">
<tbody id="mwKbk"><tr id="mwKbo">
<th style="width:200px;" id="mwKbs">Event</th>
<th style="width:120px;" id="mwKbw">Date</th>
<th id="mwKb0">Infections and deaths</th>
<th id="mwKb4">Description</th></tr>
<tr id="mwKb8">
<td id="mwKcA"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/COVID-19_pandemic" title="COVID-19 pandemic" id="mwKcE">COVID-19 pandemic</a></td>
<td id="mwKcI">2019 – 2023<sup about="#mwt3336" class="mw-ref reference" id="cite_ref-888" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-888&quot;}}"><a href="#cite_note-888" id="mwKcM"><span class="mw-reflink-text" id="mwKcQ"><span class="cite-bracket" id="mwKcU">[</span>888<span class="cite-bracket" id="mwKcY">]</span></span></a></sup><sup about="#mwt3339" class="mw-ref reference" id="cite_ref-889" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-889&quot;}}"><a href="#cite_note-889" id="mwKcc"><span class="mw-reflink-text" id="mwKcg"><span class="cite-bracket" id="mwKck">[</span>889<span class="cite-bracket" id="mwKco">]</span></span></a></sup></td>
<td id="mwKcs">678.1 million+ confirmed cases and 6.7 million+ deaths with more than 240 countries and territories reported by 16 February 2023.<sup about="#mwt3342" class="mw-ref reference" id="cite_ref-890" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-890&quot;}}"><a href="#cite_note-890" id="mwKcw"><span class="mw-reflink-text" id="mwKc0"><span class="cite-bracket" id="mwKc4">[</span>890<span class="cite-bracket" id="mwKc8">]</span></span></a></sup></td>
<td id="mwKdA">First confirmed case detected on 17 November 2019 in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wuhan" title="Wuhan" id="mwKdE">Wuhan</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/China" title="China" id="mwKdI">China</a>. Declared a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Public_health_emergency_of_international_concern" title="Public health emergency of international concern" id="mwKdM">public health emergency of international concern</a> by <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/World_Health_Organization" title="World Health Organization" id="mwKdQ">WHO</a> from 30 January 2020 to 5 May 2023.</td></tr>
<tr id="mwKdU">
<td id="mwKdY"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/HIV/AIDS" title="HIV/AIDS" id="mwKdc">HIV/AIDS</a></td>
<td id="mwKdg">1981 – present</td>
<td id="mwKdk">37.9 million people living with HIV (end of 2018), 24.5 million people accessing antiretroviral therapy (end of June 2019), 32.0 million deaths from AIDS-related illnesses since the start of the epidemic (end 2018).<sup about="#mwt3345" class="mw-ref reference" id="cite_ref-891" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-891&quot;}}"><a href="#cite_note-891" id="mwKdo"><span class="mw-reflink-text" id="mwKds"><span class="cite-bracket" id="mwKdw">[</span>891<span class="cite-bracket" id="mwKd0">]</span></span></a></sup></td>
<td id="mwKd4"></td></tr>
</tbody></table>

