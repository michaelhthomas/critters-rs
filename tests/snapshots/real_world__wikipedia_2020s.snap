<td id="mwJ9M"><sup about="#mwt3117" class="mw-ref reference" id="cite_ref-826" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-826&quot;}}"><a href="#cite_note-826" id="mwJ9Q"><span class="mw-reflink-text" id="mwJ9U"><span class="cite-bracket" id="mwJ9Y">[</span>826<span class="cite-bracket" id="mwJ9c">]</span></span></a></sup><sup about="#mwt3120" class="mw-ref reference" id="cite_ref-Tchekmedyian_2025_827-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Tchekmedyian 2025&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Tchekmedyian_2025-827&quot;}}"><a href="#cite_note-Tchekmedyian_2025-827" id="mwJ9g"><span class="mw-reflink-text" id="mwJ9k"><span class="cite-bracket" id="mwJ9o">[</span>827<span class="cite-bracket" id="mwJ9s">]</span></span></a></sup><sup about="#mwt3123" class="mw-ref reference" id="cite_ref-Hamilton_LA_Times_2025_828-0" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Hamilton LA Times 2025&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Hamilton_LA_Times_2025-828&quot;}}"><a href="#cite_note-Hamilton_LA_Times_2025-828" id="mwJ9w"><span class="mw-reflink-text" id="mwJ90"><span class="cite-bracket" id="mwJ94">[</span>828<span class="cite-bracket" id="mwJ98">]</span></span></a></sup></td></tr>
